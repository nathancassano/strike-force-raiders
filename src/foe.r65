// foe - the enemy airframe, and the pilot.
//
// A second helicopter, the CPU's, with the player's airframe's physics,
// loadout, fuel, pad and loss rules on its own state, and the world's
// response to it: the player's gun and bombs against it, the
// player's turrets, base and super bunker firing at it, balloons and the
// other airframe ending it on contact, and its lives as the second way to
// win.
//
// The pilot is an adaptation of Armor Alley's: a priority list run every
// FOE_THINK frames that picks one spot to fly to and one thing to shoot
// or bomb, in this order - refit (fuel, or two of ammo, bombs, health
// short), dodge a round coming at it, hunt the player's airframe (gun
// level with it, or bomb from above once the gun is dry), bomb a ground
// unit its row lets it kill, bomb a player turret or bunker, and
// otherwise wander toward the player's end on a weave, turning at the
// world's edge. The original sums steering forces every frame; here the
// same decisions set a target for Pilot::steer, which does the flying, and
// the reactions are the original's too: a mode roll every half minute
// (attack seven times in eight), a coin toss to start hunting when its
// gunfire hits, a bomb limit per target, and paratroopers dropped on the
// bunkers and turrets it passes (campaign missions; Pilot::maybe_drop).
// Clouds, kamikaze runs, the smart missile (`useMissile`) and the missile
// counter-measures are not here.
//
// The airframe itself is airframes[FOE] (heli.r65): its flying, rearming,
// drawing and wreck are Airframe's methods, shared with the player's. What
// is here is the pilot (impl Pilot) and the world's response to it.

#[bank(0)]

// ------------------------------------------------------------ constants ---
// The start is the mirror of the player's: hovering at the far edge.
const FOE_START_X: u16 = WORLD_W - 64 - HELI_W;
const FOE_LIVES:   u8  = 4;
const FOE_ATTR:    u16 = (HELI_ATTR & ~OBJ_PAL_HELI) | OBJ_PAL_HELI_ENEMY;
const FOE_ATTR_RISING: u16 = (HELI_ATTR_RISING & ~OBJ_PAL_HELI) | OBJ_PAL_HELI_ENEMY;

// The pilot flies the player's airframe with the player's stick: each
// frame it holds a direction or lets go, and the player's thrust, drag,
// top speed and turn do the rest. It lets go once the coast under drag
// covers what is left (FOE_STOP), so it arrives rather than overshoots,
// and is at rest inside FOE_NEAR.
const FOE_NEAR:    u16 = 8;
const FOE_NEAR_Y:  u16 = 2;
const FOE_WALK:    Q10 = 64;              // 1 px/frame: slow enough to call stopped over the deck
const FOE_LAND_DEEP: u16 = 12;            // a landing aims this far under the deck, so the coast
                                          // still touches down - at ~1.75 px/frame, nowhere near a crash

// FOE_STOP[v >> 3] - pixels an airframe coasts at speed v (Q10, either
// axis) with the stick let go: drag takes 8 a frame on both. Bucket i is
// figured at its top speed (8i + 7), so the pilot lets go a touch early.
static FOE_STOP: [u8; 41] = [0, 1, 1, 1, 2, 2, 3, 4, 5, 6, 7, 9, 10, 12, 13, 15, 17, 19,
                             22, 24, 26, 29, 32, 35, 38, 41, 44, 47, 51, 54, 58, 62, 66,
                             70, 74, 79, 83, 88, 93, 97, 102];
const HELI_Y_MIN_PX: u16 = 16;            // HELI_Y_MIN in pixels
const FOE_HP_PASS: u8  = 16;              // a pass over a turret costs about ten; under this, leave them
const FOE_FUEL_LOW: u8 = 14;              // the original's needsFuel (25), less the trip home added at the check
const FOE_GUN_LOW:  u8 = 6;               // ... needsAmmo
const FOE_HP_LOW:   u8 = 5;               // ... needsRepair
const FOE_THINK:   u16 = 8;               // frames between decisions; a power of two
const FOE_MODE_MASK: u16 = 2047;          // the mode roll, every ~34 s
// The original's ranges: things in view, gun reach, rounds worth dodging.
const FOE_VIEW:     u16 = 512;
const FOE_GUN_REACH: u16 = 320;
const FOE_DODGE_X:  u16 = 192;
const FOE_DODGE_Y:  u16 = 2 * HELI_H;
const FOE_AIM_Y:    u16 = HELI_H + (HELI_H >> 1);   // 1.5 heights, for the gun
const FOE_EDGE:     u16 = 128;            // turn this far from the world's far end ...
const FOE_WEST:     u16 = 900;            // ... and here at the player's, short of the
                                          // base's 320 px no-fly zone (400 + 64 + 320):
                                          // no decision sends the airframe west of it
const FOE_BALLOON_X: u16 = 512;           // keep over a player's balloon this near: the climb from
                                          // hover height is ~30 frames, but from a descent it is more,
                                          // and the field's bunkers are 800-1500 px apart - at 320 the
                                          // gap between two let it sink, and the next chain caught it
const FOE_OVER_Y:  u16 = (BALLOON_Y - HELI_H - 8) << 8;   // ... at this height or higher
const FOE_STANDOFF: u16 = HELI_W + 16;    // gun range: sit this far off the target
const FOE_CLOSE:    u16 = HELI_W + 160;   // ... and clear its plane inside this when it closes:
                                          // a charge closes 8.75 px a frame and the climb takes
                                          // twenty frames to get going
// Avoiding the other airframe is deliberately not perfect. It looks every
// fourth frame - a reaction time, and three frames in four skip it - and
// only 16 frames ahead along the closing speed, less than the climb
// needs to get going, so two airframes charging each other flat out can
// still meet. The look is a shift: the closing speed in Q10 (1/64 px a
// frame) >> 2 is the distance covered in 16 frames. At the 10 px/frame
// of a mutual charge that is 160 px, which FOE_CLOSE's early-out covers.
// And on one encounter in four the pilot does not see the player at all
// for FOE_BLIND frames - long enough, at a charge, to meet it. Which
// encounters is two bits of the frame count at first sight, not cpu_rand:
// a draw of that would re-deal the CPU's purchases.
const FOE_AVOID_MASK: u16 = 3;            // look on frames where this is clear
const FOE_BLIND:      u8  = 24;
const FOE_LOOK_SHIFT: u16 = 2;            // Q10 >> 2: px covered in 16 frames
const FOE_ALIGN:    u16 = 6;              // bomb when the centres are this close
const FOE_PASS:     u16 = 192;            // a bombing pass over a building runs this far past it
const FOE_BOMB_CD:  u8  = 40;             // frames between bombs
const FOE_BOMB_TANK: u8 = 3;              // bombs per tank; one for anything else
const FOE_RESPOND:  u8  = 60;             // frames between coin tosses on being hit
// Paratroopers, the original's: five aboard every airframe (no pickup),
// one drop at most every 30 s, the men 200 ms apart (its classic
// parachutingDelayFlying), and a turret dropped on from within 64 px of
// its near side, coming up on it.
const FOE_MEN:        u8  = 5;
const FOE_PARA_EVERY: u16 = 1800;
const FOE_PARA_GAP:   u8  = 12;
const FOE_PARA_TURRET: u16 = 64;
// The weave: the wander's height cycles through these, one every 64
// frames - the original's sine wave, biased upward. Under fire from the
// ground it is the second, twice as tall and four times as quick: the
// original's amplitude x4 when avoiding a turret.
static foe_weave: [u16; 4] = [112 << 8, 88 << 8, 72 << 8, 88 << 8];
static foe_jink:  [u16; 4] = [112 << 8, 72 << 8, 40 << 8, 72 << 8];

// States, in priority order.
const FOE_WANDER:  u8 = 0;
const FOE_PAD:     u8 = 1;
const FOE_DODGE:   u8 = 2;
const FOE_HUNT:    u8 = 3;
const FOE_BOMB:    u8 = 4;                // a ground unit
const FOE_STRUCT:  u8 = 5;                // a turret or bunker
const FOE_PARA:    u8 = 6;                // to a bunker to drop men on it
const FOE_RAID:    u8 = 7;                // to the player's bank, to rob it
// The raid's flight, at hover height and the men out once the airframe's
// middle is this near the bank's. The original flies it high (`y =
// min(96, y)`), steering round balloons with its whiskers; here it goes
// over each of the player's balloons as it comes to it (over_balloons), and
// the base's missiles home in at any height.
const FOE_RAID_Y:    u16 = HELI_Y_HOVER;
const FOE_RAID_NEAR: u16 = 16;
// A bomb target: a unit slot, or a structure index with the top bit set.
const FOE_TGT_STRUCT: u8 = 0x80;
const FOE_TGT_NONE:   u8 = 0xFF;

// ---------------------------------------------------------------- state ---
// The airframe is airframes[FOE] (heli.r65); the pilot's state is its own.
#[soa]
struct Pilot {
    state:    u8,
    attack:   u8,       // the mode roll: in a fighting mood
    hunt:     u8,       // ... and after the player's airframe
    dir:      u8,       // wander: 1 heading west (the player's end)
    bomb_cd:  u8,       // frames until the next bomb
    tgt:      u8,       // what the bombs are for this tick
    bombed:   u8,       // the last target bombed ...
    bombed_n: u8,       // ... and how many times
    respond:  u8,       // throttle on the chase coin toss
    pass:     u16,      // a bombing pass's far end; AIR_NONE between passes
    pass_tgt: u8,       // ... and what it is over
    high:     u8,       // a player balloon is near: no lower than FOE_OVER_Y, dodge or not
    avoid:    u8,       // frames left of a step out of the other airframe's plane
    seen:     u8,       // 1 while an encounter with it lasts
    blind:    u8,       // frames left of not seeing it
    tx:       u16,      // where it is flying to, decided
    ty:       u16,      // ... every FOE_THINK frames
    men:      u8,       // paratroopers aboard: FOE_MEN each airframe
    drop:     u8,       // men still to go out of the door in this drop
    gap:      u8,       // frames to the next of them
    para_t:   u16,      // frames until another drop may start
    steal:    u8,       // the 1-in-4 window in which a raid may start (the original's stealB)
    raid:     u8,       // a raid under way: held until its men are out
    robbing:  u8,       // the drop under way is the raid's: no room needed (para_drop)
    deck:     u8,       // the hunt is a landed player airframe on its deck: bomb it, gun or no gun
    burn:     u16,      // the afterburner, as player.burn: lit on a raid, past FOE_WEST
}
#[lowram] static mut pilot: Pilot;

// Where a gun's shot at an airframe goes: air_target's second result.
#[lowram] static mut air_ty:    u16;
const AIR_NONE: u16 = 0xFFFF;

// ------------------------------------------------------------- Pilot ---
// The enemy's airframe, airframes[FOE], and the pilot flying it.
// Associated functions, as Player's: one of each, and X is for loops.
impl Pilot {
    // Pilot::init - place the airframe with a full load; the lives are the
    // match's, so Pilot::lost keeps them across a re-init.
    fn init() {
        airframes[FOE].init(FOE_START_X, 1);
        pilot.raid = 0;                     // a lost airframe's raid goes with it
        pilot.robbing = 0;
        pilot.burn = 0;
        pilot.men = FOE_MEN;                // a new airframe's men; the last one's went with it
        pilot.drop = 0;
        pilot.gap = 0;
        pilot.state = FOE_WANDER;
        pilot.deck = 0;
        pilot.high = 0;
        pilot.avoid = 0;
        pilot.seen = 0;
        pilot.blind = 0;
        pilot.tx = FOE_START_X;
        pilot.ty = HELI_Y_HOVER;
        pilot.dir = 1;
        pilot.bomb_cd = 0;
        pilot.tgt = FOE_TGT_NONE;
        pilot.bombed = FOE_TGT_NONE;
        pilot.bombed_n = 0;
        pilot.respond = 0;
        pilot.pass = AIR_NONE;
    }

    fn reset() {
        Pilot::init();
        pilot.para_t = 0;
        pilot.steal = 0;
        airframes[FOE].wreck_up = 0;           // no wreck
        airframes[FOE].lives = FOE_LIVES;
        // The mode roll's opening values: attacking, but not yet hunting -
        // the original's first targeting tick is half a minute in, and that
        // quiet opening is worth keeping.
        pilot.attack = 1;
        pilot.hunt = 0;
    }

    // Pilot::hit - damage from a round or a missile; a bomb goes straight to
    // Pilot::lost. Gunfire with the player's airframe in view is taken as its
    // gunfire, and - the original's respondToHit - a coin toss, no more than
    // once a second, may turn the pilot on it.
    near fn hit(dmg: u8) {
        if airframes[FOE].hp > dmg {
            airframes[FOE].hp = airframes[FOE].hp - dmg;
        } else {
            Pilot::lost();
            return;
        }
        if dmg == 1 && pilot.hunt == 0 && pilot.respond == 0 && pilot.attack != 0 {
            if (cpu_stats[cpu_level as u16].flags & CPU_KILL_COPTER) != 0 {
                if airframes[HELI].dead == 0 && unit_apart(airframes[HELI].x_px, airframes[FOE].x_px) < FOE_VIEW {
                    pilot.respond = FOE_RESPOND;
                    pilot.hunt = (cpu_rand() & 1) as u8;
                }
            }
        }
    }

    // Pilot::collide - the player's munitions against the airframe's box, the
    // balloons, the player's ground (unit_ram), and the other airframe: two
    // helicopters that meet are both lost.
    fn collide() {
        if airframes[FOE].dead > 0 || airframes[FOE].rising != 0 { return; }
        let fx: u16 = airframes[FOE].x_px;
        let fy: u16 = airframes[FOE].y >> 8;
        let mut hit: u8 = HIT_NONE;                // odd frames: the player's are even
        if (frames_loop & 1) != 0 { hit = struct_balloon_at(SIDE_ENEMY, fx, fy); }
        if hit == HIT_BALLOON || (hit == HIT_CHAIN && airframes[FOE].hp <= CHAIN_DMG) {
            Pilot::lost();
            return;
        }
        if hit == HIT_CHAIN { airframes[FOE].hp = airframes[FOE].hp - CHAIN_DMG; }
        if fy > RAM_LOW {
            if unit_ram(SIDE_ENEMY, fx, fy) != 0 {
                Pilot::lost();
                airframes[FOE].wreck_vx = Q10(0);    // stopped by what it hit
                return;
            }
        }
        if airframes[HELI].dead == 0 && airframes[HELI].rising == 0 {
            let hx: u16 = airframes[HELI].x_px;
            let hy: u16 = airframes[HELI].y >> 8;
            if hx + HELI_W > fx && hx < fx + HELI_W {
                if hy + HELI_H > fy && hy < fy + HELI_H {
                    Player::lost();
                    Pilot::lost();
                    Airframe::collided();         // locked together: both fall straight
                    return;
                }
            }
        }
        // Nothing of the player's up - the usual frame - and the pool is not
        // worth walking. (Turrets, bases and launchers of the player's side
        // fire player-owned rounds too, so this cannot be gated on where the
        // player's airframe is.)
        if muni_up[SIDE_PLAYER as u16] == 0 { return; }
        for m in 0..MUNI_MAX {
            let mk: u8 = muni_kind[m];
            if mk == MUNI_BULLET || mk == MUNI_MISSILE || mk == MUNI_BOMB {
                if muni_owner[m] == SIDE_PLAYER {
                    let mx: u16 = muni_x_px[m];
                    let my: u16 = muni_y[m] >> 8;
                    if mx >= fx && mx < fx + HELI_W {
                        if my >= fy && my < fy + HELI_H {
                            muni_drop_bomb(m);
                            muni_kind[m] = MUNI_FREE;
                            if mk == MUNI_BOMB {
                                Pilot::lost();   // a bomb ends it outright
                                return;
                            }
                            let mut dmg: u8 = 1;
                            if mk == MUNI_MISSILE { dmg = HELI_DMG_MISSILE; }
                            // The player's own gun - a round at GUN_SPEED,
                            // not a turret's - landing the last point gets
                            // its praise; pushed after the loss, so the
                            // last airframe's (the match won) is dropped.
                            let mut gunned: u8 = 0;
                            if mk == MUNI_BULLET && airframes[FOE].hp <= dmg {
                                if muni_vx[m] == GUN_SPEED || muni_vx[m] == Q10(0) - GUN_SPEED { gunned = 1; }
                            }
                            Pilot::hit(dmg);
                            if gunned != 0 { alert_push(ALERT_GUNNED); }
                            if airframes[FOE].dead > 0 || airframes[FOE].rising != 0 { return; }
                            if mk == MUNI_BULLET { sfx_at(SFX_CHN_HIT, SFX_ENEMY_HIT, fx + (HELI_W >> 1)); }
                        }
                    }
                }
            }
        }
    }

    // Pilot::stop - how far the airframe coasts from speed *v* (Q10, >= 0).
    near fn stop(v: Q10) -> u16 {
        let mut i: u16 = (v.0 as u16) >> 3;
        if i > 40 { i = 40; }
        return FOE_STOP[i] as u16;
    }

    // Pilot::steer - one frame of flying toward (*tx*, *ty*): tx the world x the
    // airframe's left edge should reach, ty the 8.8 height. The stick is
    // digital, as the player's is: a direction held asks full speed and gets
    // the player's thrust, none asks rest and gets the player's drag. A
    // direction is held while the spot is further than the coast from here;
    // moving away from it, the coast is nothing, so it holds toward it and
    // the thrust brakes and turns it, as a player reversing the stick does.
    near fn steer(tx: u16, ty: u16) {
        let mut want: u8 = 2;
        let mut vx: Q10 = Q10(0);
        let mut top: Q10 = HELI_VX_MAX;         // or the afterburner's, on a raid
        if pilot.burn > HELI_BURN_RECHARGE { top = HELI_BURN_VX; }
        let x: u16 = airframes[FOE].x_px;
        if tx > x + FOE_NEAR {
            let mut stop: u16 = 0;
            if airframes[FOE].vx > Q10(0) { stop = Pilot::stop(airframes[FOE].vx); }
            if tx - x > stop { vx = top; want = 0; }
        } else {
            if x > tx + FOE_NEAR {
                let mut stop: u16 = 0;
                if airframes[FOE].vx < Q10(0) { stop = Pilot::stop(Q10(0) - airframes[FOE].vx); }
                if x - tx > stop { vx = Q10(0) - top; want = 1; }
            }
        }
        airframes[FOE].turn_step(want);
        let mut ax: Q10 = HELI_THRUST_X;
        if vx == Q10(0) { ax = HELI_DRAG_X; }
        airframes[FOE].vx = approach(airframes[FOE].vx, vx, ax);

        // Vertically the same. A landing aims under the deck, so the coast
        // reaches it; fly stops the airframe at the floor.
        let mut aim: u16 = ty;
        if ty >= HELI_Y_MAX { aim = HELI_Y_MAX + (FOE_LAND_DEEP << 8); }
        let y: u16 = airframes[FOE].y;
        let mut vy: Q10 = Q10(0);
        if aim > y + (FOE_NEAR_Y << 8) {
            let mut stop: u16 = 0;
            if airframes[FOE].vy > Q10(0) { stop = Pilot::stop(airframes[FOE].vy); }
            if ((aim - y) >> 8) > stop { vy = HELI_VY_MAX; }
        } else {
            if y > aim + (FOE_NEAR_Y << 8) {
                let mut stop: u16 = 0;
                if airframes[FOE].vy < Q10(0) { stop = Pilot::stop(Q10(0) - airframes[FOE].vy); }
                if ((y - aim) >> 8) > stop { vy = Q10(0) - HELI_VY_MAX; }
            }
        }
        let mut ay: Q10 = HELI_THRUST_Y;
        if vy == Q10(0) { ay = HELI_DRAG_Y; }
        airframes[FOE].vy = approach(airframes[FOE].vy, vy, ay);
    }

    // ---------------------------------------------------------------- pilot ---
    // Pilot::dodge - a round of another side coming at the airframe: the nearest
    // within FOE_DODGE_X and two heights, or 16 (none). The original brakes
    // for a round already past and sidesteps the rest vertically.
    near fn dodge() -> u16 {
        if muni_up[SIDE_PLAYER as u16] == 0 { return MUNI_MAX; }
        let cx: u16 = airframes[FOE].x_px + (HELI_W >> 1);
        let cy: u16 = (airframes[FOE].y >> 8) + (HELI_H >> 1);
        let mut best: u16 = MUNI_MAX;
        let mut best_d: u16 = FOE_DODGE_X;
        for m in 0..MUNI_MAX {
            let mk: u8 = muni_kind[m];
            if mk == MUNI_BULLET || mk == MUNI_MISSILE {
                if muni_owner[m] != SIDE_ENEMY {
                    let d: u16 = unit_apart(muni_x_px[m], cx);
                    if d < best_d {
                        if unit_apart(muni_y[m] >> 8, cy) < FOE_DODGE_Y {
                            best_d = d;
                            best = m;
                        }
                    }
                }
            }
        }
        return best;
    }

    // Pilot::avoid_due - is the player's airframe about to overlap this one?
    // In its plane (two heights), and either already within a standoff or
    // closing fast enough to cover the gap between them within 16 frames. The closing speed is both airframes' - the old test counted
    // only the player's, so the pilot flew its own wander and bombing passes
    // straight into a hovering player - except in a hunt, whose approach is
    // to a standoff it brakes for: counting it would climb out of every gun
    // run. No multiply or divide: the look is a shift of the speed.
    near fn avoid_due() -> u8 {
        if airframes[HELI].dead > 0 || airframes[HELI].rising != 0 { return 0; }
        let apart: u16 = unit_apart(airframes[HELI].x_px, airframes[FOE].x_px);
        if apart >= FOE_CLOSE { return 0; }                    // the usual look ends here
        if unit_apart(airframes[HELI].y >> 8, airframes[FOE].y >> 8) >= FOE_DODGE_Y { return 0; }
        if apart < FOE_STANDOFF { return 1; }                  // already on top
        let mut fvx: Q10 = airframes[FOE].vx;
        if pilot.state == FOE_HUNT { fvx = Q10(0); }
        let mut rel: Q10 = fvx - airframes[HELI].vx;                      // the player east of it
        if airframes[HELI].x_px < airframes[FOE].x_px { rel = airframes[HELI].vx - fvx; }
        if rel <= Q10(0) { return 0; }                         // holding apart, or opening
        if apart - HELI_W < ((rel.0 as u16) >> FOE_LOOK_SHIFT) { return 1; }
        return 0;
    }

    // Pilot::evade - a round of another side coming at the airframe overrides
    // the height chosen, never the heading: the original zeroes the sideways
    // part of a turret dodge, and a bombing pass has to carry on. A round
    // from the ground - a turret's, a bunker's - is met with the jink, since
    // it comes along the line to the airframe and a step to one side is what
    // breaks that line; one from the air is stepped over or under.
    near fn evade() {
        if pilot.state == FOE_PAD && airframes[FOE].landed != 0 { return; }

        // The other airframe about to overlap - the original's
        // avoidAboveOrBelow: get out of its plane, upward for choice. A step
        // under way is held until the next look, ahead of any round.
        if pilot.avoid > 0 {
            pilot.avoid = pilot.avoid - 1;
            return;
        }
        if pilot.blind > 0 {
            pilot.blind = pilot.blind - 1;
        } else if (frames_loop & FOE_AVOID_MASK) == 0 {
            if Pilot::avoid_due() == 0 {
                pilot.seen = 0;
            } else if pilot.seen == 0 && ((frames_loop >> 2) & 3) == 0 {
                pilot.seen = 1;                 // missed it
                pilot.blind = FOE_BLIND;
            } else {
                pilot.seen = 1;
                let hy: u16 = airframes[HELI].y >> 8;
                let fy: u16 = airframes[FOE].y >> 8;
                if pilot.state != FOE_PAD { pilot.state = FOE_DODGE; }
                if fy > HELI_Y_MIN_PX + FOE_DODGE_Y + 8 && hy >= fy {
                    pilot.ty = airframes[FOE].y - ((FOE_DODGE_Y + 8) << 8);
                } else {
                    pilot.ty = airframes[FOE].y + ((FOE_DODGE_Y + 8) << 8);
                    if pilot.ty > HELI_Y_MAX - (8 << 8) { pilot.ty = HELI_Y_MAX - (8 << 8); }
                }
                pilot.avoid = FOE_AVOID_MASK as u8;
                return;
            }
        }

        let m: u16 = Pilot::dodge();
        if m == MUNI_MAX { return; }
        if pilot.state != FOE_PAD { pilot.state = FOE_DODGE; }
        if (muni_y[m] >> 8) >= UNIT_BAND_TOP - 16 || muni_vy[m] < Q10(0) {
            pilot.ty = foe_jink[(frames_loop >> 4) & 3];
        } else {
            if (muni_y[m] >> 8) < (airframes[FOE].y >> 8) + (HELI_H >> 1) {
                pilot.ty = airframes[FOE].y + (FOE_DODGE_Y << 8);
                if pilot.ty > HELI_Y_HOVER + (24 << 8) { pilot.ty = HELI_Y_HOVER + (24 << 8); }
            } else {
                if airframes[FOE].y > HELI_Y_MIN + (FOE_DODGE_Y << 8) { pilot.ty = airframes[FOE].y - (FOE_DODGE_Y << 8); } else { pilot.ty = HELI_Y_MIN; }
            }
        }
    }

    // Pilot::fire - the gun and the bombs, every frame. The gun goes at the
    // player's airframe when it is in reach, level, and faced - the
    // original's rule - along the nose as the player's does. A bomb goes when
    // the tick's target is under the airframe's centre, one per target (three
    // for a tank, any number for a turret), FOE_BOMB_CD frames apart.
    near fn fire() {
        if airframes[FOE].gun_cd > 0 { airframes[FOE].gun_cd = airframes[FOE].gun_cd - 1; }
        if pilot.bomb_cd > 0 { pilot.bomb_cd = pilot.bomb_cd - 1; }

        if airframes[FOE].gun_cd == 0 && airframes[FOE].gun > 0 && airframes[HELI].dead == 0 && airframes[HELI].rising == 0 {
            let dx: u16 = unit_apart(airframes[HELI].x_px, airframes[FOE].x_px);
            if dx < FOE_GUN_REACH && dx > HELI_W {
                if unit_apart(airframes[HELI].y >> 8, airframes[FOE].y >> 8) < FOE_AIM_Y {
                    let mut facing: u8 = 0;
                    if airframes[HELI].x_px < airframes[FOE].x_px { if airframes[FOE].face_left != 0 { facing = 1; } } else { if airframes[FOE].face_left == 0 { facing = 1; } }
                    if facing != 0 && muni_gun_rounds(SIDE_ENEMY) < GUN_ROUNDS {
                        airframes[FOE].gun = airframes[FOE].gun - 1;
                        airframes[FOE].gun_cd = HELI_GUN_RATE;
                        let mut mx: u16 = airframes[FOE].x_px + HELI_W;
                        let mut v: Q10 = GUN_SPEED;
                        if airframes[FOE].face_left != 0 {
                            mx = airframes[FOE].x_px;
                            v = Q10(0) - GUN_SPEED;
                        }
                        let mut vy: Q10 = 0;
                        if airframes[FOE].tilt >= HELI_LEAN_DIP { vy = HELI_GUN_DROP; }
                        muni_spawn(MUNI_BULLET, mx, airframes[FOE].y + (HELI_MUZZLE_Y << 8),
                                   v, vy, GUN_LIFE, SIDE_ENEMY);
                        sfx_at(SFX_CHN_FOE_GUN, SFX_ENEMY_GUN, mx);
                    }
                }
            }
        }

        if pilot.bomb_cd != 0 || airframes[FOE].bombs == 0 { return; }
        let cx: u16 = airframes[FOE].x_px + (HELI_W >> 1);
        let mut tx: u16 = 0;
        let mut ty: u16 = 0;
        let mut tgt: u8 = pilot.tgt;
        if pilot.state == FOE_HUNT {
            // Bombing the player's airframe: its centre, and it has to be
            // below - once the gun is dry, or at once on its deck.
            if (airframes[FOE].gun > 0 && pilot.deck == 0) || airframes[HELI].dead != 0 { return; }
            tx = airframes[HELI].x_px + (HELI_W >> 1);
            ty = airframes[HELI].y >> 8;
            tgt = FOE_TGT_NONE;
        } else {
            if tgt == FOE_TGT_NONE { return; }
            if (tgt & FOE_TGT_STRUCT) != 0 {
                let si: u16 = (tgt & 0x7F) as u16;
                tx = structs[si].x + (structs[si].w >> 1);
                ty = GROUND_Y - 8;
            } else {
                let u: u16 = tgt as u16;
                if units[u].kind as u8 == UnitType::Free as u8 { return; }
                tx = units[u].x_px + (unit_stats[units[u].kind as u16].width >> 1);
                ty = UNIT_BASE_Y;
            }
        }
        // A bomb keeps the airframe's speed, so it lands ahead by the fall's
        // worth of it. The fall from a height h is about 18 + h/8 frames
        // (24 from hover, 40 from the top of the jink), and vx is in 1/64 px
        // a frame, so the lead is vx * (144 + h) / 512 px - with the product
        // scaled to fit a word. Release when that spot is over the target; a
        // stepped estimate skipped the 12 px window on a climbing pass.
        let mut land: u16 = cx;
        let mut mag: u16 = 0;
        if airframes[FOE].vx >= Q10(0) { mag = airframes[FOE].vx.0 as u16; } else { mag = (0 - airframes[FOE].vx.0) as u16; }
        let h: u16 = GROUND_Y - (airframes[FOE].y >> 8);
        let lead: u16 = mul16(mag >> 2, 144 + h) >> 7;
        if airframes[FOE].vx >= Q10(0) {
            land = cx + lead;
        } else {
            if land > lead { land = land - lead; } else { land = 0; }
        }
        if unit_apart(tx, land) < FOE_ALIGN && ty > (airframes[FOE].y >> 8) + HELI_H {
            airframes[FOE].bombs = airframes[FOE].bombs - 1;
            pilot.bomb_cd = FOE_BOMB_CD;
            muni_spawn(MUNI_BOMB, cx, airframes[FOE].y + (HELI_H << 8), airframes[FOE].vx, Q10(0), 0, SIDE_ENEMY);
            if tgt != FOE_TGT_NONE {
                if tgt == pilot.bombed { pilot.bombed_n = pilot.bombed_n + 1; } else { pilot.bombed = tgt; pilot.bombed_n = 1; }
            }
        }
    }

    // Pilot::update - one tick: the loss delay and the rise, the deck, the
    // pilot, the flying, and the landing rules.
    fn update() {
        if airframes[FOE].wreck_up != 0 { airframes[FOE].wreck_tick(); }
        if airframes[FOE].dead > 0 {
            airframes[FOE].dead = airframes[FOE].dead - 1;
            if airframes[FOE].dead == 0 {
                airframes[FOE].rising = 1;
                airframes[FOE].y = GROUND_Y << 8;
            }
            return;
        }
        if airframes[FOE].rising != 0 {
            airframes[FOE].y = airframes[FOE].y - HELI_RISE;
            if airframes[FOE].y <= HELI_Y_HOVER {
                airframes[FOE].y = HELI_Y_HOVER;
                airframes[FOE].rising = 0;
            }
            return;
        }

        if airframes[FOE].landed != 0 {
            // On the deck until the load is full, then away.
            airframes[FOE].vx = Q10(0);
            airframes[FOE].vy = Q10(0);
            airframes[FOE].tilt = 0;
            if airframes[FOE].fuse != 0 {
                // Down dry off its deck: its men are out; it goes up when
                // the fuse runs out.
                airframes[FOE].fuse = airframes[FOE].fuse - 1;
                if airframes[FOE].fuse == 0 { Pilot::lost(); }
                return;
            }
            airframes[FOE].rearm();
            if airframes[FOE].fuel == HELI_FUEL_MAX && airframes[FOE].gun == HELI_GUN_MAX && airframes[FOE].bombs == HELI_BOMB_MAX
               && airframes[FOE].hp == HELI_HP_MAX {
                airframes[FOE].landed = 0;
                pilot.state = FOE_WANDER;
            }
            return;
        }

        airframes[FOE].burn();
        if pilot.respond > 0 { pilot.respond = pilot.respond - 1; }
        if pilot.drop > 0 { Pilot::drop_tick(); }    // men going out of the door

        if airframes[FOE].fuel == 0 {
            // Dead stick: the player's slow forced descent (HELI_SINK), and
            // the ground ends it - only its own deck saves it. Its pilot
            // and men get out as infantry - on the campaign's rows
            // (cpu_paras), as its drops, so a test mission's battle stays
            // put.
            airframes[FOE].vx = approach(airframes[FOE].vx, Q10(0), HELI_ACC);
            airframes[FOE].lean(2);
            airframes[FOE].vy = approach(airframes[FOE].vy, HELI_SINK, HELI_GRAVITY);
            airframes[FOE].fly();
            if airframes[FOE].y == HELI_Y_MAX {
                if pad_at(airframes[FOE].x_px + (HELI_W >> 1)) == 1 {
                    airframes[FOE].landed = 1;
                    return;
                }
                if cpu_paras != 0 {                  // the pilot and the men aboard
                    para_disembark(airframes[FOE].x_px + ((HELI_W - UNIT_MAN_W) >> 1),
                                   SIDE_ENEMY, pilot.men + 1);
                    pilot.men = 0;
                }
                airframes[FOE].landed = 1;          // HELI_DRY_FUSE frames, then up
                airframes[FOE].fuse = HELI_DRY_FUSE;
            }
            return;
        }

        // The pilot: where to fly, decided every FOE_THINK frames and flown
        // every frame; the gun and the bombs every frame, since a shot is a
        // frame's opportunity.
        if pilot.burn != 0 { pilot.burn = pilot.burn - 1; }
        airframes[FOE].afterburn(pilot.burn);
        if (frames_loop & (FOE_THINK - 1)) == 0 {
            Pilot::think();
            Pilot::over_balloons();
        }
        Pilot::evade();                          // every frame: a round, or the other airframe, is quick
        // ... but never down into a balloon or its chain: a jink's foot is below it.
        if pilot.high != 0 && pilot.ty > FOE_OVER_Y { pilot.ty = FOE_OVER_Y; }
        Pilot::steer(pilot.tx, pilot.ty);
        Pilot::fire();

        let mut descending: u8 = 0;
        if airframes[FOE].vy > Q10(0) { descending = 1; }
        let vy_in: Q10 = airframes[FOE].vy;
        airframes[FOE].fly();

        // Touchdown: the player's rules. Flat out is a crash; its own deck
        // takes a landing (it never puts down anywhere else on purpose).
        if airframes[FOE].y == HELI_Y_MAX {
            if Airframe::crashes(airframes[FOE].vx, vy_in) != 0 {       // vx after the move, as Player::update
                Pilot::lost();
                return;
            }
            if descending != 0 {
                if pad_at(airframes[FOE].x_px + (HELI_W >> 1)) == 1 { airframes[FOE].landed = 1; }
            }
        }
    }
}

// air_target - the airframe a gun of side *mine* at *bx* has within
// *range*: its centre x, with the centre y in air_ty, or AIR_NONE. A
// hostile-neutral gun (SIDE_NONE) takes either, the player's first.
far fn air_target(mine: u8, bx: u16, range: u16) -> u16 {
    if mine != SIDE_PLAYER {
        if airframes[HELI].dead == 0 && airframes[HELI].rising == 0 {
            let hx: u16 = airframes[HELI].x_px + (HELI_W >> 1);
            if unit_apart(hx, bx) < range {
                air_ty = airframes[HELI].y + ((HELI_H >> 1) << 8);
                return hx;
            }
        }
    }
    if mine != SIDE_ENEMY {
        if airframes[FOE].dead == 0 && airframes[FOE].rising == 0 {
            let fx: u16 = airframes[FOE].x_px + (HELI_W >> 1);
            if unit_apart(fx, bx) < range {
                air_ty = airframes[FOE].y + ((HELI_H >> 1) << 8);
                return fx;
            }
        }
    }
    return AIR_NONE;
}

#[bank(3)]

impl Pilot {
    // The decisions, every FOE_THINK frames: bank 3, where a far call
    // every eighth frame buys back the room bank 0 needs.

    // apart - unit_apart, here in bank 3 for the decisions: that one is a
    // near function of bank 0's, and a call from here cannot reach it.
    fn apart(a: u16, b: u16) -> u16 {
        if a > b { return a - b; }
        return b - a;
    }
    // Pilot::pad_x - where the left edge sits centred on the enemy deck.
    fn pad_x() -> u16 {
        return PAD_X[1] + ((PAD_W - HELI_W) >> 1);
    }

    // Pilot::ground_target - the nearest of the player's units the row lets the
    // pilot bomb, within FOE_VIEW, other than one it has bombed its fill;
    // UNIT_NONE with none.
    fn ground_target() -> u8 {
        let flags: u8 = cpu_stats[cpu_level as u16].flags;
        let cx: u16 = airframes[FOE].x_px + (HELI_W >> 1);
        let mut best: u8 = UNIT_NONE;
        let mut best_d: u16 = FOE_VIEW;
        let mut i: u8 = unit_head[SIDE_PLAYER as u16];
        while i != UNIT_NONE {
            let u: u16 = i as u16;
            let k: u8 = units[u].kind as u8;
            let mut want: u8 = 0;
            if k == UnitType::Tank as u8 { if (flags & CPU_KILL_TANK) != 0 { want = 1; } }
            if k == UnitType::Van as u8  { if (flags & CPU_KILL_VAN)  != 0 { want = 1; } }
            if k >= UnitType::Infantry as u8 { if (flags & CPU_KILL_MEN) != 0 { want = 1; } }
            if want != 0 {
                if i == pilot.bombed {
                    let mut limit: u8 = 1;
                    if k == UnitType::Tank as u8 { limit = FOE_BOMB_TANK; }
                    if pilot.bombed_n >= limit { want = 0; }
                }
            }
            // Under the player's base missiles is out of reach: the bomb is
            // released from a hover over the man, and the hover would be in
            // the no-fly zone.
            if units[u].x_px + 12 < FOE_WEST { want = 0; }
            if want != 0 {
                let d: u16 = Pilot::apart(units[u].x_px + 12, cx);
                if d < best_d {
                    best_d = d;
                    best = i;
                }
            }
            i = units[u].behind;
        }
        return best;
    }

    // Pilot::struct_target - the nearest standing turret or bunker of the
    // player's within FOE_VIEW, a bunker only once; STRUCT_MAX with none.
    fn struct_target() -> u16 {
        let cx: u16 = airframes[FOE].x_px + (HELI_W >> 1);
        let mut best: u16 = STRUCT_MAX;
        let mut best_d: u16 = FOE_VIEW;
        for i in 0..struct_count {
            if structs[i].owner == SIDE_PLAYER && structs[i].hp > 0 {
                let k: u8 = structs[i].kind;
                if k == StructKind::Turret as u8 || k == StructKind::Bunker as u8 {
                    let mut want: u8 = 1;
                    // A turret shoots back: a pass over one costs about a
                    // dozen points, so it is not begun without them.
                    if k == StructKind::Turret as u8 && airframes[FOE].hp < FOE_HP_PASS { want = 0; }
                    if k == StructKind::Bunker as u8 && pilot.bombed == (FOE_TGT_STRUCT | (i as u8)) {
                        if pilot.bombed_n >= 1 { want = 0; }
                    }
                    // A pass runs FOE_PASS beyond the building; one that would
                    // end inside the no-fly zone is not begun.
                    if structs[i].x + (structs[i].w >> 1) < FOE_WEST + FOE_PASS { want = 0; }
                    if want != 0 {
                        let d: u16 = Pilot::apart(structs[i].x + (structs[i].w >> 1), cx);
                        if d < best_d {
                            best_d = d;
                            best = i;
                        }
                    }
                }
            }
        }
        return best;
    }

    // Pilot::think - the priority list. Sets the state, the spot to fly to and
    // the bomb target for the coming FOE_THINK frames. Whatever was chosen,
    // the spot is never inside the player's base's missile range: a hunt
    // that follows the player home stops at the edge of it.
    fn think() {
        Pilot::choose();
        // Kept out of the player base's missiles - but for a raid, which
        // flies through them to the bank, as the original's does.
        if pilot.state != FOE_RAID && pilot.tx < FOE_WEST { pilot.tx = FOE_WEST; }
        Pilot::maybe_drop();
    }

    // Pilot::raid_wanted - may it raid the player's bank now? The
    // original's maybeTakeOutEndBunker: men aboard, its 1-in-4 steal window,
    // the purse over fund_min on a CPU_ROB_BANK row or over fund_max on any
    // (cpu.r65), and a purse that pays for the distance - each unit of it
    // 64 px, so a rich purse is raided from further off. Campaign missions
    // only (cpu_paras), as the paratroopers are. The bank's index, or
    // STRUCT_MAX.
    fn raid_wanted() -> u16 {
        if cpu_paras == 0 || pilot.men == 0 || pilot.steal == 0 { return STRUCT_MAX; }
        let row: u16 = cpu_level as u16;
        let rich: u8 = funds;
        let mut want: u8 = 0;
        if (cpu_stats[row].flags & CPU_ROB_BANK) != 0 && rich > cpu_stats[row].fund_min { want = 1; }
        if rich > cpu_stats[row].fund_max { want = 1; }
        if want == 0 { return STRUCT_MAX; }
        let b: u16 = Pilot::player_bank();
        if b == STRUCT_MAX { return STRUCT_MAX; }
        let mid: u16 = structs[b].x + (structs[b].w >> 1);
        let cx: u16 = airframes[FOE].x_px + (HELI_W >> 1);
        if (Pilot::apart(cx, mid) >> 6) >= (rich as u16) { return STRUCT_MAX; }
        return b;
    }

    // Pilot::player_bank - the player's bank in the structure pool, or
    // STRUCT_MAX (a layout always has one; it is looked up, not assumed).
    fn player_bank() -> u16 {
        for i in 0..struct_count {
            if structs[i].kind == StructKind::Bank as u8 && structs[i].owner == SIDE_PLAYER { return i; }
        }
        return STRUCT_MAX;
    }

    // Pilot::maybe_drop - the original's maybeDropParatroopersNearTarget,
    // with the decisions: men out over a bunker or the super bunker that is
    // not its side's, for them to take, or coming up on a player turret
    // from the east, for them to shoot at. At most one drop every
    // FOE_PARA_EVERY; none where its own men are already on the way to the
    // building (the super bunker is dropped on regardless). Campaign
    // missions only (cpu_paras): not the frozen test missions. All of them on
    // the super bunker or when the airframe is under half its health or its
    // bombs, otherwise one. Pilot::choose flies it to a bunker for this
    // (FOE_PARA); a turret is dropped on only in passing.
    fn maybe_drop() {
        if pilot.para_t > 0 {
            if pilot.para_t > FOE_THINK { pilot.para_t = pilot.para_t - FOE_THINK; } else { pilot.para_t = 0; }
            return;
        }
        if cpu_paras == 0 || pilot.men == 0 || pilot.drop > 0 || airframes[FOE].landed != 0 { return; }
        let fx: u16 = airframes[FOE].x_px;
        let mut tgt: u16 = STRUCT_MAX;
        let mut all: u8 = 0;
        for i in 0..struct_count {
            let k: u8 = structs[i].kind;
            let sx: u16 = structs[i].x;
            let sw: u16 = structs[i].w;
            if k == StructKind::Bunker as u8 || k == StructKind::Super as u8 {
                if structs[i].owner != SIDE_ENEMY && fx + HELI_W > sx && fx < sx + sw {
                    tgt = i;
                    all = 0;
                    if k == StructKind::Super as u8 { all = 1; }
                }
            }
            if k == StructKind::Turret as u8 && structs[i].owner == SIDE_PLAYER && structs[i].hp > 0 {
                if fx >= sx + sw && fx - sx <= FOE_PARA_TURRET {
                    tgt = i;
                    all = 0;
                }
            }
        }
        if tgt == STRUCT_MAX { return; }
        if all == 0 && Pilot::men_on_the_way(tgt) != 0 { return; }
        pilot.para_t = FOE_PARA_EVERY;
        let mut n: u8 = 1;
        if all != 0 || airframes[FOE].hp < (HELI_HP_MAX >> 1) || airframes[FOE].bombs < (HELI_BOMB_MAX >> 1) {
            n = pilot.men;
        }
        pilot.drop = n;
        pilot.gap = 0;
        alert_push(ALERT_PARAS);
    }

    // Pilot::para_target - the nearest bunker or super bunker within
    // FOE_VIEW that is not its side's and whose middle is east of FOE_WEST,
    // other than a bunker its own men are already on the way to (the
    // super bunker gets the whole load whatever); STRUCT_MAX with none.
    fn para_target() -> u16 {
        let cx: u16 = airframes[FOE].x_px + (HELI_W >> 1);
        let mut best: u16 = STRUCT_MAX;
        let mut best_d: u16 = FOE_VIEW;
        for i in 0..struct_count {
            let k: u8 = structs[i].kind;
            if (k == StructKind::Bunker as u8 || k == StructKind::Super as u8) && structs[i].owner != SIDE_ENEMY {
                let mid: u16 = structs[i].x + (structs[i].w >> 1);
                if mid > FOE_WEST {
                    let d: u16 = Pilot::apart(mid, cx);
                    if d < best_d {
                        if k == StructKind::Super as u8 || Pilot::men_on_the_way(i) == 0 {
                            best_d = d;
                            best = i;
                        }
                    }
                }
            }
        }
        return best;
    }

    // Pilot::men_on_the_way - are its infantry or paratroopers in view
    // still east of building *i*'s middle, walking (or coming down) toward
    // it? The original's "nearby friends" check.
    fn men_on_the_way(i: u16) -> u8 {
        let mid: u16 = structs[i].x + (structs[i].w >> 1);
        let cx: u16 = airframes[FOE].x_px + (HELI_W >> 1);
        let mut j: u8 = unit_head[SIDE_ENEMY as u16];
        while j != UNIT_NONE {
            let u: u16 = j as u16;
            if units[u].kind as u8 >= UnitType::Infantry as u8 {
                let ux: u16 = units[u].x_px;
                if ux > mid && Pilot::apart(ux, cx) < FOE_VIEW { return 1; }
            }
            j = units[u].behind;
        }
        for p in 0..PARA_MAX {
            if para_state[p] != PARA_FREE && para_owner[p] == SIDE_ENEMY {
                if para_x[p] > mid && Pilot::apart(para_x[p], cx) < FOE_VIEW { return 1; }
            }
        }
        return 0;
    }

    // Pilot::drop_tick - a frame of a drop under way: a man out of the door
    // every FOE_PARA_GAP frames from the airframe's middle, until the drop
    // or the men run out. Called off by a landing, or by a full paratrooper
    // pool (the men stay aboard for the next).
    fn drop_tick() {
        if airframes[FOE].landed != 0 || pilot.men == 0 {
            pilot.drop = 0;
            pilot.robbing = 0;
            return;
        }
        if pilot.gap > 0 {
            pilot.gap = pilot.gap - 1;
            return;
        }
        if para_drop(airframes[FOE].x_px + (HELI_W >> 1), airframes[FOE].y, SIDE_ENEMY, pilot.robbing) == 0 {
            pilot.drop = 0;                 // nowhere to put him: called off, the men kept
            pilot.robbing = 0;
            return;
        }
        pilot.men = pilot.men - 1;
        pilot.drop = pilot.drop - 1;
        pilot.gap = FOE_PARA_GAP;
        if pilot.drop == 0 { pilot.robbing = 0; }
    }

    // Pilot::choose - what to do and where to fly, in priority order.
    fn choose() {
        // The mode roll, the original's every half minute: attack seven
        // times in eight, and hunt the player's airframe while attacking if
        // the row allows it.
        if (frames_loop & FOE_MODE_MASK) == 0 {
            pilot.attack = 0;
            if (cpu_rand() & 7) != 0 { pilot.attack = 1; }
            pilot.hunt = 0;
            if pilot.attack != 0 && (cpu_stats[cpu_level as u16].flags & CPU_KILL_COPTER) != 0 { pilot.hunt = 1; }
            // The original's stealB, a 1-in-4 roll at its targeting tick: on
            // the frame count rather than cpu_rand, whose draws deal the
            // purchases.
            pilot.steal = 0;
            if ((frames_loop >> 11) & 3) == 0 { pilot.steal = 1; }
        }

        pilot.tgt = FOE_TGT_NONE;
        let cx: u16 = airframes[FOE].x_px + (HELI_W >> 1);

        // Refit: fuel short, or two of ammo, bombs and health short - one on
        // the first two rows, where the original returns more readily.
        if pilot.state != FOE_PAD {
            let mut votes: u8 = 0;
            if airframes[FOE].gun < FOE_GUN_LOW { votes = votes + 1; }
            if airframes[FOE].bombs == 0 { votes = votes + 1; }
            if airframes[FOE].hp < FOE_HP_LOW { votes = votes + 1; }
            if cpu_level < 2 { votes = votes + 1; }
            // Fuel short is the original's 25, plus the trip home: a unit
            // burns in 96 frames, and at the slowest row's 2.75 px/frame that
            // is 264 px, so a unit per 256 px of distance is a margin.
            let trip: u16 = Pilot::apart(airframes[FOE].x_px, Pilot::pad_x());
            if airframes[FOE].fuel < FOE_FUEL_LOW + ((trip >> 8) as u8) || votes >= 2 { pilot.state = FOE_PAD; }
        }
        if pilot.state == FOE_PAD {
            let tx: u16 = Pilot::pad_x();
            pilot.tx = tx;
            pilot.ty = HELI_Y_HOVER;
            // Over the deck and slow: come down.
            if Pilot::apart(airframes[FOE].x_px, tx) <= FOE_NEAR && airframes[FOE].vx < FOE_WALK && airframes[FOE].vx > Q10(0) - FOE_WALK {
                pilot.ty = HELI_Y_MAX;
            }
            return;
        }

        // Raid: high over to the player's bank and every man out over it,
        // through the base's missiles (think lifts FOE_WEST for it). First
        // after refit, as the original's maybeTakeOutEndBunker; held once
        // begun until the men are out, or the airframe is lost.
        // (cpu_paras and the steal window are tested here, not in a call:
        // the test missions never raid, and the stress run is on its line.)
        let mut bank: u16 = STRUCT_MAX;
        if pilot.raid != 0 && pilot.men > 0 && pilot.drop == 0 {
            bank = Pilot::player_bank();
        } else {
            pilot.raid = 0;
            if cpu_paras != 0 && pilot.steal != 0 && pilot.drop == 0 {
                bank = Pilot::raid_wanted();
                if bank < STRUCT_MAX { alert_push(ALERT_RAID); }   // the raid starts
            }
        }
        if bank < STRUCT_MAX {
            pilot.raid = 1;
            pilot.state = FOE_RAID;
            // Into the base's missiles it lights the afterburner, as the
            // player can: a missile (MISSILE_SPEED, 5.5 px/frame) outruns
            // the airframe's 5, not the burner's 6.
            if pilot.burn == 0 && airframes[FOE].x_px < FOE_WEST {
                pilot.burn = HELI_BURN + HELI_BURN_RECHARGE;
            }
            let mid: u16 = structs[bank].x + (structs[bank].w >> 1);
            if mid > (HELI_W >> 1) { pilot.tx = mid - (HELI_W >> 1); } else { pilot.tx = 0; }
            pilot.ty = FOE_RAID_Y;
            if Pilot::apart(cx, mid) < FOE_RAID_NEAR {
                pilot.drop = pilot.men;         // all of them, as the original
                pilot.gap = 0;
                pilot.para_t = FOE_PARA_EVERY;
                pilot.raid = 0;
                pilot.robbing = 1;              // robbing the bank takes no room on the field
            }
            return;
        }

        // Hunt: level with the player's airframe a standoff away for the
        // gun; above it for a bomb once the gun is dry. Sitting on its own
        // deck it is bombed from hover height whatever the gun holds, on any
        // row that hunts airframes, mood or not - wherever the pilot can
        // reach it: the decks now sit beside the bases, and the player's,
        // under its base's missiles, is west of FOE_WEST, which think holds
        // the pilot to. So it is a refuge, until a deck moves out again.
        pilot.deck = 0;
        if airframes[HELI].landed != 0 && player.on_pad != 0 && airframes[FOE].bombs > 0
           && (cpu_stats[cpu_level as u16].flags & CPU_KILL_COPTER) != 0 {
            pilot.deck = 1;
        }
        if airframes[HELI].dead == 0 && airframes[HELI].rising == 0
           && (pilot.deck != 0 || (pilot.hunt != 0 && airframes[HELI].landed == 0)) {
            let hx: u16 = airframes[HELI].x_px;
            if Pilot::apart(hx, airframes[FOE].x_px) < FOE_VIEW {
                pilot.state = FOE_HUNT;
                if pilot.deck != 0 {
                    pilot.tx = hx;
                    pilot.ty = HELI_Y_HOVER;
                } else if airframes[FOE].gun > 0 || airframes[FOE].bombs == 0 {
                    if airframes[FOE].x_px > hx { pilot.tx = hx + FOE_STANDOFF; } else {
                        if hx > FOE_STANDOFF { pilot.tx = hx - FOE_STANDOFF; } else { pilot.tx = 0; }
                    }
                    pilot.ty = airframes[HELI].y;
                } else {
                    pilot.tx = hx;
                    if airframes[HELI].y > HELI_Y_MIN + (FOE_DODGE_Y << 8) { pilot.ty = airframes[HELI].y - (FOE_DODGE_Y << 8); } else { pilot.ty = HELI_Y_MIN; }
                }
                return;
            }
        }

        // Paratroopers: with men aboard and a drop allowed, over to the
        // nearest bunker in view that is not its side's, to put them on it
        // (maybe_drop does the dropping once the airframe is over it).
        // Not the original's - its steering leaves buildings alone and it
        // drops on what it is near - but men on a bunker is the point of
        // carrying them.
        if cpu_paras != 0 && pilot.men > 0 && pilot.para_t == 0 && pilot.drop == 0 {
            let b: u16 = Pilot::para_target();
            if b < STRUCT_MAX {
                pilot.state = FOE_PARA;
                let bx: u16 = structs[b].x + (structs[b].w >> 1);
                if bx > (HELI_W >> 1) { pilot.tx = bx - (HELI_W >> 1); } else { pilot.tx = 0; }
                pilot.ty = HELI_Y_HOVER;          // over_balloons lifts it over a player balloon
                return;
            }
        }

        // Bomb a ground unit, then a building, the row and the load allowing.
        if airframes[FOE].bombs > 0 && pilot.attack != 0
           && (cpu_stats[cpu_level as u16].flags & CPU_SCATTER_BOMB) != 0 {
            let u: u8 = Pilot::ground_target();
            if u != UNIT_NONE {
                pilot.state = FOE_BOMB;
                pilot.tgt = u;
                let ux: u16 = units[u as u16].x_px + (unit_stats[units[u as u16].kind as u16].width >> 1);
                if ux > (HELI_W >> 1) { pilot.tx = ux - (HELI_W >> 1); } else { pilot.tx = 0; }
                pilot.ty = HELI_Y_HOVER;
                return;
            }
            // A building is bombed on the way past, not from a hover: the
            // original never steers at one, and a bomb dropped from a hover
            // falls straight down the turret's own stream of rounds, which
            // shoots it down. So the spot is FOE_PASS beyond the building the
            // way the airframe is going, and the lead on the release does the
            // aiming; the wander brings it back over for another pass.
            if pilot.pass != AIR_NONE {
                // A pass under way: hold its course to the far end.
                if Pilot::apart(airframes[FOE].x_px, pilot.pass) > FOE_NEAR + 8 {
                    pilot.state = FOE_STRUCT;
                    pilot.tgt = pilot.pass_tgt;
                    pilot.tx = pilot.pass;
                    pilot.ty = HELI_Y_HOVER;
                    return;
                }
                pilot.pass = AIR_NONE;
            } else {
                let si: u16 = Pilot::struct_target();
                if si < STRUCT_MAX {
                    pilot.state = FOE_STRUCT;
                    pilot.tgt = FOE_TGT_STRUCT | (si as u8);
                    pilot.pass_tgt = pilot.tgt;
                    let sx: u16 = structs[si].x + (structs[si].w >> 1);
                    if cx > sx { if sx > FOE_PASS { pilot.pass = sx - FOE_PASS; } else { pilot.pass = 0; } } else { pilot.pass = sx + FOE_PASS; }
                    pilot.tx = pilot.pass;
                    pilot.ty = HELI_Y_HOVER;
                    return;
                }
            }
        }

        // Wander: toward the player's end, back short of its base's missiles
        // and at the world's far edge, on the weave.
        pilot.state = FOE_WANDER;
        if airframes[FOE].x_px <= FOE_WEST + FOE_NEAR + 8 { pilot.dir = 0; }
        if airframes[FOE].x_px >= WORLD_W - FOE_EDGE - HELI_W { pilot.dir = 1; }
        if pilot.dir != 0 { pilot.tx = FOE_WEST; } else { pilot.tx = WORLD_W - HELI_W; }
        pilot.ty = foe_weave[(frames_loop >> 6) & 3];
    }

    // Pilot::over_balloons - after every decision: a balloon of the player's
    // near enough to fly into keeps the airframe above it, at FOE_OVER_Y or
    // higher, and sets pilot.high so the every-frame dodge cannot jink it
    // back down. Its chain hangs from the balloon to the bunker's roof,
    // across hover height, so over is the only clear way past; its own
    // side's balloons are no danger to it (struct_balloon_at). The
    // original steers around chains and balloons with its whiskers.
    fn over_balloons() {
        pilot.high = 0;
        let cx: u16 = airframes[FOE].x_px + (HELI_W >> 1);
        for n in 0..bunker_count {
            let i: u16 = bunker_idx[n] as u16;
            if structs[i].bal > 0 && structs[i].owner != SIDE_ENEMY {
                if Pilot::apart(structs[i].x + BALLOON_DX + (BALLOON_W >> 1), cx) < FOE_BALLOON_X {
                    pilot.high = 1;
                    if pilot.ty > FOE_OVER_Y { pilot.ty = FOE_OVER_Y; }
                    return;
                }
            }
        }
    }

    // Pilot::lost - the airframe is gone. The next one comes after the row's
    // regen_time, rising out of the ground at the far edge; the last one is
    // the match, won. Bank 3, with the wreck's fall: bank 0 is full.
    fn lost() {
        sfx_at(SFX_CHN_LOST, SFX_EXPLODE_2, airframes[FOE].x_px + (HELI_W >> 1));
        fx_burst(FX_BIG, airframes[FOE].x_px + (HELI_W >> 1), airframes[FOE].y >> 8);
        airframes[FOE].lives = airframes[FOE].lives - 1;
        tally_helis[SIDE_ENEMY] = tally_helis[SIDE_ENEMY] + 1;
        if airframes[FOE].lives == 0 {
            game_over(GAME_WON);              // the field freezes as it stands, the player's way
        } else {
            airframes[FOE].wreck_start();
            Pilot::init();
            let t: u8 = cpu_stats[cpu_level as u16].regen_time;
            if t == 0 {
                airframes[FOE].rising = 1;
                airframes[FOE].y = GROUND_Y << 8;
            } else {
                airframes[FOE].dead = t;
            }
        }
    }
}

#[bank(0)]
