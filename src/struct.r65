// struct - the buildings: banks, bases, bunkers, the super bunker, turrets.
//
// Everything on the ground is a sprite (see the plan's graphics
// architecture), so a structure is a pool entry drawn through the shared
// OAM allocator, third in importance after the airframe and the munitions
// in flight. Structures never move; what changes is who owns one, how
// much of it is left, and what it is doing about the units in front of it.
//
// The level is a ROM table of placements, laid out west to east as the
// plan's match shape: bank -> base -> pad -> open field -> pad -> base ->
// bank, with turrets and bunkers along the field and the super bunker in
// the middle. Ownership shows through the OBJ palette: green trim is the
// player's, red-brown the enemy's, grey nobody's.

#[bank(0)]

const STRUCT_MAX: u16 = 16;

// Owners. SIDE_PLAYER and SIDE_ENEMY are the units'; a structure may also
// belong to nobody, which is what a captured-then-emptied bunker or a
// turret nobody has claimed is.
const SIDE_NONE: u8 = 2;

// OBJ palettes, as an OAM attribute's palette field. 0-2 are obj.bmp's -
// player (the sheet's greens), enemy, nobody - and 3-4 are heli.bmp's,
// the airframe's own sheet: its colours and the enemy's recolouring of
// them. Each sheet carries one palette and the variants are built from it
// at boot by recolouring the green entries (see struct_palettes).
const OBJ_PAL_PLAYER:  u16 = 0x0000;
const OBJ_PAL_ENEMY:   u16 = 0x0200;
const OBJ_PAL_NEUTRAL: u16 = 0x0400;
const OBJ_PAL_HELI:       u16 = 0x0600;
const OBJ_PAL_HELI_ENEMY: u16 = 0x0800;
// ... and where each one starts in CGRAM.
const CGRAM_OBJ_ENEMY:      u16 = 144;
const CGRAM_OBJ_NEUTRAL:    u16 = 160;
const CGRAM_OBJ_HELI:       u16 = 176;
const CGRAM_OBJ_HELI_ENEMY: u16 = 192;

// ------------------------------------------------------------- kinds ---
enum StructKind { Turret, Bunker, Super, Base, Bank }

// Everything fixed about a kind, one row per StructKind in that order.
// Sizes are in 16x16 cells; the cell box stands on the ground line, so a
// 24 px building in a 32 px box has its 8 empty rows on top. Tiles are
// the box's top-left cell on the sheet (tools/struct_art.py); the cell to
// the right is +2 and the one below +32.
#[soa]
struct StructStat {
    tile:    u8,
    cells_w: u8,
    cells_h: u8,
    max_hp:  u8,
}

const STRUCT_TILE_TURRET: u8 = 96;
const STRUCT_TILE_BUNKER: u8 = 102;
const STRUCT_TILE_BANK:   u8 = 106;
const STRUCT_TILE_SUPER:  u8 = 160;
const STRUCT_TILE_BASE:   u8 = 166;
const STRUCT_TILE_BALLOON: u8 = 98;
const STRUCT_TILE_CHAIN:   u8 = 100;      // an 8x8 tile
const STRUCT_TILE_LAUNCHER_LOADED: u8 = 236;
const STRUCT_TILE_LAUNCHER_EMPTY:  u8 = 238;

// ----------------------------------------------------------- bunkers ---
// A bunker is taken by an infantryman - not an engineer - of another side
// walking into it: he goes inside and it is his side's. Tank shells and
// bombs wear it down; at zero it is rubble that nobody can hold, drawn
// with nobody's colours until phase 12 gives it art of its own.
//
// Each standing bunker moors a barrage balloon on a chain. The balloon
// kills a helicopter of either side on contact - the plan's quirk worth
// keeping - and gunfire brings it down; it regrows after a while.
const BUNKER_W:       u16 = 32;
const BUNKER_ROOF_Y:  u16 = GROUND_Y - 24;
const BUNKER_DMG_SHELL: u8 = 8;
const BUNKER_DMG_BLAST: u8 = 25;

// ------------------------------------------------------- super bunker ---
// Its hit points are the men inside, five at most. An infantryman of its
// side walking in joins them; one of another side fights - he and one
// inside both fall - and takes it over if he finds it empty. Only a tank
// shell hurts it, one man a shell. Its gun fires on everything of another
// side within reach - it lofts rounds at a helicopter and puts them along
// the ground at units - faster the more men it holds; at no men it is
// nobody's and hostile-neutral, firing on every side's airframe, which is
// what makes it the centre of the field. An empty bunker does not fire on
// ground units, or nobody could ever walk in and man it; a manned one
// does, so the way to take it is a tank line to put the garrison out
// first. Units inside its box are immune: rounds at the ground leave from
// the wall facing the target, not the centre.
const SUPER_W:        u16 = 40;
const SUPER_RANGE:    u16 = 200;
const SUPER_RATE_BASE: u8 = 30;           // frames between rounds, empty
// Four frames fewer per man inside (a shift, since `*` takes powers of two).
const SUPER_MEN_MAX:   u8 = 5;

// ---------------------------------------------------------------- base ---
// A helicopter within BASE_RANGE of a base draws a smart missile every
// BASE_RATE frames: the plan's no-fly zone. Nothing hurts a base; a van
// reaching it ends the match (phase 9).
// The missile stands on a launcher on the base's tower, and the launcher
// shows the reload: empty from the shot until the countdown runs out, so
// a pilot can see when the next one is ready.
const BASE_W:     u16 = 64;
const BASE_RANGE: u16 = 320;
const BASE_RATE:  u8  = 45;
const BASE_LAUNCHER_DX: u16 = 24;          // the tower's left edge in the base

// ---------------------------------------------------------------- bank ---
// The end bunker holds the funds. Its gun covers BANK_RANGE like a
// turret's until two tank shells silence it (hp 10, a shell 5). An enemy
// infantryman reaching it steals half the purse and is spent doing so.
const BANK_W:         u16 = 32;
const BANK_RANGE:     u16 = 200;
const BANK_RATE:      u8  = 20;
const BANK_DMG_SHELL: u8  = 5;

const BALLOON_HP:     u8  = 3;
const BALLOON_REGROW: u8  = 240;          // frames, counted in 4s (see tick)
const BALLOON_DX:     u16 = 8;            // over the bunker's centre
const BALLOON_Y:      u16 = 72;
const BALLOON_W:      u16 = 16;
const BALLOON_H:      u16 = 16;

static struct_stats: [StructStat; 5] = [
    // Turret: hit points are the plan's 31, doubled so tank fire's 8 and
    // gunfire's 0.5 are 16 and 1 without fractions.
    StructStat { tile: STRUCT_TILE_TURRET, cells_w: 1, cells_h: 1, max_hp: 62 },
    // Bunker
    StructStat { tile: STRUCT_TILE_BUNKER, cells_w: 2, cells_h: 2, max_hp: 69 },
    // Super bunker: hp is the men inside, five at most
    StructStat { tile: STRUCT_TILE_SUPER,  cells_w: 3, cells_h: 2, max_hp: 5 },
    // Base: only a van ends it, so hp is nominal
    StructStat { tile: STRUCT_TILE_BASE,   cells_w: 4, cells_h: 2, max_hp: 1 },
    // Bank (end bunker)
    StructStat { tile: STRUCT_TILE_BANK,   cells_w: 2, cells_h: 2, max_hp: 10 },
];

// ------------------------------------------------------------ layout ---
// The level, west to east - and it must stay that way: the draw cull and
// the munition test both stop at the first building east of what they are
// looking at. A kind's x is its left edge in world pixels; the two bases
// stand a screen inside each edge with the units' spawn points just past
// them, the pads a few screens in (pad.r65), and the field between
// carries the fought-over ground.
//
// The list is written by `mission_layout` (mission.r65) from the mission's
// row, not held as data here: the campaign's difficulty curve is the one
// place that decides how much of the field is fortified.
#[soa]
struct Placement {
    kind:  u8,
    x:     u16,
    owner: u8,
}

#[lowram] static mut level_layout: [Placement; 16];
#[lowram] static mut level_count:  u16;

// -------------------------------------------------------------- pool ---
// One record per placed structure, index-stable for the whole match. The
// geometry the draw needs every frame - pixel width, cell counts, box top,
// first tile, attribute word - is filled in once from the stats and the
// owner rather than looked up per frame: fifteen buildings are culled on
// every tick, and that path is a subtract and two compares.
#[soa]
struct Structure {
    kind:  u8,
    x:     u16,
    owner: u8,
    hp:    u8,
    t:     u8,           // fire / repair countdown
    w:     u16,          // pixel width of the cell box
    cols:  u8,
    rows:  u8,
    top:   u8,           // screen y of the cell box
    tile:  u8,
    attr:  u16,          // priority and the owner's palette
    bal:   u8,           // bunker: balloon hit points, 0 = down
    men:   u8,           // super bunker: the infantry inside
}

#[lowram] static mut structs: [Structure; 16];
#[lowram] static mut struct_count: u16;

// The turrets by pool index, so the per-frame scans and the munition
// test walk six entries rather than asking fifteen buildings their kind.
#[lowram] static mut turret_idx: [u8; 8];
#[lowram] static mut turret_count: u16;
#[lowram] static mut bunker_idx: [u8; 8];
#[lowram] static mut bunker_count: u16;
// The rest are one or two of a kind; their pool indices are found once.
#[lowram] static mut super_i: u16;
#[lowram] static mut base_idx: [u8; 2];
#[lowram] static mut bank_idx: [u8; 2];
#[lowram] static mut base_count: u16;
#[lowram] static mut bank_count: u16;

// struct_attr - the OAM attribute word for an owner: priority 3 and the
// owner's palette.
fn struct_attr(owner: u8) -> u16 {
    if owner == SIDE_ENEMY { return 0x3000 | OBJ_PAL_ENEMY; }
    if owner == SIDE_NONE { return 0x3000 | OBJ_PAL_NEUTRAL; }
    return 0x3000 | OBJ_PAL_PLAYER;
}

// struct_set_owner - hand a structure to a side; the palette follows.
fn struct_set_owner(i: u16, owner: u8) {
    radar_base_dirty = 1;
    structs[i].owner = owner;
    structs[i].attr = struct_attr(owner);
}

far fn struct_init() {
    for i in 0..level_count {
        let k: u16 = level_layout[i].kind as u16;
        let cols: u8 = struct_stats[k].cells_w;
        let rows: u8 = struct_stats[k].cells_h;
        structs[i].kind = level_layout[i].kind;
        structs[i].x = level_layout[i].x;
        structs[i].hp = struct_stats[k].max_hp;
        structs[i].t = 0;
        structs[i].w = (cols as u16) << 4;
        structs[i].cols = cols;
        structs[i].rows = rows;
        structs[i].top = (GROUND_Y - ((rows as u16) << 4)) as u8;
        structs[i].tile = struct_stats[k].tile;
        structs[i].bal = 0;
        structs[i].men = 0;
        if level_layout[i].kind == StructKind::Bunker as u8 { structs[i].bal = BALLOON_HP; }
        struct_set_owner(i, level_layout[i].owner);
    }
    struct_count = level_count;

    // RAM is garbage at power-on: every count starts at zero here.
    turret_count = 0;
    bunker_count = 0;
    base_count = 0;
    bank_count = 0;
    super_i = 0;
    for i in 0..level_count {
        if level_layout[i].kind == StructKind::Turret as u8 {
            turret_idx[turret_count] = i as u8;
            turret_count = turret_count + 1;
        }
        if level_layout[i].kind == StructKind::Bunker as u8 {
            bunker_idx[bunker_count] = i as u8;
            bunker_count = bunker_count + 1;
        }
        if level_layout[i].kind == StructKind::Super as u8 { super_i = i; }
        if level_layout[i].kind == StructKind::Base as u8 {
            base_idx[base_count] = i as u8;
            base_count = base_count + 1;
        }
        if level_layout[i].kind == StructKind::Bank as u8 {
            bank_idx[bank_count] = i as u8;
            bank_count = bank_count + 1;
        }
    }
    // The super bunker starts empty, and empty means hostile-neutral.
    structs[super_i].hp = 0;
    structs[super_i].men = 0;
}

// struct_draw - place the structures inside the camera window, third in
// the importance order. A building is a grid of 16x16 cells standing on
// the ground line; a cell wholly off the right edge is skipped so a
// half-visible base does not spend slots on nothing.
far fn struct_draw() {
    // The pool is the level table's order, west to east, so the first
    // building east of the window ends the walk: everything after it is
    // further east still. (A `while` with the index run off the end,
    // rather than `break` - see the project's entity-loop rule.)
    let mut i: u16 = 0;
    while i < struct_count {
        let sx: u16 = structs[i].x - camera_x;
        // Visible if any of it is: left edge inside the window, or - for
        // one just west of the camera, sx wrapped to $FFxx - the window's
        // left edge inside the building.
        let mut show: u8 = 0;
        if sx < 256 {
            show = 1;
        } else {
            if sx >= 0xFFC0 {
                if (0 - sx) < structs[i].w { show = 1; }
            } else {
                if sx < 0x8000 { i = struct_count; }     // east of the window
            }
        }
        if show != 0 {
            let attr: u16 = structs[i].attr;
            let cols: u16 = structs[i].cols as u16;
            let mut ty: u16 = structs[i].top as u16;
            let mut row_tile: u16 = structs[i].tile as u16;
            for r in 0..(structs[i].rows as u16) {
                let mut cx: u16 = sx & 0x01FF;
                let mut tile: u16 = row_tile;
                for c in 0..cols {
                    // A cell entirely off the right edge still costs a
                    // slot; one partly off the left ($1F0..$1FF) does not.
                    if cx < 256 || cx >= 0x01F0 {
                        let slot: u16 = oam_take();
                        if slot < OAM_SLOTS {
                            oam.set_full!(slot as u8, cx, ty as u8, tile | attr);
                            oam.set_size!(slot as u8, 1);
                        }
                    }
                    cx = (cx + 16) & 0x01FF;
                    tile = tile + 2;
                }
                row_tile = row_tile + 32;
                ty = ty + 16;
            }
            let kind: u8 = structs[i].kind;
            if kind == StructKind::Bunker as u8 {
                if structs[i].bal > 0 { struct_balloon_draw(i, sx); }
            } else {
                // The base's launcher, one cell on the tower: loaded while the
                // countdown is spent, empty while it reloads. Inline rather than
                // a call: it runs every frame a base is in view.
                if kind == StructKind::Base as u8 {
                    let slot: u16 = oam_take();
                    if slot < OAM_SLOTS {
                        let mut tile: u16 = STRUCT_TILE_LAUNCHER_LOADED as u16;
                        if structs[i].t != 0 { tile = STRUCT_TILE_LAUNCHER_EMPTY as u16; }
                        oam.set_full!(slot as u8, (sx + BASE_LAUNCHER_DX) & 0x01FF, structs[i].top - 16, tile | attr);
                        oam.set_size!(slot as u8, 1);
                    }
                }
            }
        }
        if i < struct_count { i = i + 1; }
    }
}

// struct_balloon_draw - the barrage balloon over bunker *i* and the chain
// down to its roof: one 16x16 cell and 8x8 links every 8 px.
fn struct_balloon_draw(i: u16, sx: u16) {
    let bx: u16 = (sx + BALLOON_DX) & 0x01FF;
    let attr: u16 = structs[i].attr;
    let slot: u16 = oam_take();
    if slot < OAM_SLOTS {
        oam.set_full!(slot as u8, bx, BALLOON_Y as u8, (STRUCT_TILE_BALLOON as u16) | attr);
        oam.set_size!(slot as u8, 1);
    }
    let cx: u16 = (bx + 4) & 0x01FF;
    let mut cy: u16 = BALLOON_Y + 16;
    while cy < BUNKER_ROOF_Y {
        let link: u16 = oam_take();
        if link < OAM_SLOTS {
            oam.set_full!(link as u8, cx, cy as u8, (STRUCT_TILE_CHAIN as u16) | attr);
            oam.set_size!(link as u8, 0);
        }
        cy = cy + 8;
    }
}

// ------------------------------------------------------------ turrets ---
// A turret sweeps turret_range either side for the other side's units and,
// if it is the enemy's, the helicopter - which it prefers, being the one
// thing that can come to it. It fires a round every turret_rate frames
// while it has a target; that rate is the plan's difficulty dial. Damage
// from gunfire is a scratch and from a tank shell a chunk (see the stats),
// and while any of it stands it heals a point every TURRET_REPAIR frames.
// At zero it is nobody's and does nothing until an engineer of either side
// walks up to it, claims it, and stands there restoring it a point a frame.
// Both are the mission's now (mission.r65): `turret_range` and
// `turret_rate`, the plan's difficulty dial.
const TURRET_REPAIR: u8  = 32;
const TURRET_MUZZLE: u16 = 8;             // px above the ground line
const TURRET_W:      u16 = 16;

// Munition damage to a turret. Gunfire's half point is one on the doubled
// scale; a shell's 8 is 16; a bomb's blast counts as a shell.
const TURRET_DMG_BULLET: u8 = 1;
const TURRET_DMG_SHELL:  u8 = 16;

// struct_turret_target - the nearest unit of the other side within reach,
// or UNIT_MAX. The scan runs once per shot, not per frame.
fn struct_turret_target(i: u16) -> u16 {
    return struct_gun_target(i, turret_range);
}

// struct_gun_target - the nearest unit of another side within *range* of
// structure *i*'s centre, or UNIT_MAX.
fn struct_gun_target(i: u16, range: u16) -> u16 {
    let x: u16 = structs[i].x + (structs[i].w >> 1);
    let mine: u8 = structs[i].owner;
    let mut best: u16 = UNIT_MAX;
    let mut best_d: u16 = range;
    for j in 0..UNIT_MAX {
        if units[j].kind as u8 != UnitType::Free as u8 {
            if units[j].owner != mine {
                let ux: u16 = units[j].x_px;
                let mut d: u16 = 0;
                if ux > x { d = ux - x; } else { d = x - ux; }
                if d < best_d { best_d = d; best = j; }
            }
        }
    }
    return best;
}

// struct_turret_fire - one round from turret *i* toward world x *tx*, at
// screen height *ty* (8.8). A ground target gets a flat round; the
// helicopter gets one lofted along the line to it.
fn struct_turret_fire(i: u16, tx: u16, ty: u16) {
    let mx: u16 = structs[i].x + (structs[i].w >> 1);
    let my: u16 = (GROUND_Y - TURRET_MUZZLE) << 8;
    let mut v: Q10 = BULLET_SPEED;
    let mut dx: u16 = tx - mx;
    if tx < mx { v = Q10(0) - BULLET_SPEED; dx = mx - tx; }
    let mut vy: Q10 = Q10(0);
    if ty < my {
        // Rise over run, scaled to the round's speed. dx is at least a
        // few pixels whenever this fires, so the quotient is bounded.
        let dy: u16 = (my - ty) >> 8;
        if dx == 0 { dx = 1; }
        vy = Q10(0) - Q10::from_int(dy as i16).div(Q10::from_int(dx as i16)).mul(BULLET_SPEED);
    }
    muni_spawn(MUNI_BULLET, mx, my, v, vy, BULLET_LIFE, structs[i].owner);
}

fn struct_turret_tick(i: u16) {
    if structs[i].hp == 0 { return; }
    if structs[i].owner == SIDE_NONE { return; }

    // Self-repair rides the same countdown as the gun when idle: a
    // turret with nothing to shoot heals on its own schedule.
    if structs[i].t > 0 {
        structs[i].t = structs[i].t - 1;
        return;
    }

    // The other side's airframe first.
    let hx: u16 = air_target(structs[i].owner, structs[i].x + (TURRET_W >> 1), turret_range);
    if hx != AIR_NONE {
        struct_turret_fire(i, hx, air_ty);
        structs[i].t = turret_rate;
        return;
    }

    let j: u16 = struct_turret_target(i);
    if j < UNIT_MAX {
        let w: u16 = unit_stats[units[j].kind as u16].width;
        struct_turret_fire(i, units[j].x_px + (w >> 1), (GROUND_Y - 8) << 8);
        structs[i].t = turret_rate;
    } else {
        structs[i].t = TURRET_REPAIR;
        let max: u8 = struct_stats[StructKind::Turret as u16].max_hp;
        if structs[i].hp < max { structs[i].hp = structs[i].hp + 1; }
    }
}

// struct_turret_claim - an engineer standing at a turret that is not his
// side's takes it, and restores it a point a frame while he is there.
fn struct_turret_claim(i: u16) {
    let x: u16 = structs[i].x;
    for j in 0..UNIT_MAX {
        if units[j].kind as u8 == UnitType::Engineer as u8 {
            let ux: u16 = units[j].x_px;
            if ux + UNIT_MAN_W > x {
                if ux < x + TURRET_W {
                    if structs[i].owner != units[j].owner {
                        struct_set_owner(i, units[j].owner);
                    }
                    let max: u8 = struct_stats[StructKind::Turret as u16].max_hp;
                    if structs[i].hp < max { structs[i].hp = structs[i].hp + 1; }
                }
            }
        }
    }
}

// struct_turret_hit - damage to turret *i*; at zero it falls to nobody.
fn struct_turret_hit(i: u16, dmg: u8) {
    if structs[i].hp > dmg {
        structs[i].hp = structs[i].hp - dmg;
    } else {
        structs[i].hp = 0;
        struct_set_owner(i, SIDE_NONE);
    }
}

// struct_update - one tick for every structure. The engineer scan is
// O(units) per turret, so each turret runs it on its own frame in
// sixteen - an engineer covers eight pixels in that time.
far fn struct_update() {
    for n in 0..turret_count {
        let i: u16 = turret_idx[n] as u16;
        struct_turret_tick(i);
        if (frames_loop & 15) == (n & 15) {
            struct_turret_claim(i);
        }
    }
    for n in 0..bunker_count {
        let i: u16 = bunker_idx[n] as u16;
        struct_bunker_tick(i);
        if (frames_loop & 15) == ((n + 8) & 15) {
            struct_bunker_capture(i);
        }
    }
    struct_super_tick(super_i);
    if (frames_loop & 15) == 12 { struct_super_enter(super_i); }
    for n in 0..base_count {
        let i: u16 = base_idx[n] as u16;
        struct_base_tick(i);
        // A van at 0.5 px/frame is inside the trigger window for ~110
        // frames; every 32 is a third of the scan for the same answer.
        if (frames_loop & 31) == (10 + n) { struct_base_van(i); }
    }
    for n in 0..bank_count {
        let i: u16 = bank_idx[n] as u16;
        struct_bank_tick(i);
        if (frames_loop & 15) == (13 + n) { struct_bank_rob(i); }
    }
}

// struct_collide - munitions against structures. Runs after the pools
// have moved, in the same pass order as unit_collide.
//
// A round in the ground band walks the pool west to east and stops at
// the first building east of it, so it pays one subtract-and-compare per
// building it passes and looks closely at the one it is inside - the
// pool is the level table's order. Balloons hang above the band and only
// gunfire reaches them; they are tested from the bunker list.
far fn struct_collide() {
    for m in 0..MUNI_MAX {
        let mk: u8 = muni_kind[m];
        if mk != MUNI_FREE {
            let my: u16 = muni_y[m] >> 8;
            let mx: u16 = muni_x_px[m];
            if mk == MUNI_BULLET && my >= BALLOON_Y && my < BALLOON_Y + BALLOON_H {
                for n in 0..bunker_count {
                    let i: u16 = bunker_idx[n] as u16;
                    if structs[i].bal > 0 {
                        if (mx - (structs[i].x + BALLOON_DX)) < BALLOON_W {
                            struct_balloon_hit(i);
                            muni_kind[m] = MUNI_FREE;
                        }
                    }
                }
            }
            // A blast sits on the ground line itself.
            if my <= GROUND_Y && my >= GROUND_Y - 32 {
                let mut i: u16 = 0;
                while i < struct_count {
                    let dx: u16 = mx - structs[i].x;          // wraps when west
                    if dx < structs[i].w {
                        struct_collide_one(m, mk, my, i);
                        i = struct_count;                     // one building holds the point
                    } else {
                        if dx >= 0x8000 { i = struct_count; } // this and the rest are east
                    }
                    if i < struct_count { i = i + 1; }
                }
            }
        }
    }
}

// struct_collide_one - munition *m* is inside building *i*'s footprint.
fn struct_collide_one(m: u16, mk: u8, my: u16, i: u16) {
    let k: u8 = structs[i].kind;
    if k == StructKind::Turret as u8 {
        if structs[i].hp > 0 && muni_owner[m] != structs[i].owner {
            if my >= structs[i].top as u16 {
                let mut dmg: u8 = 0;
                if mk == MUNI_BULLET { dmg = TURRET_DMG_BULLET; }
                if mk == MUNI_SHELL || mk == MUNI_BLAST { dmg = TURRET_DMG_SHELL; }
                if dmg > 0 {
                    struct_turret_hit(i, dmg);
                    if mk != MUNI_BLAST { muni_kind[m] = MUNI_FREE; }
                }
            }
        }
        return;
    }
    if k == StructKind::Bunker as u8 {
        if structs[i].hp > 0 {
            if mk == MUNI_SHELL {
                struct_bunker_hit(i, BUNKER_DMG_SHELL);
                muni_kind[m] = MUNI_FREE;
            }
            if mk == MUNI_BLAST { struct_bunker_hit(i, BUNKER_DMG_BLAST); }
        }
        return;
    }
    if mk == MUNI_SHELL {
        if k == StructKind::Super as u8 {
            struct_super_hit(i);
            muni_kind[m] = MUNI_FREE;
        }
        if k == StructKind::Bank as u8 {
            if muni_owner[m] != structs[i].owner {
                struct_bank_hit(i);
                muni_kind[m] = MUNI_FREE;
            }
        }
    }
}

// ------------------------------------------------------------ bunkers ---
// struct_bunker_capture - an infantryman of another side inside the
// bunker's footprint takes it and is consumed. Engineers walk past.
fn struct_bunker_capture(i: u16) {
    let x: u16 = structs[i].x;
    for j in 0..UNIT_MAX {
        if units[j].kind as u8 == UnitType::Infantry as u8 {
            if units[j].owner != structs[i].owner {
                let ux: u16 = units[j].x_px;
                if ux + UNIT_MAN_W > x + 8 {
                    if ux < x + BUNKER_W - 8 {
                        struct_set_owner(i, units[j].owner);
                        // A shelled-out bunker is still taken, and the man
                        // who takes it brings it back: full strength, and
                        // the balloon regrows on its usual countdown.
                        if structs[i].hp == 0 {
                            structs[i].hp = struct_stats[StructKind::Bunker as u16].max_hp;
                            structs[i].t = BALLOON_REGROW;
                        }
                        unit_free(j);
                        return;
                    }
                }
            }
        }
    }
}

// struct_bunker_hit - shells and blasts against a standing bunker.
fn struct_bunker_hit(i: u16, dmg: u8) {
    if structs[i].hp > dmg {
        structs[i].hp = structs[i].hp - dmg;
    } else {
        structs[i].hp = 0;
        structs[i].bal = 0;
        struct_set_owner(i, SIDE_NONE);
    }
}

// struct_bunker_tick - regrow a downed balloon over a standing bunker.
// The countdown steps every fourth frame so a u8 spans sixteen seconds.
fn struct_bunker_tick(i: u16) {
    if structs[i].hp == 0 { return; }
    if structs[i].bal == 0 {
        if (frames_loop & 3) == 0 {
            if structs[i].t > 0 {
                structs[i].t = structs[i].t - 1;
            } else {
                structs[i].bal = BALLOON_HP;
            }
        }
    }
}

// struct_ahead - the building nearest ahead of a unit at *x* facing its
// side's way, if the gap between the two boxes is under *range*; else
// STRUCT_MAX. Walks the sorted pool from the unit's own end - the first
// building east of a player's, the last west of an enemy's - so it asks
// one building, not every one. Eight idle tanks sweep every sixteen
// frames, and the riflemen too. (A `while` run off the end rather than
// `break`, per the entity-loop rule.)
fn struct_ahead(x: u16, mine: u8, range: u16) -> u16 {
    let mut found: u16 = STRUCT_MAX;
    let mut gap: u16 = 0;
    let mut n: u16 = 0;
    if mine == SIDE_PLAYER {
        let front: u16 = x + UNIT_W;
        while n < struct_count {
            let sx: u16 = structs[n].x;
            if sx >= front {
                found = n;
                gap = sx - front;
                n = struct_count;
            } else {
                n = n + 1;
            }
        }
    } else {
        n = struct_count;
        while n > 0 {
            n = n - 1;
            let back: u16 = structs[n].x + structs[n].w;
            if back <= x {
                found = n;
                gap = x - back;
                n = 0;
            }
        }
    }
    if gap >= range { return STRUCT_MAX; }
    return found;
}

// struct_tank_target - is a standing turret, bunker or manned super
// bunker of the other side within *range* ahead of a tank at *x*?
// Neutral buildings are left alone: a fallen turret is nobody's and fires
// at nobody, a neutral bunker is the infantry's job, and an empty super
// bunker has nobody to shell out of it.
far fn struct_tank_target(x: u16, mine: u8, range: u16) -> u8 {
    let found: u16 = struct_ahead(x, mine, range);
    if found == STRUCT_MAX { return 0; }
    if structs[found].hp == 0 { return 0; }
    let owner: u8 = structs[found].owner;
    if owner == mine || owner == SIDE_NONE { return 0; }
    let k: u8 = structs[found].kind;
    if k == StructKind::Turret as u8 || k == StructKind::Bunker as u8 { return 1; }
    // A manned super bunker is its garrison's; a shell puts a man out.
    if k == StructKind::Super as u8 { return 1; }
    return 0;
}

// struct_rifle_target - a standing turret of the other side within
// *range* ahead of a rifleman at *x*, or STRUCT_MAX. Infantry fire at
// turrets for the roster's half point (one on the doubled scale); they
// do not stop for one, so it is a few points on the way past.
far fn struct_rifle_target(x: u16, mine: u8, range: u16) -> u16 {
    let found: u16 = struct_ahead(x, mine, range);
    if found == STRUCT_MAX { return STRUCT_MAX; }
    if structs[found].kind != StructKind::Turret as u8 { return STRUCT_MAX; }
    if structs[found].hp == 0 { return STRUCT_MAX; }
    let owner: u8 = structs[found].owner;
    if owner == mine || owner == SIDE_NONE { return STRUCT_MAX; }
    return found;
}

// struct_rifle_hit - a rifleman's shot against turret *i*.
far fn struct_rifle_hit(i: u16) {
    struct_turret_hit(i, TURRET_DMG_BULLET);
}

// struct_balloon_hit - gunfire against the balloon; down at zero.
fn struct_balloon_hit(i: u16) {
    if structs[i].bal > 1 {
        structs[i].bal = structs[i].bal - 1;
    } else {
        structs[i].bal = 0;
        structs[i].t = BALLOON_REGROW;
    }
}

// struct_balloon_at - is the airframe's box on a balloon? Any bunker's:
// a balloon does not care whose helicopter it is.
far fn struct_balloon_at(hx: u16, hy: u16) -> u8 {
    // An airframe at hover height is under every balloon: no scan.
    if hy >= BALLOON_Y + BALLOON_H { return 0; }
    for n in 0..bunker_count {
        let i: u16 = bunker_idx[n] as u16;
        if structs[i].bal > 0 {
            let bx: u16 = structs[i].x + BALLOON_DX;
            if hx + HELI_W > bx {
                if hx < bx + BALLOON_W {
                    if hy + HELI_H > BALLOON_Y {
                        if hy < BALLOON_Y + BALLOON_H { return 1; }
                    }
                }
            }
        }
    }
    return 0;
}

// ------------------------------------------------------- super bunker ---
fn struct_super_enter(i: u16) {
    let x: u16 = structs[i].x;
    for j in 0..UNIT_MAX {
        if units[j].kind as u8 == UnitType::Infantry as u8 {
            let ux: u16 = units[j].x_px;
            if ux + UNIT_MAN_W > x + 12 {
                if ux < x + SUPER_W - 12 {
                    if units[j].owner == structs[i].owner {
                        if structs[i].men < SUPER_MEN_MAX {
                            structs[i].men = structs[i].men + 1;
                            structs[i].hp = structs[i].men;
                            unit_free(j);
                        }
                    } else {
                        if structs[i].men == 0 {
                            struct_set_owner(i, units[j].owner);
                            structs[i].men = 1;
                        } else {
                            structs[i].men = structs[i].men - 1;
                            if structs[i].men == 0 { struct_set_owner(i, SIDE_NONE); }
                        }
                        structs[i].hp = structs[i].men;
                        unit_free(j);
                    }
                    return;
                }
            }
        }
    }
}

// struct_super_hit - a tank shell kills a man inside; none left and it is
// nobody's again.
fn struct_super_hit(i: u16) {
    if structs[i].men > 0 {
        structs[i].men = structs[i].men - 1;
        structs[i].hp = structs[i].men;
        if structs[i].men == 0 { struct_set_owner(i, SIDE_NONE); }
    }
}

fn struct_super_tick(i: u16) {
    if structs[i].t > 0 {
        structs[i].t = structs[i].t - 1;
        return;
    }
    structs[i].t = SUPER_RATE_BASE - (structs[i].men << 2);   // four fewer per man

    // Any airframe of another side - both, when it is nobody's.
    let hx: u16 = air_target(structs[i].owner, structs[i].x + (SUPER_W >> 1), SUPER_RANGE);
    if hx != AIR_NONE {
        struct_turret_fire(i, hx, air_ty);
        return;
    }

    // Then the ground, for a manned bunker.
    if structs[i].men == 0 { return; }
    let j: u16 = struct_super_target(i);
    if j < UNIT_MAX {
        let x: u16 = structs[i].x;
        let mut mx: u16 = x + SUPER_W;                // the wall facing it
        let mut v: Q10 = BULLET_SPEED;
        if units[j].x_px < x { mx = x; v = Q10(0) - BULLET_SPEED; }
        muni_spawn(MUNI_BULLET, mx, (GROUND_Y - TURRET_MUZZLE) << 8, v, Q10(0),
                   BULLET_LIFE, structs[i].owner);
    }
}

// struct_super_target - the nearest unit of another side within reach of
// the super bunker and outside its box, or UNIT_MAX. struct_gun_target
// without the box: a unit standing in the doorway is not shot.
fn struct_super_target(i: u16) -> u16 {
    let x: u16 = structs[i].x;
    let cx: u16 = x + (SUPER_W >> 1);
    let mine: u8 = structs[i].owner;
    let mut best: u16 = UNIT_MAX;
    let mut best_d: u16 = SUPER_RANGE;
    for j in 0..UNIT_MAX {
        if units[j].kind as u8 != UnitType::Free as u8 {
            if units[j].owner != mine {
                let ux: u16 = units[j].x_px;
                if ux + UNIT_W <= x || ux >= x + SUPER_W {
                    let mut d: u16 = 0;
                    if ux > cx { d = ux - cx; } else { d = cx - ux; }
                    if d < best_d { best_d = d; best = j; }
                }
            }
        }
    }
    return best;
}

// ---------------------------------------------------------------- base ---
// struct_base_van - a van of the other side inside the base's footprint
// destroys it, and that is the match (game.r65).
fn struct_base_van(i: u16) {
    if structs[i].hp == 0 { return; }
    let x: u16 = structs[i].x;
    for j in 0..UNIT_MAX {
        if units[j].kind as u8 == UnitType::Van as u8 {
            if units[j].owner != structs[i].owner {
                let ux: u16 = units[j].x_px;
                if ux + UNIT_W > x + 16 {
                    if ux < x + BASE_W - 16 {
                        structs[i].hp = 0;
                        unit_free(j);
                        if structs[i].owner == SIDE_ENEMY {
                            game_over(GAME_WON);
                        } else {
                            game_over(GAME_LOST);
                        }
                        struct_set_owner(i, SIDE_NONE);
                        return;
                    }
                }
            }
        }
    }
}

fn struct_base_tick(i: u16) {
    if structs[i].t > 0 {
        structs[i].t = structs[i].t - 1;
        return;
    }
    let bx: u16 = structs[i].x + (BASE_W >> 1);
    if air_target(structs[i].owner, bx, BASE_RANGE) != AIR_NONE {
        muni_spawn(MUNI_MISSILE, bx, (GROUND_Y - 32) << 8, Q10(0), Q10(0) - MISSILE_SPEED,
                   MISSILE_LIFE, structs[i].owner);
        structs[i].t = BASE_RATE;
    }
}

// ---------------------------------------------------------------- bank ---
fn struct_bank_tick(i: u16) {
    if structs[i].t > 0 {
        structs[i].t = structs[i].t - 1;
        return;
    }
    if structs[i].hp > 0 {
        let j: u16 = struct_gun_target(i, BANK_RANGE);
        if j < UNIT_MAX {
            let w: u16 = unit_stats[units[j].kind as u16].width;
            struct_turret_fire(i, units[j].x_px + (w >> 1), (GROUND_Y - 8) << 8);
        }
    }
    structs[i].t = BANK_RATE;
}

// struct_bank_rob - an infantryman of the other side at a bank takes
// half its purse with him.
fn struct_bank_rob(i: u16) {
    let x: u16 = structs[i].x;
    for j in 0..UNIT_MAX {
        if units[j].kind as u8 == UnitType::Infantry as u8 {
            if units[j].owner != structs[i].owner {
                let ux: u16 = units[j].x_px;
                if ux + UNIT_MAN_W > x + 8 {
                    if ux < x + BANK_W - 8 {
                        if structs[i].owner == SIDE_PLAYER { funds = funds >> 1; } else { cpu_funds = cpu_funds >> 1; }
                        unit_free(j);
                        return;
                    }
                }
            }
        }
    }
}

fn struct_bank_hit(i: u16) {
    if structs[i].hp > BANK_DMG_SHELL {
        structs[i].hp = structs[i].hp - BANK_DMG_SHELL;
    } else {
        structs[i].hp = 0;
    }
}

// ------------------------------------------------------------ palettes ---
// Boot-only, so it lives in bank 2 - bank 0 is full, and a JSL once at
// power-on costs nothing.
#[bank(2)]

// struct_palettes - the recoloured OBJ palettes: 1 and 2 from the sheet's
// own, 4 from the airframe sheet's. A sheet carries one palette; the
// enemy's is that with its greens turned red-brown, and nobody's with
// them turned grey. The two sheets share these colours - an enemy tank
// and an enemy airframe are the same red-brown - which is why one
// function builds both rather than each sheet tinting its own. Runs in
// force blank, after both sheets' palettes are loaded.
#[lowram] static mut obj_pal_copy: [u8; 32];

// *src* is the sheet's own palette, in ROM.
fn struct_palette_variant(src: far *u8, cgram: u16, c2: Color, c3: Color, c7: Color, c8: Color) {
    for i in 0..32 {
        obj_pal_copy[i] = src[i];
    }
    obj_pal_copy[4] = c2.0 as u8;   obj_pal_copy[5] = (c2.0 >> 8) as u8;
    obj_pal_copy[6] = c3.0 as u8;   obj_pal_copy[7] = (c3.0 >> 8) as u8;
    obj_pal_copy[14] = c7.0 as u8;  obj_pal_copy[15] = (c7.0 >> 8) as u8;
    obj_pal_copy[16] = c8.0 as u8;  obj_pal_copy[17] = (c8.0 >> 8) as u8;
    dma_copy_cgram(0, &obj_pal_copy as far *u8, cgram, 32);
}

far fn struct_palettes() {
    struct_palette_variant(&OBJ_PAL as far *u8, CGRAM_OBJ_ENEMY,
                           Color::rgb!(12, 5, 4), Color::rgb!(22, 9, 6),
                           Color::rgb!(10, 4, 3), Color::rgb!(17, 7, 5));
    struct_palette_variant(&OBJ_PAL as far *u8, CGRAM_OBJ_NEUTRAL,
                           Color::rgb!(10, 10, 11), Color::rgb!(17, 17, 18),
                           Color::rgb!(8, 8, 9), Color::rgb!(13, 13, 14));
    // The airframe sheet has only the two greens; 7 and 8 are unused
    // there, and recolouring them costs nothing and keeps one list.
    struct_palette_variant(&HELI_PAL as far *u8, CGRAM_OBJ_HELI_ENEMY,
                           Color::rgb!(12, 5, 4), Color::rgb!(22, 9, 6),
                           Color::rgb!(10, 4, 3), Color::rgb!(17, 7, 5));
}
