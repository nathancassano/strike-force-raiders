// Rotor Raiders - Main entry point
// SNES LoROM. A helicopter tug-of-war descended from Rescue Raiders (1984)
// by way of Armor Alley (1991).

// FastROM: the compiler runs code from the $80-$BF mirror, entered through
// bank-0 vector trampolines that set MEMSEL, so code and ROM tables read at
// 6 master clocks a byte rather than 8 - the stress run's 0.81 ticks a
// vblank became 0.96. It once hung at boot here; no build of this source or
// its history with the current compiler reproduces that.
#[snesrom(name="ROTOR_RAIDERS", fastrom)]

#[stack(0x0100, 0x01FF)]

// Compiler scratch. Reading a struct field through a pointer needs a
// zero-page pointer to index off, and promoted parameters need a home; the
// compiler allocates both from this pool - without one it refuses to spill
// rather than inventing storage. $10-$15 are the pad state in input.r65.
#[zeropage(0x16, register)]
static mut SCRATCH0: u16;
#[zeropage(0x18, register)]
static mut SCRATCH1: u16;
#[zeropage(0x1A, register)]
static mut SCRATCH2: u16;

// Standard libraries
include!("lib/65816.r65")
include!("lib/sneslib.r65")
include!("lib/math.r65")
include!("lib/rand.r65")
include!("lib/Q10.r65")

// Subsystems
include!("assets.r65")
include!("sound.r65")
include!("input.r65")
include!("video.r65")
include!("pad.r65")
include!("struct.r65")
include!("muni.r65")
include!("unit.r65")
include!("para.r65")
include!("order.r65")
include!("cpu.r65")
include!("mission.r65")
include!("hud.r65")
include!("radar.r65")
include!("game.r65")
include!("screen.r65")
include!("intro.r65")
include!("heli.r65")
include!("foe.r65")
include!("fx.r65")
include!("alert.r65")

// Bank 0 - Main code
#[bank(0)]

// Test-harness hook. tests/ drives the ROM with a scripted input movie and
// breaks here to screenshot; play.sh finds this symbol in the .sym file.
// Select is otherwise unused by the game.
// Frame cost probe. Counting missed vblanks is the honest measure and the
// only one available: latching the V-counter needs a *read* of $2137 whose
// value is discarded, and the compiler eliminates unused hardware reads.
// Mesen's cycle counter is no good either - it is blind to memory speed.
//
// The NMI counts real frames and the loop counts ticks it completed. Equal
// means the logic fits in a frame; the loop falling behind is the budget
// being blown, and by exactly the ratio between them.
#[lowram] static mut frames_nmi:  u16;
#[lowram] static mut frames_loop: u16;

fn snapshot_point() {
    asm!("NOP");
}

// The mission a power-on boots: the mission number, with BOOT_DIRECT set
// to skip the front end. The power-on sets the campaign's first, behind its
// title page; the tests boot any mission, front end skipped, by stopping at
// boot_load's entry and writing this before boot_load reads it.
const BOOT_DIRECT: u8 = 0x80;
// The BubbleZap intro runs on a real power-on into the campaign; a test
// that boots the campaign proper sets this beside the mission to skip it,
// so the suite is not ten seconds and an intro's worth of frames longer.
const BOOT_NO_INTRO: u8 = 0x40;
#[lowram] static mut boot_pick: u8;

// Power-on: hardware setup, then hand off to the game loop.
#[entry]
fn init_reset() -> ! {
    snes_init();
    boot_pick = MISSION_START;
    boot_load();
    main();
}

// One-time setup. Runs entirely inside force-blank - but for the intro,
// which has a screen of its own.
fn boot_load() {
    INIDISP = FORCE_BLANK;

    // The sound driver's upload is most of a second. On a power-on into the
    // campaign proper the BubbleZap logo (intro.r65) is up meanwhile, a
    // slice of the upload each frame; anything it leaves - Start skips it -
    // and the whole upload otherwise go here. The logo runs its own Mode 7
    // screen before the game's VRAM goes up, and leaves VRAM to be cleared.
    spc_upload_begin();
    let pick: u8 = boot_pick;
    if (pick & (BOOT_DIRECT | BOOT_NO_INTRO)) == 0 && (pick & 0x3F) < MISSION_COUNT {
        intro_show();
        clear_vram();
    }
    spc_upload_finish();
    spc_global_volume(127, 255);
    spc_stereo(1);              // effects are panned by where they are on screen

    video_load();

    // Sky. Written after the palette DMA, which overwrites CGRAM 0.
    set_backdrop!(Color::rgb!(7, 19, 29));   // #3d9aec, the clouds' sky (sky.tilemap.bmp entry 0)
    radar_palette();
    screen_font();

    pad_init();
    Player::reset();
    muni_init();
    fx_init();
    unit_init();
    para_init();
    // The mission comes first: struct_init lays out what it placed, and
    // every init below reads what it set.
    let m: u8 = pick & ~(BOOT_DIRECT | BOOT_NO_INTRO);
    mission_set(m);
    struct_init();
    econ_init();
    order_init();
    cpu_init();
    Pilot::reset();
    hud_init();
    radar_init();
    game_init();
    __rand_seed = 0xDEAD;   // must be non-zero; re-seeded from frame count later

    screen_init();
    // The campaign opens on its title page; a test mission has no
    // front end and boots straight into its battle, so a test never has
    // to press its way past one. BOOT_DIRECT is the third way in: the
    // campaign's first mission with no front end - the world the suite's
    // oldest cases were written against, before there was anything to
    // press past.
    if m < MISSION_COUNT && (pick & BOOT_DIRECT) == 0 { screen_show(SCREEN_TITLE); }

    // The probe counts from here: the inits above run for a couple of
    // frames' worth, and the NMI is not on yet to count them, but the
    // wait_nmi! in main catches the first edge either way.
    frames_nmi = 0;
    frames_loop = 0;
    // One write: NMITIMEN is write-only, so enable_nmi!/enable_autojoy!'s
    // read-modify-write ORs into open bus and can lose the other's bit.
    set_nmitimen!(Interrupt::Nmi | Interrupt::AutoJoy);

    INIDISP = 0x0F;
}

// NMI handler - called every VBlank. PPU/DMA traffic goes here.
#[interrupt(nmi)]
fn nmi_handler() {
    clear_nmi!();
    frames_nmi = frames_nmi + 1;
}

// Game loop.
//
// Vblank work first, using the camera position settled at the end of the
// previous frame, then this frame's logic. Keeps the scroll writes and the
// HDMA table consistent with each other.
fn main() -> ! {
    loop {
        wait_nmi!();
        // A front-end page owns BG3 and is the only layer on, so none of
        // the vblank traffic below has anywhere to go - only the rows a
        // typed continue code has changed.
        if game_state == GAME_SCREEN {
            screen_flush();
        } else {
            scroll_update();
            gnd_table_build();
            oam_flush();
            hud_flush();
        }
        if sfx_mask != 0 { sound_flush(); }     // one queued effect; again before the draw

        pad_read_ports();
        let held: u16 = pad_poll();
        let trig: u16 = pad_poll_trigger();

        if game_state == GAME_PLAYING {
            // Start pauses: this frame runs no tick (game_pause).
            if (trig & JOY_START) != 0 {
                game_pause();
            } else {
                // Holding L is the order overlay: the d-pad walks the ring and
                // A buys, and neither reaches the airframe while it is down.
                let mut fly_held: u16 = held;
                let mut fly_trig: u16 = trig;
                if (held & JOY_L) != 0 {
                    fly_held = held & ~(JOY_UP | JOY_DOWN | JOY_LEFT | JOY_RIGHT);
                    fly_trig = trig & ~JOY_A;
                }
                Player::update(fly_held);
                Player::fire(fly_held, fly_trig);
                Pilot::update();
                econ_tick();
                order_input(held, trig);
                order_tick();
                cpu_tick();
                hud_update();
                let mut want: u8 = 0;
                if (held & JOY_L) != 0 { want = 1; }
                hud_overlay(want);
                muni_update();
                if fx_live != 0 { fx_update(); }    // gated here: two idle far calls a frame cost the budget 10 ticks
                unit_update();
                para_update();
                struct_update();
                // Buildings before units: a bomb's blast is spent by
                // unit_collide, and the building under it must see it first.
                struct_collide();
                unit_collide();
                Player::collide();
                Pilot::collide();
                camera_update();
                radar_update();
            }
        } else {
            if game_state == GAME_SCREEN {
                screen_tick(held, trig);
            } else if game_state == GAME_PAUSED {
                game_pause_tick(trig);
            } else {
                // The match is over: everything holds where it stands
                // until Start goes on.
                if (trig & JOY_START) != 0 { game_continue(); }
            }
        }

        if sfx_mask != 0 { sound_flush(); }     // what this tick queued, up to one more

        // Draw order is the OAM drop policy: airframe, munitions in flight,
        // buildings, then ground units from the camera centre outward.
        if game_state != GAME_SCREEN {
            oam_begin();
            airframes[HELI].draw();
            airframes[FOE].draw();
            radar_draw();
            if alert_up != 0 { alert_draw(); }
            muni_draw();
            if fx_live != 0 { fx_draw(); }
            para_draw();
            struct_draw();
            pad_draw();
            unit_draw();
            oam_end();
        }
        frames_loop = frames_loop + 1;

        if (trig & JOY_SELECT) != 0 {
            snapshot_point();
        }
    }
}
