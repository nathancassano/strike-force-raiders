// video - Mode 1 three-layer background, HDMA parallax, and camera.
//
// Layer plan (see the plan's Graphics architecture section):
//   BG1  ground, 4bpp    per-scanline HDMA, eight bands     (in front of BG2)
//   BG2  sky, 4bpp       clouds camera_x >> 5 above SKY_SPLIT, mountains
//                        camera_x >> 3 below it - one HDMA split
//   BG3  HUD, 2bpp       does not scroll; BGMODE's BG3 bit and the tiles'
//                        priority bit put it over everything
// Every layer is a repeating 512px pattern that wraps in hardware, so there
// is no column refill anywhere in this game.

#[bank(0)]

// ---------------------------------------------------------------- VRAM ----
// Word addresses. 4bpp tiles are 16 words each, 2bpp 8; a 64x32 tilemap is
// 0x800 words (two 32x32 screens), a 32x32 map is 0x400.
// Each layer carries its own tileset: r65x de-duplicates per bitmap, so the
// tile numbering in one layer's tilemap means nothing in another's.
// BG12NBA/BG34NBA address these in 4K-word units. BG2 holds two sheets -
// the clouds' tiles, then the mountains' straight after (MOUNTAINS_CHR at
// VRAM_SKYC + SKY_CHR_SIZE / 2) - and outgrows one unit, so it runs on to
// $3FFF, and the HUD's tiles go in the 2K words Mode 1 left free between
// the sky's map and the HUD's - a 4K-word boundary, so BG3 can start there.
// The Makefile stops the build if the two sheets outgrow $1000-$3FFF.
const VRAM_GROUNDC: u16 = 0x0000;   // BG1
const VRAM_SKYC:    u16 = 0x1000;   // BG2, to $3FFF: 768 tiles
const VRAM_HUDC:    u16 = 0x7000;   // BG3, to $77FF: 256 2bpp tiles
const VRAM_GROUND:  u16 = 0x6000;   // 0x18 in $400-word units
const VRAM_SKY:     u16 = 0x6800;   // 0x1A
const VRAM_HUD:     u16 = 0x7800;   // 0x1E

// CGRAM. BG1 and BG2 draw 16-colour palettes from CGRAM 0-127, and BG3's
// eight 4-colour ones are the first 32 of those - the HUD's, at 0 as it
// always was (CGRAM 0 is also the backdrop: the sky). So the 4bpp sheets
// start at palette 2, one palette each. The Makefile names these same
// palettes in each map (tools/tilemap_attr.py --pal): change one, change
// both. Palettes 5-7 are free.
const CGRAM_GROUND:    u16 = 32;    // palette 2
const CGRAM_SKY:       u16 = 48;    // palette 3: the clouds
const CGRAM_MOUNTAINS: u16 = 64;    // palette 4

// -------------------------------------------------------------- sprites ---
// OBJ tiles sit at word $4000, clear of the BG tileset at $0000 and the four
// tilemaps at $6000-$7FFF. OBSEL's base field counts 8K-word units.
const VRAM_OBJ:  u16 = 0x4000;
// The second OBJ name block - tiles 256-511, which is where the
// airframe's own sheet goes (heli.r65 HELI_PAGE), and the explosions'
// straight after it (fx.r65, FX_TILE0 = the airframe sheet's tile count),
// then the alert avatar's (alert.r65 ALERT_TILE0). The three fill the
// block's 256 tiles exactly: past it they would overwrite BG1's map.
// OBSEL's name-select field of 0 puts it one 4K-word block past the base.
const VRAM_OBJ2: u16 = 0x5000;
const OBJ_BASE:  u8  = 2;                 // 0x4000 / 0x2000

// 128 sprites plus the 32-byte extended table.
#[lowram] static mut oam: OamBuffer;

// ------------------------------------------------------- OAM allocation ---
// Slots are handed out in importance order, not owned statically by each
// subsystem. The PPU evaluates sprites starting at index 0 and drops the
// ones it reaches last, so slot order *is* the drop policy: helicopter,
// then munitions in flight, then buildings, then ground units nearest the
// camera. A pool index says nothing about what matters this frame, so the
// draw order decides and everything left over is parked.
const OAM_SLOTS: u16 = 128;

#[lowram] static mut oam_next: u8;

fn oam_begin() {
    oam_next = 0;
}

// oam_take - claim the next slot, or OAM_SLOTS when the table is full.
// A caller that gets OAM_SLOTS draws nothing, which is the graceful end of
// the importance order rather than a wrap that would corrupt the sprite 0.
fn oam_take() -> u16 {
    let slot: u16 = oam_next as u16;
    if slot < OAM_SLOTS {
        oam_next = oam_next + 1;
    }
    return slot;
}

// oam_end - park the slots the frame did not claim. Without this a sprite
// that stopped being drawn stays frozen wherever it last was. Only a slot
// claimed *last* frame can hold one, so the sweep stops at last frame's
// high-water mark rather than at 128 - which at a hundred idle slots was
// a fifth of the frame.
#[lowram] static mut oam_high: u8;

fn oam_end() {
    let mut i: u16 = oam_next as u16;
    let top: u16 = oam_high as u16;
    while i < top {
        oam.hide!(i as u8);
        i = i + 1;
    }
    oam_high = oam_next;
}

// oam_flush - push the shadow buffer to the PPU. Vblank only. Not
// dma_copy_oam_const!, which writes OAMADDH = 0 over the rotation bit.
far fn oam_flush() {
    OAMADDL = 0;
    // Bit 7 enables priority rotation: the sprite evaluation start point
    // moves each frame, so a scanline that overflows flickers between the
    // sprites competing for it instead of always dropping the same ones.
    OAMADDH = 0x80;
    DMAP7 = 0x00;                  // 1 register, 1 write per transfer
    BBAD7 = 0x04;                  // $2104 OAMDATA
    dma_set_src!(7, oam);
    DAS7 = 544;                    // 128 * 4 + 32
    dma_trigger!(7);
}

// ---------------------------------------------------------------- world ---
// Sides. A unit marches toward the opposing bank: the player east, the
// enemy west. Declared here because munitions, units and the airframe all
// need them and none of those owns the concept.
const SIDE_PLAYER: u8 = 0;
const SIDE_ENEMY:  u8 = 1;

// Armor Alley's field, at its original width rather than the halved one the
// plan first specified. Our sprites are smaller than AA's, so 8192 px is a
// larger field in helicopter-lengths than the original and a traverse takes
// about 27 s at 5 px/frame against AA's ~11 s.
//
// It also sets the scale any future radar strip has to work at: 8192 px of
// world across a 256 px HUD is 32 world pixels per HUD pixel.
const WORLD_W:   u16 = 8192;              // 32 screens
const CAM_MAX:   u16 = 8192 - 256;        // left edge upper bound
const CAM_MID:   u16 = 128;               // half a screen
const CAM_DEAD:  u16 = 8;                 // deadzone half-width, px
const CAM_STEP:  u16 = 6;                 // max catch-up px/frame; must exceed
                                          // the tracked object's top speed or
                                          // the camera falls behind for good

#[lowram] static mut camera_x: u16;       // left edge of the view, 0..CAM_MAX
#[lowram] static mut focus_x: u16;        // what the camera follows

// ------------------------------------------------------- ground parallax ---
// Eight bands over the dirt, GND_TOP down. The band artwork lives in BG1's
// tilemap from row GND_TOP (tools/ground_texture.py); the two must cover the
// same scanlines. Band k scrolls at
// (1 + k/2^SHIFT) x camera_x, built by one shift and seven adds - no
// multiplies. Raising SHIFT narrows the spread and shrinks the seam between
// adjacent bands; lowering it exaggerates the depth.
const GND_SHIFT: u8  = 3;                 // 1.000x .. 1.875x across the band
// The ground line, in screen pixels: where every unit and building stands.
// Everything that can hit the ground measures against this: the airframe's
// floor, and every munition's collision test. It sits GROUND_Y - GND_TOP px
// into the dirt, so what stands on it overlaps the dirt's top edge.
const GROUND_Y:  u16 = 184;
// The first scanline of dirt - the top of the HDMA bands. The mountains'
// tree line (BG2) ends on the scanline above it.
const GND_TOP:   u16 = 179;

// An HDMA line count maxes out at 127, so the run above the ground needs two
// entries.
const GND_TOP_A: u8  = 127;               // scanlines above the dirt, part 1
const GND_TOP_B: u8  = 52;                // ... part 2 (127+52 = GND_TOP)
const GND_BAND:  u8  = 5;                 // scanlines per band (8 x 5 = 40);
                                          // the last band's value holds to
                                          // 224, under the HUD's bottom row

// HDMA table: [count, lo, hi] per entry, 0 terminates.
// 2 entries above the ground + 8 bands + terminator = 31 bytes.
#[lowram] static mut GND_HDMA: [u8; 32];

// gnd_table_init - write the scanline counts once. Only the scroll values
// change per frame.
far fn gnd_table_init() {
    GND_HDMA[0] = GND_TOP_A;
    GND_HDMA[3] = GND_TOP_B;
    let mut off: u16 = 6;
    for i in 0..8 {
        GND_HDMA[off] = GND_BAND;
        off = off + 3;
    }
    GND_HDMA[30] = 0;      // terminator
}

// gnd_table_build - refresh the eight scroll values. Call in vblank, before
// rendering reads the table.
far fn gnd_table_build() {
    let cx: u16 = camera_x;
    let d: u16 = cx >> GND_SHIFT;
    let mut v: u16 = cx;

    // Both entries above the ground carry band 0's value; BG1's tilemap is
    // empty up there, so it only has to be defined, not correct.
    GND_HDMA[1] = v as u8;
    GND_HDMA[2] = (v >> 8) as u8;
    GND_HDMA[4] = v as u8;
    GND_HDMA[5] = (v >> 8) as u8;

    let mut off: u16 = 7;
    for i in 0..8 {
        GND_HDMA[off] = v as u8;
        GND_HDMA[off + 1] = (v >> 8) as u8;
        v = v + d;
        off = off + 3;
    }
}

// ---------------------------------------------------------- sky parallax ---
// BG2 holds two things at two depths that never share a scanline: the
// clouds (rows 16-91) and the mountains (135-178). The clouds are the
// farthest thing in the scene, a quarter of the mountains' rate: across the
// whole 8192 px world they drift 256 px, half their 512 px loop. One HDMA
// split gives each its own scroll, so they fit on one layer: the clouds' value at line
// 0, the mountains' at SKY_SPLIT, and the table ends there - the register
// holds the last value written, and an HDMA channel costs CPU time on
// every scanline until its table ends. Run to the foot of the screen it
// cost the unit_budget stress 29 ticks a minute; ended at the split, 15.
const SKY_SPLIT: u8 = 104;                // first scanline at the mountains' rate

// They are two sheets, sky.tilemap.bmp and mountains.tilemap.bmp, and BG2
// has one map: the clouds' map goes up whole, then the mountains' tile rows
// - the only rows they draw in - over it, in both 32x32 screens. The
// mountains' map already names their tiles past the clouds' (the Makefile's
// tilemap_attr.py --tile-offset). tools/sky_art.py checks both bands sit
// where these say.
const MOUNTAIN_ROW:  u16 = 16;            // tile rows 16-22, scanlines 128-183
const MOUNTAIN_ROWS: u16 = 7;
const MOUNTAIN_AT0:  u16 = MOUNTAIN_ROW << 5;            // map word, screen 0
const MOUNTAIN_AT1:  u16 = 0x400 + (MOUNTAIN_ROW << 5);  // ... and screen 1
const MOUNTAIN_BYTES: u16 = MOUNTAIN_ROWS << 6;

// [count, lo, hi] x 2 + terminator.
#[lowram] static mut SKY_HDMA: [u8; 8];

// gnd_hdma_init - point channel 6 at the ground's band table and channel 5
// at the sky's split. Transfer mode 2 = two bytes written to one register,
// which is what the write-twice scroll registers need.
far fn gnd_hdma_init() {
    DMAP6 = 0x02;
    BBAD6 = 0x0D;                  // $210D BG1HOFS ($2113 is BG4HOFS)
    dma_set_src!(6, GND_HDMA);

    SKY_HDMA[0] = SKY_SPLIT;
    SKY_HDMA[3] = 1;               // one line: written once, then held
    SKY_HDMA[6] = 0;               // terminator
    DMAP5 = 0x02;
    BBAD5 = 0x0F;                  // $210F BG2HOFS
    dma_set_src!(5, SKY_HDMA);

    dma_set_hdma!(0x60);           // channels 5 and 6 - HDMAEN takes both at once
}

// ---------------------------------------------------------------- setup ---
// video_load - one-time PPU setup. Must run inside force blank.
far fn video_load() {
    video_upload();                 // palettes, tiles, maps and layer registers

    camera_x = 0;
    focus_x = CAM_MID;

    gnd_table_init();
    gnd_table_build();
    gnd_hdma_init();
    scroll_update();

    // Small sprites are 8x8 (munitions later), large are 16x16 (the units).
    set_obj_sel!(ObjSize::T8x8_16x16, OBJ_BASE, 0);
    oam.clear();                    // every slot parked, so nothing to sweep
    oam_high = 0;

    set_main_layers!(Screen::BG1 | Screen::BG2 | Screen::BG3 | Screen::Obj);
}

// --------------------------------------------------------------- camera ---
// camera_update - window follow. The camera holds still until the focus
// point leaves a CAM_DEAD window around screen centre, then closes just far
// enough to put it back on the window edge, capped at CAM_STEP per frame.
// Because the step scales with the error rather than being a fixed 1-2px,
// the camera tracks anything moving slower than CAM_STEP without drifting.
far fn camera_update() {
    let centre: u16 = camera_x + CAM_MID;
    if focus_x > centre {
        let d: u16 = focus_x - centre;
        if d > CAM_DEAD {
            let mut step: u16 = d - CAM_DEAD;
            if step > CAM_STEP { step = CAM_STEP; }
            camera_x = camera_x + step;
            if camera_x > CAM_MAX { camera_x = CAM_MAX; }
        }
    } else {
        let d: u16 = centre - focus_x;
        if d > CAM_DEAD {
            let mut step: u16 = d - CAM_DEAD;
            if step > CAM_STEP { step = CAM_STEP; }
            if camera_x <= step {
                camera_x = 0;
            } else {
                camera_x = camera_x - step;
            }
        }
    }
}

// camera_pan - close on the focus at a set pace, ignoring the deadzone.
// CAM_STEP is sized for following the airframe; a lost one wants the view
// home before the next appears, so the caller picks the pace and this
// puts the focus dead centre rather than on the window edge.
far fn camera_pan(step: u16) {
    let mut target: u16 = 0;
    if focus_x > CAM_MID { target = focus_x - CAM_MID; }
    if target > CAM_MAX { target = CAM_MAX; }
    if camera_x > target {
        let d: u16 = camera_x - target;
        if d > step { camera_x = camera_x - step; } else { camera_x = target; }
    } else {
        let d: u16 = target - camera_x;
        if d > step { camera_x = camera_x + step; } else { camera_x = target; }
    }
}

// focus_move - nudge the followed point, clamped to the world.
// Stands in for the helicopter until phase 3.
far fn focus_move(dx: i16) {
    let f: i16 = (focus_x as i16) + dx;
    if f < 0 {
        focus_x = 0;
    } else {
        focus_x = f as u16;
        if focus_x > WORLD_W { focus_x = WORLD_W; }
    }
}

// scroll_update - this frame's sky scroll: the clouds' and the mountains'
// values into the split HDMA table. Call in vblank. BG1 is driven by the
// ground's band table (gnd_table_build), and BG3 does not scroll.
far fn scroll_update() {
    let c: u16 = camera_x >> 5;          // a quarter of the mountains'
    let m: u16 = camera_x >> 3;
    SKY_HDMA[1] = c as u8;
    SKY_HDMA[2] = (c >> 8) as u8;
    SKY_HDMA[4] = m as u8;
    SKY_HDMA[5] = (m >> 8) as u8;
}

// ------------------------------------------------------------- uploads ---
// The asset half of video_load, in bank 2 with the other boot-only code:
// it runs once, in force blank, and bank 0 is full. Everything it calls
// is far (the DMA helpers, struct_palettes) or a register write.
#[bank(2)]

// video_extras - the uploads that came after video_load at boot: the sky's
// backdrop colour (written after the palette DMA, which overwrites CGRAM
// 0), the radar's palette, the order menu's icons and the front end's font.
far fn video_extras() {
    set_backdrop!(Color::rgb!(7, 19, 29));   // #3d9aec, the clouds' sky (sky.tilemap.bmp entry 0)
    radar_palette();
    hud_icons_load();
    screen_font_load();
}

// video_restore - the field's art back after the title page, which loads
// its Mode 3 picture over VRAM and CGRAM and switches HDMA off. Force
// blank. Everything the boot uploaded, and Mode 1's registers; the maps
// the game writes at runtime (the strip, the radar) are recomposed when
// the battle comes back (screen_hide).
far fn video_restore() {
    video_upload();
    video_extras();
    gnd_hdma_init();
}

far fn video_upload() {
    // The HUD's palette at 0 (BG3's, and the backdrop), the 4bpp sheets
    // above it - see CGRAM_SKY.
    dma_copy_cgram(0, &HUD_PAL as far *u8, 0, HUD_PAL_SIZE);
    dma_copy_cgram(0, &GROUND_PAL as far *u8, CGRAM_GROUND, GROUND_PAL_SIZE);
    dma_copy_cgram(0, &SKY_PAL as far *u8, CGRAM_SKY, SKY_PAL_SIZE);
    dma_copy_cgram(0, &MOUNTAINS_PAL as far *u8, CGRAM_MOUNTAINS, MOUNTAINS_PAL_SIZE);
    dma_copy_cgram(0, &OBJ_PAL as far *u8, 128, OBJ_PAL_SIZE);
    dma_copy_cgram(0, &HELI_PAL as far *u8, CGRAM_OBJ_HELI, HELI_PAL_SIZE);
    dma_copy_cgram(0, &FX_PAL as far *u8, CGRAM_OBJ_FX, FX_PAL_SIZE);
    dma_copy_cgram(0, &AVATAR_PAL as far *u8, CGRAM_OBJ_ALERT, AVATAR_PAL_SIZE);
    struct_palettes();              // the recoloured variants of both

    dma_copy_vram(0, &GROUND_CHR as far *u8, VRAM_GROUNDC, GROUND_CHR_SIZE);
    dma_copy_vram(0, &SKY_CHR as far *u8, VRAM_SKYC, SKY_CHR_SIZE);
    dma_copy_vram(0, &MOUNTAINS_CHR as far *u8, VRAM_SKYC + (SKY_CHR_SIZE >> 1),
                  MOUNTAINS_CHR_SIZE);
    dma_copy_vram(0, &HUD_CHR as far *u8, VRAM_HUDC, HUD_CHR_SIZE);
    dma_copy_vram(0, &GROUND_MAP as far *u8, VRAM_GROUND, GROUND_MAP_SIZE);
    dma_copy_vram(0, &SKY_MAP as far *u8, VRAM_SKY, SKY_MAP_SIZE);
    dma_copy_vram(0, &MOUNTAINS_MAP[MOUNTAIN_AT0 << 1] as far *u8, VRAM_SKY + MOUNTAIN_AT0,
                  MOUNTAIN_BYTES);
    dma_copy_vram(0, &MOUNTAINS_MAP[MOUNTAIN_AT1 << 1] as far *u8, VRAM_SKY + MOUNTAIN_AT1,
                  MOUNTAIN_BYTES);
    dma_copy_vram(0, &HUD_MAP as far *u8, VRAM_HUD, HUD_MAP_SIZE);
    dma_copy_vram(0, &OBJ_CHR as far *u8, VRAM_OBJ, OBJ_CHR_SIZE);
    dma_copy_vram(0, &HELI_CHR as far *u8, VRAM_OBJ2, HELI_CHR_SIZE);
    dma_copy_vram(0, &FX_CHR as far *u8, VRAM_OBJ2 + (HELI_CHR_SIZE >> 1), FX_CHR_SIZE);
    dma_copy_vram(0, &AVATAR_CHR as far *u8, VRAM_OBJ2 + (ALERT_TILE0 << 4), AVATAR_CHR_SIZE);

    // Mode 1, 8x8 tiles, and bit 3: BG3's priority-1 tiles draw in front
    // of everything, sprites included - the HUD over the dirt and the sky.
    set_bgmode!(1, 0x08);
    set_bg1_map!(0x18, 1);         // ground, 64x32 - wraps at 512px
    set_bg2_map!(0x1A, 1);         // sky, 64x32
    set_bg3_map!(0x1E, 0);         // HUD, 32x32 - does not scroll
    set_bg12_chr!(0, 1);           // 4K-word units: $0000, $1000
    set_bg34_chr!(7, 0);           // $7000; there is no BG4 in Mode 1

    // Scroll registers show line (v+1), so -1 puts tilemap row 0 at the top.
    set_bg1_vscroll!(0xFFFF);
    set_bg2_vscroll!(0xFFFF);
    set_bg3_vscroll!(0xFFFF);
    set_bg3_hscroll!(0);
}
