// input - Joypad subsystem for Rotor Raiders.
// Reads controller 0 once per frame, provides held and trigger masks.
//
// The word is composed through plain locals: a `let lo @ A = JOY1L;` alias
// would be overwritten by the high byte's load, which the compiler rejects.

#[bank(0)]

#[zeropage(0x10)]
static mut PAD_STATE: u16;   // current held buttons (active-high mask)

#[zeropage(0x12)]
static mut PAD_PREV: u16;    // previous frame's mask, Start's bit inverted

#[zeropage(0x14)]
static mut PAD_TRIG: u16;    // edges this tick: new presses, and Start let go

// pad_read_ports - read controller 0 and derive the edge mask.
// Call once per game tick.
//
// Every button triggers as it goes down but Start, which triggers as it
// comes up: nothing acts on Start until it is released. The edge test runs
// on the mask with Start's bit inverted, where letting go of Start reads
// as pressing it; PAD_PREV keeps that inverted mask, so the release costs
// one EOR over a plain rising edge (the stress run sits on the budget
// line, and a dearer version of this cost it a tick).
far fn pad_read_ports() {
    wait_autojoy!();
    PAD_STATE = ((JOY1H as u16) << 8) | (JOY1L as u16);
    let flip: u16 = PAD_STATE ^ JOY_START;
    PAD_TRIG = (flip ^ PAD_PREV) & flip;
    PAD_PREV = flip;
}

// pad_poll - continuous held mask.
far fn pad_poll() -> u16 {
    return PAD_STATE;
}

// pad_poll_trigger - edge mask for this tick: presses, and Start's release.
far fn pad_poll_trigger() -> u16 {
    return PAD_TRIG;
}

// pad_init - zero the pad state, which holds power-on garbage until this runs.
far fn pad_init() {
    PAD_STATE = 0;
    PAD_PREV = JOY_START;     // nothing held, inverted: Start up
    PAD_TRIG = 0;
}
