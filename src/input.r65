// input - Joypad subsystem for Rotor Raiders.
// Reads controller 0 once per frame, provides held and trigger masks.
//
// NOTE: deliberately avoids the `let lo @ A = ...; let hi @ B = ...;` idiom
// used by astroids/src/input.r65. That miscompiles: an `@ A` alias is not
// preserved when a later expression loads A, and the compiler emits no
// diagnostic. This is the composition form classickong.r65 ships with.

#[bank(0)]

// The serial joypad ports. The stdlib exposes the auto-read results
// ($4218..) but not these, and boot needs them - see pad_read_manual.
#[hw(0x4016)]
static mut JOYSER0: u8;                   // write: latch; read: controller 1, bit 0

#[zeropage(0x10)]
static mut PAD_STATE: u16;   // current held buttons (active-high mask)

#[zeropage(0x12)]
static mut PAD_PREV: u16;    // previous frame's mask

#[zeropage(0x14)]
static mut PAD_TRIG: u16;    // rising edge (new presses this tick)

// pad_read_ports - read controller 0 and derive the edge mask.
// Call once per game tick.
far fn pad_read_ports() {
    wait_autojoy!();
    let current: u16 = ((JOY1H as u16) << 8) | (JOY1L as u16);
    let prev: u16 = PAD_PREV;
    PAD_STATE = current;
    PAD_PREV = current;
    PAD_TRIG = (current ^ prev) & current;
}

// pad_poll - continuous held mask.
far fn pad_poll() -> u16 {
    return PAD_STATE;
}

// pad_poll_trigger - rising-edge mask for this tick.
far fn pad_poll_trigger() -> u16 {
    return PAD_TRIG;
}

// pad_read_manual - controller 1's held mask, read by hand rather than by
// the hardware's auto-read. Boot needs it: the auto-read wants a frame and
// an NMI, and the mission the harness selects has to be chosen before
// anything initialises, or every timing downstream of it moves.
//
// The standard 65816 sequence: strobe $4016 to latch, then clock sixteen
// bits out of its bit 0, most significant first - B Y Select Start Up Down
// Left Right A X L R and four unused. The result is the same mask
// pad_read_ports builds, so JOY_* apply.
far fn pad_read_manual() -> u16 {
    let mut v: u16 = 0;
    JOYSER0 = 1;                          // latch
    JOYSER0 = 0;
    for i in 0..16 {
        let bit: u8 = JOYSER0 & 0x01;
        v = (v << 1) | (bit as u16);
    }
    return v;
}

// pad_init - zero the pad state. Zero-page statics are declared bare (an
// initializer on a mutable static trips the __init_start MVN/DBR bug), so
// they hold power-on garbage until this runs.
far fn pad_init() {
    PAD_STATE = 0;
    PAD_PREV = 0;
    PAD_TRIG = 0;
}
