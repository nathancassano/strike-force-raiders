// heli - the airframes, both sides': 8.8 physics, cosmetic tilt, camera-
// relative rendering and the wreck (impl Airframe, over the #[soa] pool
// airframes, HELI the player's and FOE the enemy's), and the player's own
// stick, gun, airlift and losses (impl Player). The enemy's pilot is foe.r65.
//
// The shared methods take the element as `self`, in X. The per-frame ones
// (fly, burn, turn_step, draw) are #[inline(always)]: every call names its
// element with a constant, and R65's const_index pass folds the inlined
// body's `POOL__f,X` to `POOL__f` - so one copy of the code compiles to
// what two hand-written per-side copies did, with no call left.
//
// Types follow the plan's Position representation section:
//   x   world pixel + 1/256 fraction, because a 4096 px world fits in no
//       16-bit fixed type (Q8 caps at 255.996, Q10 at +/-511)
//   y   plain u16 holding 8.8 screen pixels - 0..224 fits the integer byte
//   v   Q10 (signed 10.6): velocity has to go negative, and a 5 px/frame cap
//       still leaves 320 steps of resolution
//
// Q10 is 1/64 and the position fraction is 1/256, so a per-frame delta is
// `v.0 << 2`. Q10::mul/div are never called - integration is only +, - and
// compare, which the newtype inherits from i16.

#[bank(0)]

// ------------------------------------------------------------- geometry ---
const HELI_W:     u16 = 32;               // two 16x16 OBJ cells
const HELI_H:     u16 = 16;

// Vertical limits in 8.8. The HUD strip owns the top two tile rows, and the
// ground line is GROUND_Y, so the airframe has to stop 16 px short of it.
const HELI_Y_MIN: u16 = 16 << 8;
const HELI_Y_MAX: u16 = (GROUND_Y - HELI_H) << 8;

// ------------------------------------------------------------- handling ---
// Armor Alley's mouse-seeking becomes d-pad acceleration toward a target
// velocity: the stick picks a speed, the airframe takes a few frames to reach
// it. No gravity while powered - that only arrives with fuel-out and ejection.
const HELI_VX_MAX: Q10 = 5 * 64;          // 5 px/frame, the plan's cap
const HELI_VY_MAX: Q10 = 4 * 64;          // ~4 px/frame
// Inertia. Thrust is how fast the stick builds speed; drag is how fast
// speed bleeds off with the stick released - slower, so the airframe
// coasts and overshoots rather than stopping where the thumb does.
// Horizontal: 20 frames to top speed, ~40 to coast down from it (~100 px).
// Vertical builds more gently - climbing and diving should read as the
// airframe leaning into it - and bleeds off a little faster than it
// builds, since the ground and the ceiling are near.
const HELI_THRUST_X: Q10 = 16;            // 0.25 px/frame^2
const HELI_DRAG_X:   Q10 = 8;             // 0.125
const HELI_THRUST_Y: Q10 = 6;            // 0.19: ~21 frames to top climb
const HELI_DRAG_Y:   Q10 = 8;
const HELI_ACC:      Q10 = 16;            // dead-stick horizontal decay
// The stick picks the forward lean, not the speed (Airframe::lean): `tilt`
// counts up HELI_LEAN_RISE a frame while the direction along the nose is
// held and back down one a frame while it is not, so the nose dips 2
// frames into a push and is fully down at 10, and lets go the frame the
// stick does - one frame off full it is the dip again - but comes back
// more slowly than it went, level 16 frames later, however fast the
// airframe is still coasting. Nose up stays the speed's: sliding backward
// faster than HELI_TILT_ON, as it does coming out of a turn.
const HELI_LEAN_RISE: u8 = 2;             // tilt a frame pushing; letting go is 1
const HELI_LEAN_DIP:  u8 = 2 * 2;         // tilt from here: the nose dips (2 frames in)
const HELI_LEAN_FULL: u8 = 10 * 2;        // and from here: nose down (10 in; tilt's cap)
const HELI_TILT_ON:   Q10 = 96;           // 1.5 px/frame backward: nose up

// Tilt frames in the OBJ sheet. A 16x16 sprite at tile t covers t, t+1,
// t+16, t+17, so a 32x16 frame is two cells four tiles apart.
// Named for the nose, not for a screen direction. The frames are drawn
// nose-right and facing-left renders them hflipped, so a screen-relative
// name invites picking the mirrored frame - which is exactly the bug this
// naming replaced.
const HELI_TILE_NOSE_DOWN: u8 = 0;        // assets/src/heli.bmp, frame 0
const HELI_TILE_LEVEL:     u8 = 4;        // ... frame 1
const HELI_TILE_NOSE_UP:   u8 = 8;        // ... frame 2
const HELI_TILE_NOSE_DIP:  u8 = 64;       // ... row 4: the first lean, nose just down
// Turning: five drawings - a slight turn and a three-quarter view facing
// the old way, head-on, then the same two facing the new way - each held
// HELI_TURN_HOLD frames. The turn only advances while the new direction
// is held: let go and it stalls where it is, hold the old direction and
// it swings back. The facing the gun fires along changes when the turn
// completes, not when it starts. The three pieces of art are on the
// sheet's last row (tools/struct_art.py).
const HELI_TILE_TURN_34:     u8 = 32;
const HELI_TILE_TURN_HEAD:   u8 = 36;
const HELI_TILE_TURN_SLIGHT: u8 = 40;
// The wreck, in each row's last four columns: falling out of the air
// after a loss, then down on the ground until the next airframe rises.
const HELI_TILE_CRASHING:    u8 = 12;
const HELI_TILE_CRASHED:     u8 = 44;
const HELI_TURN_HOLD:        u8 = 3;      // frames per drawing
const HELI_TURN_STEPS:       u8 = 5 * 3;  // the whole swing
// The airframe has a sheet of its own (assets/src/heli.bmp, drawn by
// tools/heli_art.py) rather than a corner of obj.bmp: its art and its
// colours are the two airframes' alone, and neither the units nor the
// buildings are disturbed by a change to them. It is loaded into the
// second OBJ name block, so a tile number here is 256 + the sheet's -
// HELI_PAGE is that 9th bit, which rides in the attribute word beside
// the palette and the priority.
const HELI_PAGE: u16 = 0x0100;
const HELI_ATTR: u16 = 0x3000 | HELI_PAGE | OBJ_PAL_HELI;   // priority 3
const HELI_ATTR_RISING: u16 = 0x2000 | HELI_PAGE | OBJ_PAL_HELI;   // 2: see Airframe::draw

// The helicopter is the highest-priority object in the game, so it draws
// first and takes the lowest slots from the shared allocator.

// -------------------------------------------------------------- weapons ---
// The plan's loadout. Ammo is the real bottleneck by design - roughly 21 s to
// refill from empty once the landing pad arrives - so these are not knobs to
// loosen without re-reading the economy section.
const HELI_GUN_MAX:  u8 = 64;
const HELI_BOMB_MAX: u8 = 10;
const HELI_GUN_RATE: u8 = 6;              // frames between rounds while held

// Where a round leaves the airframe: the nose when facing right, the tail
// end of the same box when facing left, and level with the cabin.
const HELI_MUZZLE_Y: u16 = 7;
// Driving forward the nose drops and the gun fires along it: 1 px down for
// every 8 forward, about 7 degrees, so a strafing run walks rounds into the
// ground ahead instead of over everything. While the nose is drawn down at
// all (tilt from HELI_LEAN_DIP), so the rounds follow the stick as it does.
const HELI_GUN_DROP: Q10 = 64;            // 1 px/frame

// ----------------------------------------------------------- fuel & pad ---
// Fuel is a 0-100 gauge; the plan's AI reads "fuel < 30" as its low mark.
// One unit per 64 frames is a little over 100 s of flight.
const HELI_FUEL_MAX:   u8 = 100;
const HELI_FUEL_DRAIN: u8 = 64;           // frames per unit burned aloft
const HELI_FUEL_FILL:  u8 = 4;            // frames per unit on the deck

// Reload rates. These are the gating mechanism, not tuning knobs. The
// plan's rounds came back one per 20 frames, ~22 s from empty; they are
// eight a time now, eight times as fast - ~9 s for 64 - while bombs keep
// the plan's one per 10. The plan calls these "modulus timers"; countdowns
// do the same job without a modulus, which for 20 and 10 would mean a
// mod8 call.
const HELI_GUN_RELOAD:  u8 = 20;
const HELI_GUN_REFILL:  u8 = 8;           // rounds back each time it runs out
const HELI_BOMB_RELOAD: u8 = 10;
// The deck repairs too - the plan's "full rearm", and what the enemy
// pilot's refit rule (health under 5 counts toward a return) assumes.
const HELI_HP_REPAIR:   u8 = 16;          // frames per point

// A dry tank is a forced descent: whatever vertical speed the airframe
// had bleeds toward a steady sink at HELI_GRAVITY a frame (a dive or a
// climb is arrested within a second); left and right still fly it. A deck
// under it saves it - it lands and refuels - and open ground is the loss.
// From hover height that is about two seconds down. Gravity proper is the
// wreck's (wreck_tick).
const HELI_GRAVITY: Q10 = 10;             // ~0.16 px/frame^2
const HELI_SINK:    Q10 = 32;             // 0.5 px/frame: the dry tank's descent


// ---------------------------------------------------------------- state ---
// The two airframes, the player's and the enemy's, are one #[soa] pool:
// what both have is an Airframe, element HELI or FOE. Each side's own code
// names its element with the constant, which compiles to the plain
// absolute address a separate static had; the shared routines are methods
// taking the element as `self`, in X.
const HELI: u16 = 0;                      // the player's airframe
const FOE:  u16 = 1;                      // the enemy's (foe.r65)

#[soa]
struct Airframe {
    x_px:       u16,    // world pixel, 0..WORLD_W-HELI_W
    x_sub:      u8,     // 1/256 px
    y:          u16,    // 8.8 screen pixels
    vx:         Q10,
    vy:         Q10,
    face_left:  u8,     // 0 nose right, 1 nose left
    turn:       u8,     // progress through a turn, 0 = none
    tilt:       u8,     // the forward lean, 0 to HELI_LEAN_FULL (lean)
    hp:         u8,     // the plan's 20; a bomb ends it outright
    hp_t:       u8,     // countdown to the next point repaired
    fuel:       u8,     // 0..HELI_FUEL_MAX
    fuel_t:     u8,     // countdown to the next fuel unit
    gun:        u8,     // rounds remaining
    gun_t:      u8,     // countdown to the next round
    gun_cd:     u8,     // frames until the gun can fire
    bombs:      u8,
    bomb_t:     u8,
    landed:     u8,     // 1 while resting on the ground
    dead:       u8,     // lost while > 0 (the player's: frames of the pan home left)
    rising:     u8,     // 1 while the next airframe climbs out of the ground
    lives:      u8,     // the match's: init leaves them
    wreck_x:    u16,    // where it was lost, its centre: the player's camera holds there
    wreck_y:    u16,    // the wreck's top, 8.8: falls to HELI_Y_MAX
    wreck_vx:   Q10,    // half the way on it had, kept all the way down
    wreck_vy:   Q10,
    wreck_sub:  u8,     // 1/256 px of wreck_x
    wreck_face: u8,
    wreck_spin: u8,     // frames it has fallen: the spin's clock
    wreck_up:   u8,     // 1 while a wreck is falling; 0 none (down, or never)
}
#[lowram] static mut airframes: [Airframe; 2];

// What only the player's airframe has.
#[soa]
struct Player {
    on_pad:   u8,       // landed, and the ground is a deck
    men:      u8,       // aboard (para.r65)
    pause:    u8,       // frames left on the ground before the pan
    cam_step: u16,      // the pan home, px/frame, sized when it starts
}
#[lowram] static mut player: Player;

// Enemy fire against the airframe. Gunfire takes a point; at zero the
// airframe is lost - a life goes (airframes[HELI].lives) and it returns
// to the start with a full load. The battle-over screen is phase 9's.
const HELI_HP_MAX: u8 = 20;
const HELI_DMG_MISSILE: u8 = 10;          // two of a base's missiles end it

// Losing an airframe is not instant. The camera stays on the wreck while
// it falls and goes up on the ground, holds there HELI_GROUND_PAUSE (a
// second) more, then pans back to the start in HELI_PAN, and the next
// airframe appears there once the pan is done. The pan is paced from
// where the camera stands when it starts: distance over HELI_PAN, rounded
// up, so the far end of the world takes all of it and anywhere nearer
// arrives with frames to spare.
const HELI_GROUND_PAUSE: u8 = 60;
const HELI_PAN:          u8 = 72;
// Then it rises out of the ground at the start: from the ground line up
// to hover height at a pixel a frame, drawn behind the ground band until
// it has cleared it, and under nobody's control.
const HELI_Y_HOVER: u16 = 112 << 8;
const HELI_RISE:    u16 = 1 << 8;         // px/frame, 8.8
// An airframe lost a third or more of its flight band off the ground
// gets one man out of the door before it goes. Landed, it is at
// HELI_Y_MAX, under the line, so this is also the "in the air" test.
// Measured off the ground, as a third of the band when it was 16..152
// (45 px, `/ 3` does not fold): every height below the ceiling is ground-relative.
const HELI_Y_BAIL:  u16 = HELI_Y_MAX - (45 << 8);

// ------------------------------------------------------------ Player ---
// The player's airframe: what only it does - the stick, the gun and
// bombs, the airlift, its losses and the camera's pan home. Associated
// functions, not methods: there is one, airframes[HELI] and player, and a
// receiver would pin X that its loops want.
impl Player {
    // Player::init - place the airframe.
    fn init() {
        airframes[HELI].init(64, 0);
        player.on_pad = 0;
        player.men = 0;                         // the men left aboard went with it
        player.pause = 0;
        player.cam_step = 0;
    }

    // Player::reset - a match's start: Player::init, and no wreck.
    fn reset() {
        Player::init();
        airframes[HELI].wreck_up = 0;
    }

    // Player::collide - enemy rounds against the airframe's box, the
    // enemy's barrage balloons, which end it outright, and their chains,
    // which take CHAIN_DMG and snap, and the enemy's ground (unit_ram),
    // which goes with it.
    fn collide() {
        if airframes[HELI].dead > 0 || airframes[HELI].rising != 0 { return; }   // nothing there to hit
        let hx: u16 = airframes[HELI].x_px;
        let hy: u16 = airframes[HELI].y >> 8;
        // Balloons and chains every other frame, the enemy's airframe on the
        // other: an airframe flat out overlaps even a 4 px chain for 7 frames,
        // and the scan at hover height every frame cost the stress run 5 ticks.
        let mut hit: u8 = HIT_NONE;
        if (frames_loop & 1) == 0 { hit = struct_balloon_at(SIDE_PLAYER, hx, hy); }
        if hit == HIT_BALLOON || (hit == HIT_CHAIN && airframes[HELI].hp <= CHAIN_DMG) {
            Player::lost();
            return;
        }
        if hit == HIT_CHAIN { airframes[HELI].hp = airframes[HELI].hp - CHAIN_DMG; }
        if hy > RAM_LOW {
            if unit_ram(SIDE_PLAYER, hx, hy) != 0 {
                Player::lost();
                airframes[HELI].wreck_vx = Q10(0);   // stopped by what it hit
                return;
            }
        }
        // Nothing of another side up - the usual frame - and the pool is not
        // worth walking; muni_up counts the player's and everyone else's.
        if muni_up[1] == 0 { return; }
        for m in 0..MUNI_MAX {
            let mk: u8 = muni_kind[m];
            if mk == MUNI_BULLET || mk == MUNI_MISSILE || mk == MUNI_BOMB {
                // Anything not the player's own: the enemy's, or a
                // hostile-neutral super bunker's.
                if muni_owner[m] != SIDE_PLAYER {
                    let mx: u16 = muni_x_px[m];
                    let my: u16 = muni_y[m] >> 8;
                    if mx >= hx && mx < hx + HELI_W {
                        if my >= hy && my < hy + HELI_H {
                            muni_drop_bomb(m);
                            muni_kind[m] = MUNI_FREE;
                            if mk == MUNI_BOMB {
                                Player::lost();          // a bomb ends it outright
                                return;
                            }
                            let mut dmg: u8 = 1;
                            if mk == MUNI_MISSILE { dmg = HELI_DMG_MISSILE; }
                            if airframes[HELI].hp > dmg {
                                airframes[HELI].hp = airframes[HELI].hp - dmg;
                            } else {
                                Player::lost();
                                return;
                            }
                        }
                    }
                }
            }
        }
    }

    // Player::fire - gunfire while B is held, one bomb per press of A.
    //
    // The gun points where the nose points. Facing follows the last commanded
    // direction rather than the current velocity, so it does not flip back to
    // neutral while the airframe coasts to a stop.
    fn fire(held: u16, trig: u16) {
        if airframes[HELI].dead > 0 || airframes[HELI].rising != 0 { return; }
        if airframes[HELI].gun_cd > 0 {
            airframes[HELI].gun_cd = airframes[HELI].gun_cd - 1;
        }

        if (held & JOY_B) != 0 {
            if airframes[HELI].gun_cd == 0 {
                if airframes[HELI].gun > 0 {
                    airframes[HELI].gun = airframes[HELI].gun - 1;
                    airframes[HELI].gun_cd = HELI_GUN_RATE;
                    let mut mx: u16 = airframes[HELI].x_px + HELI_W;
                    let mut v: Q10 = BULLET_SPEED;
                    if airframes[HELI].face_left != 0 {
                        mx = airframes[HELI].x_px;
                        v = Q10(0) - BULLET_SPEED;
                    }
                    // Nose down: the round leaves at a slight downward angle.
                    let mut vy: Q10 = 0;
                    if airframes[HELI].tilt >= HELI_LEAN_DIP { vy = HELI_GUN_DROP; }
                    muni_spawn(MUNI_BULLET, mx, airframes[HELI].y + (HELI_MUZZLE_Y << 8),
                               v, vy, BULLET_LIFE, SIDE_PLAYER);
                    sfx_at(SFX_CHN_GUN, SFX_PLAYER_GUN1, mx);
                }
            }
        }

        // X: a man out of the door, airborne only - on the deck he would just
        // walk back aboard.
        if (trig & JOY_X) != 0 {
            if player.men > 0 && airframes[HELI].landed == 0 {
                if para_drop(airframes[HELI].x_px + (HELI_W >> 2), airframes[HELI].y, SIDE_PLAYER, 0) != 0 {
                    player.men = player.men - 1;
                }
            }
        }

        if (trig & JOY_A) != 0 {
            if airframes[HELI].bombs > 0 {
                airframes[HELI].bombs = airframes[HELI].bombs - 1;
                // A bomb keeps the airframe's horizontal speed and starts at
                // rest vertically, so a fast pass throws it forward.
                // A bomb has no timer: it lives until it reaches the ground.
                muni_spawn(MUNI_BOMB, airframes[HELI].x_px + (HELI_W >> 1),
                           airframes[HELI].y + (HELI_H << 8), airframes[HELI].vx, Q10(0), 0, SIDE_PLAYER);
            }
        }
    }

    // Player::update - one tick of input, physics and world clamping.
    fn update(held: u16) {
        if airframes[HELI].dead > 0 {
            Player::dead_tick();                 // lost: the stick does nothing
            return;
        }
        // Up, rising or on a deck: the rotor (checked here, not in sfx_rotor,
        // so the three frames in four it is quiet cost no far call).
        if (frames_loop & (ROTOR_EVERY - 1)) == 0 { sfx_rotor(airframes[HELI].x_px + (HELI_W >> 1), airframes[HELI].landed); }
        if airframes[HELI].rising != 0 {
            airframes[HELI].y = airframes[HELI].y - HELI_RISE;
            if airframes[HELI].y <= HELI_Y_HOVER {
                airframes[HELI].y = HELI_Y_HOVER;
                airframes[HELI].rising = 0;
            }
            focus_x = airframes[HELI].x_px + (HELI_W >> 1);
            return;
        }

        if airframes[HELI].landed != 0 {
            // On the ground: no motion. A deck's timers do their work; open
            // ground is only for picking men up. Up lifts off, but only with
            // fuel to lift off on.
            airframes[HELI].vx = Q10(0);
            airframes[HELI].vy = Q10(0);
            airframes[HELI].tilt = 0;
            if player.on_pad != 0 { airframes[HELI].rearm(); }
            para_pickup();
            if (held & JOY_UP) != 0 {
                if airframes[HELI].fuel > 0 { airframes[HELI].landed = 0; }
            }
        } else {
            airframes[HELI].burn();

            let mut tx: Q10 = Q10(0);
            // 2 = no direction held; the turn stalls on that.
            let mut want: u8 = 2;
            if (held & JOY_RIGHT) != 0 { tx = HELI_VX_MAX; want = 0; }
            if (held & JOY_LEFT)  != 0 { tx = Q10(0) - HELI_VX_MAX; want = 1; }
            airframes[HELI].turn_step(want);
            let mut ax: Q10 = HELI_THRUST_X;
            if tx == Q10(0) { ax = HELI_DRAG_X; }
            airframes[HELI].vx = approach(airframes[HELI].vx, tx, ax);

            if airframes[HELI].fuel == 0 {
                // Dead stick: left and right still fly it, but it comes down -
                // a slow forced descent (HELI_SINK) - to the deck, which
                // saves it, or the ground, which does not.
                airframes[HELI].vy = approach(airframes[HELI].vy, HELI_SINK, HELI_GRAVITY);
            } else {
                let mut ty: Q10 = Q10(0);
                if (held & JOY_DOWN) != 0 { ty = HELI_VY_MAX; }
                if (held & JOY_UP)   != 0 { ty = Q10(0) - HELI_VY_MAX; }

                let mut ay: Q10 = HELI_THRUST_Y;
                if ty == Q10(0) { ay = HELI_DRAG_Y; }
                airframes[HELI].vy = approach(airframes[HELI].vy, ty, ay);
            }

            // Whether the airframe is descending, and how fast, has to be read
            // before the move: fly zeroes vy the moment it touches the
            // floor, so asking afterwards would always say no.
            let mut descending: u8 = 0;
            if airframes[HELI].vy > Q10(0) { descending = 1; }
            let vy_in: Q10 = airframes[HELI].vy;

            airframes[HELI].fly();

            // "Land only while descending" - drifting sideways into the ground
            // at zero vertical speed does not count, which is what stops the
            // floor from catching an airframe that is merely skimming it. Open
            // ground takes a powered landing anywhere - that is how men are
            // picked up in the field - and a deck takes any landing; a dead
            // stick that meets open ground is lost. The crash test
            // takes vx after the move (a copy before it cost the stress run 7
            // ticks): at a world edge the move has stopped it, so a dive into
            // the edge lands.
            if airframes[HELI].y == HELI_Y_MAX {
                if airframes[HELI].fuel == 0
                   && pad_at(airframes[HELI].x_px + (HELI_W >> 1)) >= PAD_COUNT {
                    // Out of fuel off a deck, down is the end - but the men
                    // aboard get out and fight on as infantry.
                    if player.men > 0 {
                        para_disembark(airframes[HELI].x_px + ((HELI_W - UNIT_MAN_W) >> 1),
                                       SIDE_PLAYER, player.men);
                        player.men = 0;
                    }
                    Player::lost();
                    return;
                }
                if Airframe::crashes(airframes[HELI].vx, vy_in) != 0 {
                    Player::lost();              // flat out: a crash, deck or not
                    return;
                }
                if descending != 0 {
                    player.on_pad = 0;
                    if pad_at(airframes[HELI].x_px + (HELI_W >> 1)) < PAD_COUNT { player.on_pad = 1; }
                    airframes[HELI].landed = 1;
                }
            }
        }

        // The camera follows the airframe's centre, led by its velocity so
        // the view opens up ahead of it: Armor Alley's lookahead of 0.4 of a
        // half-screen at top speed, taken here as vx/8 - 40 px at 5 px/frame.
        // `>>` is logical, so the sign is a branch. The deadzone in
        // camera_update is what keeps a turn from snapping the view.
        let mut f: u16 = airframes[HELI].x_px + (HELI_W >> 1);
        if airframes[HELI].vx >= Q10(0) {
            f = f + ((airframes[HELI].vx.0 as u16) >> 3);
            if f > WORLD_W { f = WORLD_W; }
        } else {
            let back: u16 = ((0 - airframes[HELI].vx.0) as u16) >> 3;
            if f > back { f = f - back; } else { f = 0; }
        }
        focus_x = f;
    }
}





// approach - step `cur` toward `target` by at most `step`.
// Plain i16 compares; Q10 inherits them from its payload.
far fn approach(cur: Q10, target: Q10, step: Q10) -> Q10 {
    if cur < target {
        let next: Q10 = cur + step;
        if next > target { return target; }
        return next;
    }
    if cur > target {
        let next: Q10 = cur - step;
        if next < target { return target; }
        return next;
    }
    return cur;
}

// ---------------------------------------------------------- Airframe ---
// What both airframes do the same way. `self` is HELI or FOE, in X.
impl Airframe {
    // Touching the ground is a crash, deck or not, only flat out on both
    // axes: at the top descent rate (HELI_VY_MAX) and the top horizontal
    // speed (HELI_VX_MAX) either way. Anything slower is a landing. The
    // descent rate takes ~43 frames and ~88 px of dive to build, so a crash
    // has to start from above y 80 - from hover height it cannot reach it.
    // Airframe::crashes is the test; foe.r65 uses it too.
    fn crashes(vx: Q10, vy: Q10) -> u8 {
        if vy < HELI_VY_MAX { return 0; }
        if vx >= HELI_VX_MAX || vx <= Q10(0) - HELI_VX_MAX { return 1; }
        return 0;
    }

    // init - a fresh airframe at *x* facing *face* (1 left), hovering,
    // with a full load. The wreck and the lives are left alone: the wreck
    // of the one just lost is still falling, and the lives are the match's.
    fn init(self, x: u16, face: u8) {
        self.x_px = x;
        self.x_sub = 0;
        self.y = HELI_Y_HOVER;
        self.vx = Q10(0);
        self.vy = Q10(0);
        self.face_left = face;
        self.turn = 0;
        self.tilt = 0;
        self.hp = HELI_HP_MAX;
        self.hp_t = HELI_HP_REPAIR;
        self.fuel = HELI_FUEL_MAX;
        self.fuel_t = HELI_FUEL_DRAIN;
        self.gun = HELI_GUN_MAX;
        self.gun_t = HELI_GUN_RELOAD;
        self.gun_cd = 0;
        self.bombs = HELI_BOMB_MAX;
        self.bomb_t = HELI_BOMB_RELOAD;
        self.landed = 0;
        self.dead = 0;
        self.rising = 0;
    }

    // rearm - one tick on the deck. Fuel, rounds, bombs and health each
    // refill on their own countdown, so a short stop tops up fuel long
    // before ammo.
    fn rearm(self) {
        if self.fuel_t > 0 {
            self.fuel_t = self.fuel_t - 1;
        } else {
            self.fuel_t = HELI_FUEL_FILL;
            if self.fuel < HELI_FUEL_MAX { self.fuel = self.fuel + 1; }
        }

        if self.gun_t > 0 {
            self.gun_t = self.gun_t - 1;
        } else {
            self.gun_t = HELI_GUN_RELOAD;
            if self.gun < HELI_GUN_MAX - HELI_GUN_REFILL {
                self.gun = self.gun + HELI_GUN_REFILL;
            } else {
                self.gun = HELI_GUN_MAX;
            }
        }

        if self.bomb_t > 0 {
            self.bomb_t = self.bomb_t - 1;
        } else {
            self.bomb_t = HELI_BOMB_RELOAD;
            if self.bombs < HELI_BOMB_MAX { self.bombs = self.bombs + 1; }
        }

        if self.hp_t > 0 {
            self.hp_t = self.hp_t - 1;
        } else {
            self.hp_t = HELI_HP_REPAIR;
            if self.hp < HELI_HP_MAX { self.hp = self.hp + 1; }
        }
    }

    // burn - one tick aloft. Men are not restored by the pad, so nothing
    // else is on a timer up here.
    #[inline(always)]
    fn burn(self) {
        if self.fuel_t > 0 {
            self.fuel_t = self.fuel_t - 1;
        } else {
            self.fuel_t = HELI_FUEL_DRAIN;
            if self.fuel > 0 { self.fuel = self.fuel - 1; }
        }
    }

    // turn_step - advance, wind back or stall the turn for this frame,
    // from the direction held: 0 right, 1 left, 2 none. A turn starts when
    // the held direction is not the one faced; it completes - and the
    // facing changes - when the swing has run its length, and it is called
    // off if it is wound all the way back. The gun keeps its old side
    // until then.
    #[inline(always)]
    fn turn_step(self, want: u8) {
        self.lean(want);
        if self.turn == 0 {
            if want < 2 && want != self.face_left { self.turn = 1; }
            return;
        }
        if want == 2 { return; }                 // stalled
        if want != self.face_left {
            self.turn = self.turn + 1;
            if self.turn > HELI_TURN_STEPS {
                self.face_left = want;
                self.turn = 0;
            }
        } else {
            self.turn = self.turn - 1;
        }
    }

    // lean - a frame of the forward lean, from the direction held (as
    // turn_step): up HELI_LEAN_RISE while it is the way the nose points,
    // down one otherwise - let go, reversing, or no stick at all (a dead
    // stick passes 2).
    #[inline(always)]
    fn lean(self, want: u8) {
        if want == self.face_left {
            let t: u8 = self.tilt + HELI_LEAN_RISE;
            if t > HELI_LEAN_FULL { self.tilt = HELI_LEAN_FULL; } else { self.tilt = t; }
        } else {
            if self.tilt > 0 { self.tilt = self.tilt - 1; }
        }
    }

    // fly - a frame of flight: the 16.8 world x by vx, then the 8.8 y by
    // vy, clamped to the world and to the flyable box. A wall or the floor
    // or ceiling stops the speed into it.
    //
    // x's sign branch is not decoration. `>>` is a logical shift even on
    // signed types (docs/operators.md:438), so the high half of a negative
    // delta cannot be extracted by shifting - the same trap Q10::to_int
    // documents. y is one u16 wide, so two's-complement wrap would handle
    // either sign; its branch is there so the clamp can tell a floor hit
    // from a ceiling hit.
    #[inline(always)]
    fn fly(self) {
        let dx: i16 = self.vx.0 << 2;        // 1/64 -> 1/256
        if dx >= 0 {
            let m: u16 = dx as u16;
            let s: u16 = (self.x_sub as u16) + (m & 0x00FF);
            self.x_sub = s as u8;
            self.x_px = self.x_px + (m >> 8) + (s >> 8);
            let limit: u16 = WORLD_W - HELI_W;
            if self.x_px > limit {
                self.x_px = limit;
                self.x_sub = 0;
                self.vx = Q10(0);
            }
        } else {
            let m: u16 = (0 - dx) as u16;
            let mut whole: u16 = m >> 8;
            let frac: u16 = m & 0x00FF;
            if (self.x_sub as u16) < frac {
                whole = whole + 1;            // borrow into the pixel word
            }
            self.x_sub = self.x_sub - (frac as u8);
            if self.x_px <= whole {
                self.x_px = 0;
                self.x_sub = 0;
                self.vx = Q10(0);
            } else {
                self.x_px = self.x_px - whole;
            }
        }

        let dy: i16 = self.vy.0 << 2;
        if dy >= 0 {
            self.y = self.y + (dy as u16);
            if self.y > HELI_Y_MAX {
                self.y = HELI_Y_MAX;
                self.vy = Q10(0);
            }
        } else {
            let m: u16 = (0 - dy) as u16;
            if self.y <= m {
                self.y = HELI_Y_MIN;
                self.vy = Q10(0);
            } else {
                self.y = self.y - m;
                if self.y < HELI_Y_MIN {
                    self.y = HELI_Y_MIN;
                    self.vy = Q10(0);
                }
            }
        }
    }

    // draw - place the two OBJ cells, camera-relative, in this side's
    // palette; while a wreck is falling, it first (wreck_draw). Culled on
    // the full 16-bit offset, as the units are: the 9-bit OAM field would
    // alias a position screens away onto the window. Through set_full!,
    // which writes the 9th X bit; set! would leave a stale high bit and
    // render the sprite 256 px away.
    #[inline(always)]
    fn draw(self) {
        if self.wreck_up != 0 { self.wreck_draw(); }
        if self.dead > 0 { return; }
        // Every field read once, the u16s together and then the u8s: each
        // switch of width is an X reload, and the OAM writes below use X.
        let x: u16 = self.x_px;
        let y: u16 = self.y;
        let vx: Q10 = self.vx;
        let mut face: u8 = self.face_left;
        let turn: u8 = self.turn;
        let rising: u8 = self.rising;
        let tilt: u8 = self.tilt;

        let d: u16 = x - camera_x;
        if d >= 256 && d < 0xFFE0 { return; }

        // The lean is the stick's (lean); nose up is speed along the nose,
        // not the sign of vx. Facing left sets the hflip bit, which already
        // mirrors the tilt, so feeding the signed velocity straight in
        // would flip it a second time.
        let mut fwd: Q10 = vx;
        if face != 0 { fwd = Q10(0) - vx; }

        let mut tile: u8 = HELI_TILE_LEVEL;
        if tilt >= HELI_LEAN_DIP { tile = HELI_TILE_NOSE_DIP; }
        if tilt >= HELI_LEAN_FULL { tile = HELI_TILE_NOSE_DOWN; }
        if fwd < Q10(0) - HELI_TILT_ON { tile = HELI_TILE_NOSE_UP; }

        // Mid-turn the tilt frames give way to the swing: slight and
        // three-quarter facing the way it still faces, head-on, then
        // three-quarter and slight facing the way it is going.
        if turn > 0 {
            let step: u8 = div8(turn - 1, HELI_TURN_HOLD as u16);
            if step == 0 { tile = HELI_TILE_TURN_SLIGHT; }
            if step == 1 { tile = HELI_TILE_TURN_34; }
            if step == 2 { tile = HELI_TILE_TURN_HEAD; }
            if step == 3 { tile = HELI_TILE_TURN_34;     face = 1 - face; }
            if step == 4 { tile = HELI_TILE_TURN_SLIGHT; face = 1 - face; }
        }

        let sx: u16 = d & 0x01FF;
        let sy: u8 = (y >> 8) as u8;

        // Facing left mirrors the airframe. Both cells take the hflip bit
        // and swap places, otherwise the nose half would render on the
        // tail side. Rising out of the ground it is drawn at OBJ priority
        // 2 - behind the dirt, whose tiles carry the priority bit, but in
        // front of the mountains behind it - until its box has cleared the
        // ground line. The enemy's is the same but for its palette.
        let mut base: u16 = HELI_ATTR;
        if rising != 0 && y + (HELI_H << 8) > (GROUND_Y << 8) { base = HELI_ATTR_RISING; }
        if self != HELI { base = (base & ~OBJ_PAL_HELI) | OBJ_PAL_HELI_ENEMY; }
        let mut attr: u16 = base;
        let mut near: u8 = tile;
        let mut far_: u8 = tile + 2;
        if face != 0 {
            attr = base | 0x4000;             // OAM hflip
            near = tile + 2;
            far_ = tile;
        }

        let l: u16 = oam_take();
        let r: u16 = oam_take();
        if r < OAM_SLOTS {
            oam.set_full!(l as u8, sx, sy, (near as u16) | attr);
            oam.set_size!(l as u8, 1);
            oam.set_full!(r as u8, (sx + 16) & 0x01FF, sy, (far_ as u16) | attr);
            oam.set_size!(r as u8, 1);
        }
    }

    // wreck_draw - the lost airframe falling, spinning through
    // WRECK_SPIN_TILE by wreck_spin; where it hits it goes up and is gone
    // (wreck_tick), so it is only drawn in the air. The camera leaves it
    // behind, so it is culled off the screen - the 9-bit X wrap would put
    // a far one back on. Its own function, so the live draw pays nothing
    // for it.
    fn wreck_draw(self) {
        let wx: u16 = self.wreck_x;
        let wy: u16 = self.wreck_y;
        let spin: u8 = self.wreck_spin;
        let wface: u8 = self.wreck_face;
        let d: u16 = wx - (HELI_W >> 1) - camera_x;
        if d >= 256 && d < 0xFFE0 { return; }
        let step: u16 = (div8(spin, WRECK_SPIN_HOLD as u16) & 7) as u16;
        let tile: u8 = WRECK_SPIN_TILE[step];
        let mut base: u16 = HELI_ATTR;
        if self != HELI { base = (HELI_ATTR & ~OBJ_PAL_HELI) | OBJ_PAL_HELI_ENEMY; }
        let mut attr: u16 = base;
        let mut near: u8 = tile;
        let mut far_: u8 = tile + 2;
        if (wface ^ WRECK_SPIN_FLIP[step]) != 0 {
            attr = base | 0x4000;             // OAM hflip, the cells swapped
            near = tile + 2;
            far_ = tile;
        }
        let sx: u16 = d & 0x01FF;
        let sy: u8 = (wy >> 8) as u8;
        let l: u16 = oam_take();
        let r: u16 = oam_take();
        if r < OAM_SLOTS {
            oam.set_full!(l as u8, sx, sy, (near as u16) | attr);
            oam.set_size!(l as u8, 1);
            oam.set_full!(r as u8, (sx + 16) & 0x01FF, sy, (far_ as u16) | attr);
            oam.set_size!(r as u8, 1);
        }
    }
}


// The wreck spins as it falls - the tail rotor gone - through the turn's
// drawings: side, three-quarter, head-on, three-quarter and side the
// other way, and round again, WRECK_SPIN_HOLD frames each (a turn's).
// The side view is the crashing frame; the flip is against the facing it
// was lost with.
const WRECK_SPIN_HOLD: u8 = HELI_TURN_HOLD;
static WRECK_SPIN_TILE: [u8; 8] = [
    HELI_TILE_CRASHING, HELI_TILE_TURN_34, HELI_TILE_TURN_HEAD, HELI_TILE_TURN_34,
    HELI_TILE_CRASHING, HELI_TILE_TURN_34, HELI_TILE_TURN_HEAD, HELI_TILE_TURN_34,
];
static WRECK_SPIN_FLIP: [u8; 8] = [0, 0, 0, 1, 1, 1, 1, 0];

// Bank 3: the loss and the wreck's fall run a frame at a time at most,
// and bank 0 is full.
#[bank(3)]

impl Player {
    // Player::lost - the airframe is gone. The next one starts from the pad
    // with a full load; the last one is the match. High enough up, one of the
    // men aboard bails out as a paratrooper; the rest go with it.
    fn lost() {
        let cx: u16 = airframes[HELI].x_px + (HELI_W >> 1);
        sfx_at(SFX_CHN_LOST, SFX_EXPLODE_2, cx);
        fx_burst(FX_BIG, cx, airframes[HELI].y >> 8);
        if player.men > 0 && airframes[HELI].y <= HELI_Y_BAIL {
            let _: u8 = para_drop(airframes[HELI].x_px + (HELI_W >> 2), airframes[HELI].y, SIDE_PLAYER, 0);
        }
        airframes[HELI].lives = airframes[HELI].lives - 1;
        if airframes[HELI].lives == 0 {
            game_over(GAME_LOST);                 // the field freezes as it stands: no wreck
        } else {
            airframes[HELI].wreck_start();
            Player::init();
            airframes[HELI].dead = HELI_PAN;
            player.pause = HELI_GROUND_PAUSE;
        }
    }

    // Player::dead_tick - a frame of a lost airframe, in three steps: the wreck
    // falls with the camera on it (camera_update follows the focus, so the
    // focus stays there), a second on the ground once it has gone up, then
    // the pan home, at the end of which the next airframe rises. Player::init
    // has already put it on the start.
    fn dead_tick() {
        if airframes[HELI].wreck_up != 0 {
            airframes[HELI].wreck_tick();
            focus_x = airframes[HELI].wreck_x;
            return;
        }
        if player.pause > 0 {
            player.pause = player.pause - 1;
            if player.pause == 0 { player.cam_step = div16(camera_x, HELI_PAN) + 1; }
            focus_x = airframes[HELI].wreck_x;
            return;
        }
        airframes[HELI].dead = airframes[HELI].dead - 1;
        if airframes[HELI].dead == 0 {
            airframes[HELI].rising = 1;
            airframes[HELI].y = GROUND_Y << 8;
        }
        focus_x = airframes[HELI].x_px + (HELI_W >> 1);
        camera_pan(player.cam_step);
    }
}




// What a lost airframe's wreck does, either side's: drawing only - the
// loss is counted at once - and once a frame at most, so in bank 3.
impl Airframe {
    // Airframe::half - half a speed, for a wreck: *v* / 2 toward zero. `>>` is
    // logical, so the sign is a branch.
    fn half(v: Q10) -> Q10 {
        if v >= Q10(0) { return Q10(((v.0 as u16) >> 1) as i16); }
        return Q10(0) - Q10((((0 - v.0) as u16) >> 1) as i16);
    }

    // wreck_start - the airframe is lost: its wreck starts where it was,
    // falling at what downward speed it had and keeping half its way on
    // (Airframe::half). One lost on the ground (y at HELI_Y_MAX) has none:
    // it is gone in its explosion.
    fn wreck_start(self) {
        self.wreck_x = self.x_px + (HELI_W >> 1);
        self.wreck_y = self.y;
        self.wreck_vy = Q10(0);
        if self.vy > Q10(0) { self.wreck_vy = self.vy; }
        self.wreck_vx = Airframe::half(self.vx);
        self.wreck_sub = 0;
        self.wreck_face = self.face_left;
        self.wreck_spin = 0;
        self.wreck_up = 0;
        if self.y < HELI_Y_MAX { self.wreck_up = 1; }
    }

    // wreck_tick - a frame of the wreck's fall, while it is in the air:
    // dead-stick gravity down, half the airframe's way on carrying it the
    // whole way (stopping only at the world's edges), and where it hits it
    // goes up in a big explosion and is gone - wreck_y at HELI_Y_MAX is
    // "no wreck".
    fn wreck_tick(self) {
        self.wreck_spin = self.wreck_spin + 1;
        if self.wreck_vy < HELI_VY_MAX { self.wreck_vy = self.wreck_vy + HELI_GRAVITY; }
        self.wreck_y = self.wreck_y + ((self.wreck_vy.0 as u16) << 2);
        let d: i16 = self.wreck_vx.0 << 2;      // 1/64 -> 1/256
        if d >= 0 {
            let m: u16 = d as u16;
            let s: u16 = (self.wreck_sub as u16) + (m & 0x00FF);
            self.wreck_sub = s as u8;
            self.wreck_x = self.wreck_x + (m >> 8) + (s >> 8);
            if self.wreck_x > WORLD_W - (HELI_W >> 1) {
                self.wreck_x = WORLD_W - (HELI_W >> 1);
                self.wreck_vx = Q10(0);
            }
        } else {
            let m: u16 = (0 - d) as u16;
            let mut whole: u16 = m >> 8;
            let frac: u16 = m & 0x00FF;
            if (self.wreck_sub as u16) < frac { whole = whole + 1; }
            self.wreck_sub = self.wreck_sub - (frac as u8);
            if self.wreck_x <= whole + (HELI_W >> 1) {
                self.wreck_x = HELI_W >> 1;
                self.wreck_vx = Q10(0);
            } else {
                self.wreck_x = self.wreck_x - whole;
            }
        }
        if self.wreck_y >= HELI_Y_MAX {
            self.wreck_y = HELI_Y_MAX;
            self.wreck_up = 0;
            self.wreck_vx = Q10(0);
            sfx_at(SFX_CHN_BLAST, SFX_EXPLODE_1, self.wreck_x);
            fx_spawn(FX_BIG, self.wreck_x, GROUND_Y - 16);
        }
    }

    // Airframe::collided - the two airframes went into each other: neither wreck
    // keeps its way on, they fall straight down where they met.
    fn collided() {
        airframes[HELI].wreck_vx = Q10(0);
        airframes[FOE].wreck_vx = Q10(0);
    }
}

#[bank(0)]
