// heli - the player helicopter: 8.8 physics, cosmetic tilt, and camera-
// relative rendering.
//
// Types follow the plan's Position representation section:
//   x   world pixel + 1/256 fraction, because a 4096 px world fits in no
//       16-bit fixed type (Q8 caps at 255.996, Q10 at +/-511)
//   y   plain u16 holding 8.8 screen pixels - 0..224 fits the integer byte
//   v   Q10 (signed 10.6): velocity has to go negative, and a 5 px/frame cap
//       still leaves 320 steps of resolution
//
// Q10 is 1/64 and the position fraction is 1/256, so a per-frame delta is
// `v.0 << 2`. Q10::mul/div are never called - integration is only +, - and
// compare, which the newtype inherits from i16.

#[bank(0)]

// ------------------------------------------------------------- geometry ---
const HELI_W:     u16 = 32;               // two 16x16 OBJ cells
const HELI_H:     u16 = 16;

// Vertical limits in 8.8. The HUD strip owns the top two tile rows, and the
// ground line is GROUND_Y, so the airframe has to stop 16 px short of it.
const HELI_Y_MIN: u16 = 16 << 8;
const HELI_Y_MAX: u16 = (GROUND_Y - HELI_H) << 8;

// ------------------------------------------------------------- handling ---
// Armor Alley's mouse-seeking becomes d-pad acceleration toward a target
// velocity: the stick picks a speed, the airframe takes a few frames to reach
// it. No gravity while powered - that only arrives with fuel-out and ejection.
const HELI_VX_MAX: Q10 = 5 * 64;          // 5 px/frame, the plan's cap
const HELI_VY_MAX: Q10 = 4 * 64;          // ~4 px/frame
// Inertia. Thrust is how fast the stick builds speed; drag is how fast
// speed bleeds off with the stick released - slower, so the airframe
// coasts and overshoots rather than stopping where the thumb does.
// Horizontal: 20 frames to top speed, ~40 to coast down from it (~100 px).
// Vertical builds more gently - climbing and diving should read as the
// airframe leaning into it - and bleeds off a little faster than it
// builds, since the ground and the ceiling are near.
const HELI_THRUST_X: Q10 = 16;            // 0.25 px/frame^2
const HELI_DRAG_X:   Q10 = 8;             // 0.125
const HELI_THRUST_Y: Q10 = 6;            // 0.19: ~21 frames to top climb
const HELI_DRAG_Y:   Q10 = 8;
const HELI_ACC:      Q10 = 16;            // dead-stick horizontal decay
const HELI_TILT_ON: Q10 = 96;             // 1.5 px/frame before the nose drops

// Tilt frames in the OBJ sheet. A 16x16 sprite at tile t covers t, t+1,
// t+16, t+17, so a 32x16 frame is two cells four tiles apart.
// Named for the nose, not for a screen direction. The frames are drawn
// nose-right and facing-left renders them hflipped, so a screen-relative
// name invites picking the mirrored frame - which is exactly the bug this
// naming replaced.
const HELI_TILE_NOSE_DOWN: u8 = 0;        // assets/src/heli.bmp, frame 0
const HELI_TILE_LEVEL:     u8 = 4;        // ... frame 1
const HELI_TILE_NOSE_UP:   u8 = 8;        // ... frame 2
// Turning: five drawings - a slight turn and a three-quarter view facing
// the old way, head-on, then the same two facing the new way - each held
// HELI_TURN_HOLD frames. The turn only advances while the new direction
// is held: let go and it stalls where it is, hold the old direction and
// it swings back. The facing the gun fires along changes when the turn
// completes, not when it starts. The three pieces of art are on the
// sheet's last row (tools/struct_art.py).
const HELI_TILE_TURN_34:     u8 = 32;
const HELI_TILE_TURN_HEAD:   u8 = 36;
const HELI_TILE_TURN_SLIGHT: u8 = 40;
// The wreck, in each row's last four columns: falling out of the air
// after a loss, then down on the ground until the next airframe rises.
const HELI_TILE_CRASHING:    u8 = 12;
const HELI_TILE_CRASHED:     u8 = 44;
const HELI_TURN_HOLD:        u8 = 3;      // frames per drawing
const HELI_TURN_STEPS:       u8 = 5 * 3;  // the whole swing
// The airframe has a sheet of its own (assets/src/heli.bmp, drawn by
// tools/heli_art.py) rather than a corner of obj.bmp: its art and its
// colours are the two airframes' alone, and neither the units nor the
// buildings are disturbed by a change to them. It is loaded into the
// second OBJ name block, so a tile number here is 256 + the sheet's -
// HELI_PAGE is that 9th bit, which rides in the attribute word beside
// the palette and the priority.
const HELI_PAGE: u16 = 0x0100;
const HELI_ATTR: u16 = 0x3000 | HELI_PAGE | OBJ_PAL_HELI;   // priority 3
const HELI_ATTR_RISING: u16 = 0x2000 | HELI_PAGE | OBJ_PAL_HELI;   // 2: see heli_draw

// The helicopter is the highest-priority object in the game, so it draws
// first and takes the lowest slots from the shared allocator.

// -------------------------------------------------------------- weapons ---
// The plan's loadout. Ammo is the real bottleneck by design - roughly 21 s to
// refill from empty once the landing pad arrives - so these are not knobs to
// loosen without re-reading the economy section.
const HELI_GUN_MAX:  u8 = 64;
const HELI_BOMB_MAX: u8 = 10;
const HELI_GUN_RATE: u8 = 6;              // frames between rounds while held

// Where a round leaves the airframe: the nose when facing right, the tail
// end of the same box when facing left, and level with the cabin.
const HELI_MUZZLE_Y: u16 = 7;
// Driving forward the nose drops (HELI_TILT_ON, the same test heli_draw
// uses to pick the frame) and the gun fires along it: 1 px down for every
// 8 forward, about 7 degrees, so a strafing run walks rounds into the
// ground ahead instead of over everything.
const HELI_GUN_DROP: Q10 = 64;            // 1 px/frame

// ----------------------------------------------------------- fuel & pad ---
// Fuel is a 0-100 gauge; the plan's AI reads "fuel < 30" as its low mark.
// One unit per 64 frames is a little over 100 s of flight.
const HELI_FUEL_MAX:   u8 = 100;
const HELI_FUEL_DRAIN: u8 = 64;           // frames per unit burned aloft
const HELI_FUEL_FILL:  u8 = 4;            // frames per unit on the deck

// Reload rates. These are the gating mechanism, not tuning knobs. The
// plan's rounds came back one per 20 frames, ~22 s from empty; they are
// eight a time now, eight times as fast - ~9 s for 64 - while bombs keep
// the plan's one per 10. The plan calls these "modulus timers"; countdowns
// do the same job without a modulus, which for 20 and 10 would mean a
// mod8 call.
const HELI_GUN_RELOAD:  u8 = 20;
const HELI_GUN_REFILL:  u8 = 8;           // rounds back each time it runs out
const HELI_BOMB_RELOAD: u8 = 10;
// The deck repairs too - the plan's "full rearm", and what the enemy
// pilot's refit rule (health under 5 counts toward a return) assumes.
const HELI_HP_REPAIR:   u8 = 16;          // frames per point

// Dead-stick descent once the tank is dry.
const HELI_GRAVITY: Q10 = 10;             // ~0.16 px/frame^2

// Touching the ground is a crash, deck or not, only flat out on both
// axes: at the top descent rate (HELI_VY_MAX) and the top horizontal
// speed (HELI_VX_MAX) either way. Anything slower is a landing. The
// descent rate takes ~43 frames and ~88 px of dive to build, so a crash
// has to start from above y 80 - from hover height it cannot reach it.
// heli_crashes is the test; foe.r65 uses it too.
far fn heli_crashes(vx: Q10, vy: Q10) -> u8 {
    if vy < HELI_VY_MAX { return 0; }
    if vx >= HELI_VX_MAX || vx <= Q10(0) - HELI_VX_MAX { return 1; }
    return 0;
}

// ---------------------------------------------------------------- state ---
#[lowram] static mut heli_x_px:  u16;     // world pixel, 0..WORLD_W-HELI_W
#[lowram] static mut heli_x_sub: u8;      // 1/256 px
#[lowram] static mut heli_y:     u16;     // 8.8 screen pixels
#[lowram] static mut heli_vx:    Q10;
#[lowram] static mut heli_vy:    Q10;
#[lowram] static mut heli_gun:   u8;      // rounds remaining
#[lowram] static mut heli_bombs: u8;
#[lowram] static mut heli_gun_cd: u8;     // frames until the gun can fire
#[lowram] static mut heli_face_left: u8;  // 0 nose right, 1 nose left
#[lowram] static mut heli_turn: u8;       // progress through a turn, 0 = none
#[lowram] static mut heli_fuel:   u8;     // 0..HELI_FUEL_MAX
#[lowram] static mut heli_landed: u8;     // 1 while resting on the ground
#[lowram] static mut heli_on_pad: u8;     // ... and that ground is a deck
#[lowram] static mut heli_fuel_t: u8;     // countdown to the next fuel unit
#[lowram] static mut heli_gun_t:  u8;     // ... and to the next round
#[lowram] static mut heli_bomb_t: u8;
#[lowram] static mut heli_hp_t:   u8;     // ... and to the next point repaired
#[lowram] static mut heli_hp:     u8;     // the plan's 20; a bomb ends it outright
#[lowram] static mut heli_dead:   u8;     // frames until the next airframe; 0 = flying
#[lowram] static mut heli_rising: u8;     // 1 while the next airframe climbs out of the ground
#[lowram] static mut heli_cam_step: u16;  // the pan home, px/frame, sized at the loss
#[lowram] static mut heli_wreck_x:  u16;  // where it was lost: the camera holds there
#[lowram] static mut heli_wreck_y:  u16;  // the wreck's top, 8.8: falls to HELI_Y_MAX
#[lowram] static mut heli_wreck_vy: Q10;
#[lowram] static mut heli_wreck_vx: Q10;   // half the way on it had, kept all the way down
#[lowram] static mut heli_wreck_sub: u8;   // 1/256 px of heli_wreck_x
#[lowram] static mut heli_wreck_face: u8;

// Enemy fire against the airframe. Gunfire takes a point; at zero the
// airframe is lost - a life goes (order.r65's heli_lives) and it returns
// to the start with a full load. The battle-over screen is phase 9's.
const HELI_HP_MAX: u8 = 20;
const HELI_DMG_MISSILE: u8 = 10;          // two of a base's missiles end it

// Losing an airframe is not instant. The sprite goes, the view pans back
// to the start, and the next airframe appears there once the pan is done.
// The pan is paced to land inside the delay from wherever the loss was:
// distance over the delay, rounded up, so the far end of the world takes
// the whole delay and anywhere nearer arrives with frames to spare.
const HELI_RESPAWN: u8 = 120;             // frames hidden; the pan's budget
// The camera holds on the loss this long - the big explosion's eight
// frames of six (fx.r65) - before it pans home in the rest of the delay.
const HELI_LOSS_HOLD: u8 = 48;
// Then it rises out of the ground at the start: from the ground line up
// to hover height at a pixel a frame, drawn behind the ground band until
// it has cleared it, and under nobody's control.
const HELI_Y_HOVER: u16 = 112 << 8;
const HELI_RISE:    u16 = 1 << 8;         // px/frame, 8.8
// An airframe lost a third or more of its flight band off the ground
// gets one man out of the door before it goes. Landed, it is at
// HELI_Y_MAX, under the line, so this is also the "in the air" test.
// Measured off the ground, as a third of the band when it was 16..152
// (45 px, `/ 3` does not fold): every height below the ceiling is ground-relative.
const HELI_Y_BAIL:  u16 = HELI_Y_MAX - (45 << 8);

// heli_init - place the airframe. Statics are declared bare because an
// initializer on a mutable static trips the __init_start MVN/DBR bug.
far fn heli_init() {
    heli_x_px = 64;
    heli_x_sub = 0;
    heli_y = HELI_Y_HOVER;
    heli_vx = Q10(0);
    heli_vy = Q10(0);
    heli_gun = HELI_GUN_MAX;
    heli_bombs = HELI_BOMB_MAX;
    heli_gun_cd = 0;
    heli_face_left = 0;
    heli_turn = 0;
    heli_fuel = HELI_FUEL_MAX;
    heli_landed = 0;
    heli_on_pad = 0;
    heli_fuel_t = HELI_FUEL_DRAIN;
    heli_gun_t = HELI_GUN_RELOAD;
    heli_bomb_t = HELI_BOMB_RELOAD;
    heli_hp_t = HELI_HP_REPAIR;
    heli_hp = HELI_HP_MAX;
    heli_men = 0;                         // the men left aboard went with it
    heli_dead = 0;
    heli_rising = 0;
    heli_cam_step = 0;
}

// heli_collide - enemy rounds against the airframe's box, and the
// barrage balloons, which end it outright.
far fn heli_collide() {
    if heli_dead > 0 || heli_rising != 0 { return; }   // nothing there to hit
    let hx: u16 = heli_x_px;
    let hy: u16 = heli_y >> 8;
    if struct_balloon_at(hx, hy) != 0 {
        heli_lost();
        return;
    }
    // Nothing of another side up - the usual frame - and the pool is not
    // worth walking; muni_up counts the player's and everyone else's.
    if muni_up[1] == 0 { return; }
    for m in 0..MUNI_MAX {
        let mk: u8 = muni_kind[m];
        if mk == MUNI_BULLET || mk == MUNI_MISSILE || mk == MUNI_BOMB {
            // Anything not the player's own: the enemy's, or a
            // hostile-neutral super bunker's.
            if muni_owner[m] != SIDE_PLAYER {
                let mx: u16 = muni_x_px[m];
                let my: u16 = muni_y[m] >> 8;
                if mx >= hx && mx < hx + HELI_W {
                    if my >= hy && my < hy + HELI_H {
                        muni_drop_bomb(m);
                        muni_kind[m] = MUNI_FREE;
                        if mk == MUNI_BOMB {
                            heli_lost();          // a bomb ends it outright
                            return;
                        }
                        let mut dmg: u8 = 1;
                        if mk == MUNI_MISSILE { dmg = HELI_DMG_MISSILE; }
                        if heli_hp > dmg {
                            heli_hp = heli_hp - dmg;
                        } else {
                            heli_lost();
                            return;
                        }
                    }
                }
            }
        }
    }
}

// heli_rearm - one tick on the deck. Fuel, rounds and bombs each refill on
// their own countdown, so a short stop tops up fuel long before ammo.
far fn heli_rearm() {
    if heli_fuel_t > 0 {
        heli_fuel_t = heli_fuel_t - 1;
    } else {
        heli_fuel_t = HELI_FUEL_FILL;
        if heli_fuel < HELI_FUEL_MAX { heli_fuel = heli_fuel + 1; }
    }

    if heli_gun_t > 0 {
        heli_gun_t = heli_gun_t - 1;
    } else {
        heli_gun_t = HELI_GUN_RELOAD;
        if heli_gun < HELI_GUN_MAX - HELI_GUN_REFILL {
            heli_gun = heli_gun + HELI_GUN_REFILL;
        } else {
            heli_gun = HELI_GUN_MAX;
        }
    }

    if heli_bomb_t > 0 {
        heli_bomb_t = heli_bomb_t - 1;
    } else {
        heli_bomb_t = HELI_BOMB_RELOAD;
        if heli_bombs < HELI_BOMB_MAX { heli_bombs = heli_bombs + 1; }
    }

    if heli_hp_t > 0 {
        heli_hp_t = heli_hp_t - 1;
    } else {
        heli_hp_t = HELI_HP_REPAIR;
        if heli_hp < HELI_HP_MAX { heli_hp = heli_hp + 1; }
    }
}

// heli_burn - one tick aloft. Men are not restored by the pad, so nothing
// else is on a timer up here.
far fn heli_burn() {
    if heli_fuel_t > 0 {
        heli_fuel_t = heli_fuel_t - 1;
    } else {
        heli_fuel_t = HELI_FUEL_DRAIN;
        if heli_fuel > 0 { heli_fuel = heli_fuel - 1; }
    }
}

// heli_fire - gunfire while B is held, one bomb per press of A.
//
// The gun points where the nose points. Facing follows the last commanded
// direction rather than the current velocity, so it does not flip back to
// neutral while the airframe coasts to a stop.
far fn heli_fire(held: u16, trig: u16) {
    if heli_dead > 0 || heli_rising != 0 { return; }
    if heli_gun_cd > 0 {
        heli_gun_cd = heli_gun_cd - 1;
    }

    if (held & JOY_B) != 0 {
        if heli_gun_cd == 0 {
            if heli_gun > 0 {
                heli_gun = heli_gun - 1;
                heli_gun_cd = HELI_GUN_RATE;
                let mut mx: u16 = heli_x_px + HELI_W;
                let mut v: Q10 = BULLET_SPEED;
                let mut fwd: Q10 = heli_vx;
                if heli_face_left != 0 {
                    mx = heli_x_px;
                    v = Q10(0) - BULLET_SPEED;
                    fwd = Q10(0) - heli_vx;
                }
                // Nose down: the round leaves at a slight downward angle.
                let mut vy: Q10 = 0;
                if fwd > HELI_TILT_ON { vy = HELI_GUN_DROP; }
                muni_spawn(MUNI_BULLET, mx, heli_y + (HELI_MUZZLE_Y << 8),
                           v, vy, BULLET_LIFE, SIDE_PLAYER);
                sfx_at(SFX_CHN_GUN, SFX_PLAYER_GUN1, mx);
            }
        }
    }

    // X: a man out of the door, airborne only - on the deck he would just
    // walk back aboard.
    if (trig & JOY_X) != 0 {
        if heli_men > 0 && heli_landed == 0 {
            heli_men = heli_men - 1;
            para_drop(heli_x_px + (HELI_W >> 2), heli_y, SIDE_PLAYER);
        }
    }

    if (trig & JOY_A) != 0 {
        if heli_bombs > 0 {
            heli_bombs = heli_bombs - 1;
            // A bomb keeps the airframe's horizontal speed and starts at
            // rest vertically, so a fast pass throws it forward.
            // A bomb has no timer: it lives until it reaches the ground.
            muni_spawn(MUNI_BOMB, heli_x_px + (HELI_W >> 1),
                       heli_y + (HELI_H << 8), heli_vx, Q10(0), 0, SIDE_PLAYER);
        }
    }
}

// heli_turn_step - advance, wind back or stall the turn for this frame,
// from the direction held: 0 right, 1 left, 2 none. A turn starts when
// the held direction is not the one faced; it completes - and the
// facing changes - when the swing has run its length, and it is called
// off if it is wound all the way back.
far fn heli_turn_step(want: u8) {
    if heli_turn == 0 {
        if want < 2 && want != heli_face_left { heli_turn = 1; }
        return;
    }
    if want == 2 { return; }                 // stalled
    if want != heli_face_left {
        heli_turn = heli_turn + 1;
        if heli_turn > HELI_TURN_STEPS {
            heli_face_left = want;
            heli_turn = 0;
        }
    } else {
        heli_turn = heli_turn - 1;
    }
}

// approach - step `cur` toward `target` by at most `step`.
// Plain i16 compares; Q10 inherits them from its payload.
far fn approach(cur: Q10, target: Q10, step: Q10) -> Q10 {
    if cur < target {
        let next: Q10 = cur + step;
        if next > target { return target; }
        return next;
    }
    if cur > target {
        let next: Q10 = cur - step;
        if next < target { return target; }
        return next;
    }
    return cur;
}

// heli_move_x - advance the 16.8 world position by a Q10 velocity.
//
// The sign branch is not decoration. `>>` is a logical shift even on signed
// types (docs/operators.md:438), so the high half of a negative delta cannot
// be extracted by shifting - the same trap Q10::to_int documents. A single
// u16 would be exempt, but this position spans two words.
far fn heli_move_x(v: Q10) {
    let d: i16 = v.0 << 2;                // 1/64 -> 1/256
    if d >= 0 {
        let m: u16 = d as u16;
        let s: u16 = (heli_x_sub as u16) + (m & 0x00FF);
        heli_x_sub = s as u8;
        heli_x_px = heli_x_px + (m >> 8) + (s >> 8);
        let limit: u16 = WORLD_W - HELI_W;
        if heli_x_px > limit {
            heli_x_px = limit;
            heli_x_sub = 0;
            heli_vx = Q10(0);
        }
    } else {
        let m: u16 = (0 - d) as u16;
        let mut whole: u16 = m >> 8;
        let frac: u16 = m & 0x00FF;
        if (heli_x_sub as u16) < frac {
            whole = whole + 1;            // borrow into the pixel word
        }
        heli_x_sub = heli_x_sub - (frac as u8);
        if heli_x_px <= whole {
            heli_x_px = 0;
            heli_x_sub = 0;
            heli_vx = Q10(0);
        } else {
            heli_x_px = heli_x_px - whole;
        }
    }
}

// heli_move_y - advance the 8.8 screen position and clamp to the flyable box.
// One u16 wide, so two's-complement wrap would handle either sign; the branch
// is here so the clamp can tell a floor hit from a ceiling hit.
far fn heli_move_y(v: Q10) {
    let d: i16 = v.0 << 2;
    if d >= 0 {
        heli_y = heli_y + (d as u16);
        if heli_y > HELI_Y_MAX {
            heli_y = HELI_Y_MAX;
            heli_vy = Q10(0);
        }
    } else {
        let m: u16 = (0 - d) as u16;
        if heli_y <= m {
            heli_y = HELI_Y_MIN;
            heli_vy = Q10(0);
        } else {
            heli_y = heli_y - m;
            if heli_y < HELI_Y_MIN {
                heli_y = HELI_Y_MIN;
                heli_vy = Q10(0);
            }
        }
    }
}

// heli_update - one tick of input, physics and world clamping.
far fn heli_update(held: u16) {
    if heli_dead > 0 {
        // Lost: the stick does nothing, and the view goes home ahead of
        // the next airframe. heli_init has already put it on the start.
        heli_dead = heli_dead - 1;
        if heli_dead == 0 {
            heli_rising = 1;
            heli_y = GROUND_Y << 8;
        }
        // The wreck falls (heli_wreck_tick). Drawing only: the loss has
        // already been counted.
        if heli_wreck_y < HELI_Y_MAX { heli_wreck_tick(); }
        // Held on the wreck while it goes up (camera_update follows the
        // focus too, so the focus stays there), then home in what is left.
        if heli_dead >= HELI_RESPAWN - HELI_LOSS_HOLD {
            focus_x = heli_wreck_x;
        } else {
            focus_x = heli_x_px + (HELI_W >> 1);
            camera_pan(heli_cam_step);
        }
        return;
    }
    // Up, rising or on a deck: the rotor (checked here, not in sfx_rotor,
    // so the three frames in four it is quiet cost no far call).
    if (frames_loop & (ROTOR_EVERY - 1)) == 0 { sfx_rotor(heli_x_px + (HELI_W >> 1), heli_landed); }
    if heli_rising != 0 {
        heli_y = heli_y - HELI_RISE;
        if heli_y <= HELI_Y_HOVER {
            heli_y = HELI_Y_HOVER;
            heli_rising = 0;
        }
        focus_x = heli_x_px + (HELI_W >> 1);
        return;
    }

    if heli_landed != 0 {
        // On the ground: no motion. A deck's timers do their work; open
        // ground is only for picking men up. Up lifts off, but only with
        // fuel to lift off on.
        heli_vx = Q10(0);
        heli_vy = Q10(0);
        if heli_on_pad != 0 { heli_rearm(); }
        para_pickup();
        if (held & JOY_UP) != 0 {
            if heli_fuel > 0 { heli_landed = 0; }
        }
    } else {
        heli_burn();

        if heli_fuel == 0 {
            // Dead stick. The plan allows gravity in exactly two places -
            // an empty tank and an ejection - and this is the first.
            heli_vx = approach(heli_vx, Q10(0), HELI_ACC);
            let v: Q10 = heli_vy + HELI_GRAVITY;
            if v > HELI_VY_MAX {
                heli_vy = HELI_VY_MAX;
            } else {
                heli_vy = v;
            }
        } else {
            let mut tx: Q10 = Q10(0);
            // 2 = no direction held; the turn stalls on that.
            let mut want: u8 = 2;
            if (held & JOY_RIGHT) != 0 { tx = HELI_VX_MAX; want = 0; }
            if (held & JOY_LEFT)  != 0 { tx = Q10(0) - HELI_VX_MAX; want = 1; }
            heli_turn_step(want);

            let mut ty: Q10 = Q10(0);
            if (held & JOY_DOWN) != 0 { ty = HELI_VY_MAX; }
            if (held & JOY_UP)   != 0 { ty = Q10(0) - HELI_VY_MAX; }

            let mut ax: Q10 = HELI_THRUST_X;
            if tx == Q10(0) { ax = HELI_DRAG_X; }
            let mut ay: Q10 = HELI_THRUST_Y;
            if ty == Q10(0) { ay = HELI_DRAG_Y; }
            heli_vx = approach(heli_vx, tx, ax);
            heli_vy = approach(heli_vy, ty, ay);
        }

        // Whether the airframe is descending, and how fast, has to be read
        // before the move: heli_move_y zeroes vy the moment it touches the
        // floor, so asking afterwards would always say no.
        let mut descending: u8 = 0;
        if heli_vy > Q10(0) { descending = 1; }
        let vy_in: Q10 = heli_vy;

        heli_move_x(heli_vx);
        heli_move_y(heli_vy);

        // "Land only while descending" - drifting sideways into the ground
        // at zero vertical speed does not count, which is what stops the
        // floor from catching an airframe that is merely skimming it. Open
        // ground takes a powered landing anywhere - that is how men are
        // picked up in the field - and a deck takes any landing; a dead
        // stick that meets open ground is a crash landing. The crash test
        // takes vx after the move (a copy before it cost the stress run 7
        // ticks): at a world edge the move has stopped it, so a dive into
        // the edge lands.
        if heli_y == HELI_Y_MAX {
            if heli_crashes(heli_vx, vy_in) != 0 {
                heli_lost();              // flat out: a crash, deck or not
                return;
            }
            if descending != 0 {
                heli_on_pad = 0;
                if pad_at(heli_x_px + (HELI_W >> 1)) < PAD_COUNT { heli_on_pad = 1; }
                if heli_on_pad != 0 || heli_fuel > 0 {
                    heli_landed = 1;
                }
            }
            if heli_fuel == 0 && heli_landed == 0 {
                heli_lost();
                return;
            }
        }
    }

    // The camera follows the airframe's centre, led by its velocity so
    // the view opens up ahead of it: Armor Alley's lookahead of 0.4 of a
    // half-screen at top speed, taken here as vx/8 - 40 px at 5 px/frame.
    // `>>` is logical, so the sign is a branch. The deadzone in
    // camera_update is what keeps a turn from snapping the view.
    let mut f: u16 = heli_x_px + (HELI_W >> 1);
    if heli_vx >= Q10(0) {
        f = f + ((heli_vx.0 as u16) >> 3);
        if f > WORLD_W { f = WORLD_W; }
    } else {
        let back: u16 = ((0 - heli_vx.0) as u16) >> 3;
        if f > back { f = f - back; } else { f = 0; }
    }
    focus_x = f;
}

// heli_draw - place the two OBJ cells, camera-relative.
//
// Screen X can be negative or past 255 while the airframe straddles an edge,
// so both cells go through set_full!, which writes the 9th X bit. set! would
// leave a stale high bit and render the sprite 256 px away.
far fn heli_draw() {
    if heli_dead > 0 {                    // lost: the wreck, until the next one rises
        // Only while it falls: it goes up where it hits (heli_wreck_tick).
        if heli_wreck_y < HELI_Y_MAX {
            wreck_draw(heli_wreck_x, heli_wreck_y, heli_wreck_face, HELI_ATTR, HELI_RESPAWN - heli_dead);
        }
        return;
    }

    // Tilt comes from speed along the nose, not from the sign of vx.
    // Facing left sets the hflip bit, which already mirrors the lean, so
    // feeding the signed velocity straight in would flip it a second time
    // and pitch the nose UP under forward acceleration.
    let mut fwd: Q10 = heli_vx;
    if heli_face_left != 0 { fwd = Q10(0) - heli_vx; }

    let mut tile: u8 = HELI_TILE_LEVEL;
    if fwd > HELI_TILT_ON { tile = HELI_TILE_NOSE_DOWN; }
    if fwd < Q10(0) - HELI_TILT_ON { tile = HELI_TILE_NOSE_UP; }

    // Mid-turn the tilt frames give way to the swing: slight and
    // three-quarter facing the way it still faces, head-on, then
    // three-quarter and slight facing the way it is going.
    let mut face: u8 = heli_face_left;
    if heli_turn > 0 {
        let step: u8 = div8(heli_turn - 1, HELI_TURN_HOLD as u16);
        if step == 0 { tile = HELI_TILE_TURN_SLIGHT; }
        if step == 1 { tile = HELI_TILE_TURN_34; }
        if step == 2 { tile = HELI_TILE_TURN_HEAD; }
        if step == 3 { tile = HELI_TILE_TURN_34;     face = 1 - face; }
        if step == 4 { tile = HELI_TILE_TURN_SLIGHT; face = 1 - face; }
    }

    // Camera-relative, wrapped into the 9-bit OAM X field. A sprite left of
    // the screen shows up at $1FF-ish, which OAM reads as off-screen.
    let sx: u16 = (heli_x_px - camera_x) & 0x01FF;
    let sy: u8 = (heli_y >> 8) as u8;

    // Facing left mirrors the airframe. Both cells take the hflip bit and
    // swap places, otherwise the nose half would render on the tail side.
    // Rising out of the ground it is drawn at OBJ priority 2 - behind the
    // dirt, whose tiles carry the priority bit, but in front of the
    // mountains behind it - until its box has cleared the ground line.
    let mut base: u16 = HELI_ATTR;
    if heli_rising != 0 && heli_y + (HELI_H << 8) > (GROUND_Y << 8) { base = HELI_ATTR_RISING; }
    let mut attr: u16 = base;
    let mut near: u8 = tile;
    let mut far_: u8 = tile + 2;
    if face != 0 {
        attr = base | 0x4000;             // OAM hflip
        near = tile + 2;
        far_ = tile;
    }

    let l: u16 = oam_take();
    let r: u16 = oam_take();
    if r < OAM_SLOTS {
        oam.set_full!(l as u8, sx, sy, (near as u16) | attr);
        oam.set_size!(l as u8, 1);
        oam.set_full!(r as u8, (sx + 16) & 0x01FF, sy, (far_ as u16) | attr);
        oam.set_size!(r as u8, 1);
    }
}

// The wreck spins as it falls - the tail rotor gone - through the turn's
// drawings: side, three-quarter, head-on, three-quarter and side the
// other way, and round again, WRECK_SPIN_HOLD frames each (a turn's).
// The side view is the crashing frame; the flip is against the facing it
// was lost with.
const WRECK_SPIN_HOLD: u8 = HELI_TURN_HOLD;
static WRECK_SPIN_TILE: [u8; 8] = [
    HELI_TILE_CRASHING, HELI_TILE_TURN_34, HELI_TILE_TURN_HEAD, HELI_TILE_TURN_34,
    HELI_TILE_CRASHING, HELI_TILE_TURN_34, HELI_TILE_TURN_HEAD, HELI_TILE_TURN_34,
];
static WRECK_SPIN_FLIP: [u8; 8] = [0, 0, 0, 1, 1, 1, 1, 0];

// wreck_draw - a lost airframe where it fell, either side's (foe_draw
// passes the enemy's palette in *base*): spinning while it drops, *t*
// frames after the loss, the crashed frame on the ground. *cx* is its
// centre, *y* its top in 8.8. The camera leaves it behind, so it is culled
// off the screen - the 9-bit X wrap would put a far one back on. Its own
// function, so the live draws pay nothing for it.
fn wreck_draw(cx: u16, y: u16, face: u8, base: u16, t: u8) {
    let d: u16 = cx - (HELI_W >> 1) - camera_x;
    if d >= 256 && d < 0xFFE0 { return; }
    let mut tile: u8 = HELI_TILE_CRASHED;
    let mut f: u8 = face;
    if y < HELI_Y_MAX {
        let step: u16 = (div8(t, WRECK_SPIN_HOLD as u16) & 7) as u16;
        tile = WRECK_SPIN_TILE[step];
        f = face ^ WRECK_SPIN_FLIP[step];
    }
    let sx: u16 = d & 0x01FF;
    let sy: u8 = (y >> 8) as u8;
    let mut attr: u16 = base;
    let mut near: u8 = tile;
    let mut far_: u8 = tile + 2;
    if f != 0 {
        attr = base | 0x4000;             // OAM hflip, the cells swapped
        near = tile + 2;
        far_ = tile;
    }
    let l: u16 = oam_take();
    let r: u16 = oam_take();
    if r < OAM_SLOTS {
        oam.set_full!(l as u8, sx, sy, (near as u16) | attr);
        oam.set_size!(l as u8, 1);
        oam.set_full!(r as u8, (sx + 16) & 0x01FF, sy, (far_ as u16) | attr);
        oam.set_size!(r as u8, 1);
    }
}

// Bank 3: the loss and the wreck's fall run a frame at a time at most,
// and bank 0 is full.
#[bank(3)]

// heli_lost - the airframe is gone. The next one starts from the pad
// with a full load; the last one is the match. High enough up, one of the
// men aboard bails out as a paratrooper; the rest go with it.
far fn heli_lost() {
    heli_wreck_x = heli_x_px + (HELI_W >> 1);
    heli_wreck_y = heli_y;
    heli_wreck_vy = Q10(0);
    if heli_vy > Q10(0) { heli_wreck_vy = heli_vy; }
    heli_wreck_face = heli_face_left;
    heli_wreck_vx = wreck_half(heli_vx);
    heli_wreck_sub = 0;
    sfx_at(SFX_CHN_LOST, SFX_EXPLODE_2, heli_wreck_x);
    fx_burst(FX_BIG, heli_wreck_x, heli_y >> 8);
    if heli_men > 0 && heli_y <= HELI_Y_BAIL {
        para_drop(heli_x_px + (HELI_W >> 2), heli_y, SIDE_PLAYER);
    }
    heli_lives = heli_lives - 1;
    if heli_lives == 0 {
        game_over(GAME_LOST);
    } else {
        heli_init();
        heli_dead = HELI_RESPAWN;
        heli_cam_step = div16(camera_x, HELI_RESPAWN - HELI_LOSS_HOLD) + 1;
    }
}

// wreck_half - half a speed, for a wreck: *v* / 2 toward zero. `>>` is
// logical, so the sign is a branch.
far fn wreck_half(v: Q10) -> Q10 {
    if v >= Q10(0) { return Q10(((v.0 as u16) >> 1) as i16); }
    return Q10(0) - Q10((((0 - v.0) as u16) >> 1) as i16);
}

// heli_wreck_tick - a frame of the wreck's fall, while it is in the air:
// dead-stick gravity down, and where it hits it goes up and is gone.
far fn heli_wreck_tick() {
    if heli_wreck_vy < HELI_VY_MAX { heli_wreck_vy = heli_wreck_vy + HELI_GRAVITY; }
    heli_wreck_y = heli_wreck_y + ((heli_wreck_vy.0 as u16) << 2);
    // Half the airframe's way on carries it the whole way down, stopping
    // only at the world's edges and on the ground.
    let d: i16 = heli_wreck_vx.0 << 2;      // 1/64 -> 1/256
    if d >= 0 {
        let m: u16 = d as u16;
        let s: u16 = (heli_wreck_sub as u16) + (m & 0x00FF);
        heli_wreck_sub = s as u8;
        heli_wreck_x = heli_wreck_x + (m >> 8) + (s >> 8);
        if heli_wreck_x > WORLD_W - (HELI_W >> 1) {
            heli_wreck_x = WORLD_W - (HELI_W >> 1);
            heli_wreck_vx = Q10(0);
        }
    } else {
        let m: u16 = (0 - d) as u16;
        let mut whole: u16 = m >> 8;
        let frac: u16 = m & 0x00FF;
        if (heli_wreck_sub as u16) < frac { whole = whole + 1; }
        heli_wreck_sub = heli_wreck_sub - (frac as u8);
        if heli_wreck_x <= whole + (HELI_W >> 1) {
            heli_wreck_x = HELI_W >> 1;
            heli_wreck_vx = Q10(0);
        } else {
            heli_wreck_x = heli_wreck_x - whole;
        }
    }
    if heli_wreck_y >= HELI_Y_MAX {
        heli_wreck_y = HELI_Y_MAX;
        heli_wreck_vx = Q10(0);
        // It goes up where it hits: a second big explosion, and the wreck
        // is gone (heli_draw draws it only in the air).
        sfx_at(SFX_CHN_BLAST, SFX_EXPLODE_1, heli_wreck_x);
        fx_spawn(FX_BIG, heli_wreck_x, GROUND_Y - 16);
    }
}

#[bank(0)]
