// unit - ground units: the pool, the march, traffic control and tank fire.
//
// Every unit sits on the same ground line, so they all compete for the same
// scanlines. That is the hardest constraint in the project, and it shapes
// two things here: units are culled to the camera window before they are
// given OAM slots, and the slots come from the shared importance-ordered
// allocator rather than a static base. Convoy spacing does the rest: at
// width + gap a 256 px window holds at most eight vehicles, sixteen
// sprites and twenty-four tiles on the line against the PPU's 32 and 34.
// (There were three 4 px lanes once, to stagger the rows; they bought
// little and let opposing columns in different lanes walk through each
// other, so they went.)
//
// A unit is three declarations that share one index:
//
//   Unit           what changes as it moves - position, hp, owner -
//                  plus its `kind`. One `#[soa]` record per pool slot.
//   UnitType       what it is: a tagged enum whose payload is that kind's
//                  own struct, so the payload plane holds whatever only that
//                  kind carries. The tag plane doubles as the free marker.
//   UnitStat       what is fixed about a kind: `unit_stats`, one ROM table
//                  per column, indexed by the tag.

#[bank(0)]

// 32 is what the frame holds with the whole pool live (tests/run.sh
// unit_budget); a bunched column of eight vehicles already puts 32 tiles
// on one scanline against the PPU's 34, so the sprite budget, not the
// CPU, is the ceiling from here.
const UNIT_MAX:  u16 = 32;
const UNIT_MASK: u16 = 31;
// Each side gets half the pool. Without this one side's column could
// take every slot and the other could not field a unit at all.
const UNIT_SIDE_MAX: u8 = 16;

// Geometry. Vehicles are 24x16 drawn across two 16x16 cells; a man is 8
// wide inside one cell.
const UNIT_W:      u16 = 24;
const UNIT_MAN_W:  u16 = 8;
const UNIT_H:      u16 = 16;

// Traffic control: a unit stops rather than piling into the one ahead.
// The plan puts the look-ahead at about a third of a unit width.
const UNIT_GAP: u16 = 8;

// Every unit stands with its feet on the ground line.
const UNIT_BASE_Y:     u16 = GROUND_Y - UNIT_H;
// The scanline band every ground unit occupies.
const UNIT_BAND_TOP:   u16 = GROUND_Y - UNIT_H;
const UNIT_BAND_BOT:   u16 = GROUND_Y;

// OBJ tiles: left cell of each 24x16 vehicle, right cell is +2.
const UNIT_TILE_TANK:     u8 = 38;
const UNIT_TILE_VAN:      u8 = 42;
const UNIT_TILE_LAUNCHER: u8 = 64;
const UNIT_TILE_INFANTRY: u8 = 68;
const UNIT_TILE_INFANTRY_FIRE: u8 = 70;   // rifle levelled, one frame per shot
const UNIT_TILE_ENGINEER: u8 = 68;        // infantry art until phase 12
const UNIT_ATTR: u16 = 0x3000;            // priority 3, OBJ palette 0
// How far mirrored art lands right of its box, from the sheet: a vehicle
// fills columns 0-23 of its 32-px pair, so mirrored it fills 8-31; a man
// stands in columns 2-7 of his cell, mirrored 8-13.
const UNIT_MIRROR_VEH: u16 = 8;
const UNIT_MIRROR_MAN: u16 = 6;

// Tank main gun.
const TANK_RANGE:  u16 = 96;
const TANK_RELOAD: u8  = 90;
const SHELL_SPEED: Q10 = 6 * 64;
const SHELL_LIFE:  u8  = 32;
const TANK_SCAN:   u8  = 16;              // frames between target sweeps: a
                                          // sweep is O(pool), and at 8 it was
                                          // an eighth of a full-field frame

// Infantry rifle. No round is spawned: a man's shot lands the frame he
// fires it, and the firing pose is what shows for it. Short reach, so a
// column closes before it opens up, and a slower rate than the tank's
// only looks it - five men fire between them.
const INF_RANGE:  u16 = 64;
const INF_RELOAD: u8  = 48;
const INF_SCAN:   u8  = 16;               // as the tank's: a sweep is O(pool)

// Bomb blast reach, in pixels either side of the impact.
const BLAST_R: u16 = 20;

// Missile launcher: anti-air only. One helicopter of the other side
// within LAUNCHER_RANGE draws its missile - the base's homing kind - and
// the launcher is spent in the firing, as the roster has it.
const LAUNCHER_RANGE: u16 = 224;

// ------------------------------------------------------------ the kinds ---
// A payload struct carries whatever only that kind has, and its methods
// take the pool index as `self` - the payloads are `#[soa]`, so their
// fields are planes over the enum's data region and a method reaches
// them, and the shared planes, by that one index. The gun's reload timer
// used to be a pool-wide `unit_timer[16]` that four kinds out of five
// never touched; it belongs to Tank now. The kinds with nothing of their
// own are plain variants.
#[soa] struct Tank     { reload: u8,      // frames until the main gun is ready
                         hold:   u8,      // 1 while a building is under fire
                         target: u8 }     // the last sweep's nearest opposing unit
#[soa] struct Launcher { armed: u8 }      // 1 until its one missile is away
#[soa] struct Infantry { reload: u8,      // frames until the rifle is ready
                         pose:   u8 }     // 1 on the frame a shot is fired

// What a unit *is*, and what only that kind carries. `Free` is variant 0, so
// an empty slot is a zero tag, and the tag plane is stride 1 - "is this slot
// taken?" is one `LDA units__kind__tag,X`, with no scaling.
enum UnitType {
    Free,
    Tank(Tank),
    Van,
    Launcher(Launcher),
    Infantry(Infantry),
    Engineer,
}

// What to spawn. A tagged enum's variant has no value form - it cannot sit
// in a local, a parameter or a table - so the spawn order needs a plain
// fieldless enum and `unit_spawn` maps one to the other. The order is the
// HUD ring's, which is the plan's roster order; `order.r65` indexes its
// cost table by it.
enum Order { Van, Launcher, Tank, Infantry, Engineer, Heli }

// ------------------------------------------------------------ the stats ---
// Everything fixed about a kind, one row per `UnitType` variant in tag
// order, so `unit_stats[units[i].kind as u16]` is the row for that unit.
// `#[soa]` on an immutable static makes it one ROM table per column, so the
// discriminant (`LDA units__kind__tag,X`) indexes each column at the
// column's own width - a u8 column with no scaling at all - and a read is
// one `LDA.l unit_stats__col_data,X`. Read columns directly - there is no
// row to point at.
//
// Row 0 is `Free` and is never read - every caller tests for Free first -
// but the tag is the index, so it has to exist.
//
// Hit points are the plan's roster - the 1984/1991 numbers the damage table
// is balanced against.
#[soa]
struct UnitStat {
    speed:      u16,      // 1/256 px per frame
    width:      u16,      // collision and traffic-control reach
    tile:       u8,       // left OBJ cell
    max_hp:     u8,
    cells:      u8,       // OBJ cells across: 1 for a man, 2 for a vehicle
    bullet_dmg: u8,       // helicopter gunfire; shell and blast do not vary
    rifle_dmg:  u8,       // infantry gunfire: nothing at all against armour
}

static unit_stats: [UnitStat; 6] = [
    // Free
    UnitStat { speed: 0,   width: 0,          tile: 0, max_hp: 0,  cells: 0, bullet_dmg: 0, rifle_dmg: 0 },
    // Tank: 0.5 px/frame; armour shrugs off gunfire
    UnitStat { speed: 128, width: UNIT_W,     tile: UNIT_TILE_TANK, max_hp: 25, cells: 2, bullet_dmg: 1, rifle_dmg: 0 },
    // Van: unarmed - the win condition
    UnitStat { speed: 192, width: UNIT_W,     tile: UNIT_TILE_VAN, max_hp: 12, cells: 2, bullet_dmg: 2, rifle_dmg: 2 },
    // Launcher: AA only, once aircraft exist
    UnitStat { speed: 128, width: UNIT_W,     tile: UNIT_TILE_LAUNCHER, max_hp: 8,  cells: 2, bullet_dmg: 2, rifle_dmg: 2 },
    // Infantry
    UnitStat { speed: 64,  width: UNIT_MAN_W, tile: UNIT_TILE_INFANTRY, max_hp: 5,  cells: 1, bullet_dmg: 2, rifle_dmg: 2 },
    // Engineer: an infantryman who repairs and claims turrets instead of
    // capturing bunkers - the same body, a different job, and no rifle
    UnitStat { speed: 64,  width: UNIT_MAN_W, tile: UNIT_TILE_ENGINEER, max_hp: 5,  cells: 1, bullet_dmg: 2, rifle_dmg: 2 },
];

// ---------------------------------------------------------------- state ---
// What changes as a unit moves, and what it is, paired by the type rather
// than by two arrays agreeing to use the same index.
//
// Measured: an AoS record costs 0.75 ticks/frame against 1.00 for planes,
// and hoisting a pointer to kill the index shifts recovered only 0.02 of
// that. What is left is the addressing mode - a plane read compiles to
// `LDA abs,X`, the cheapest indexed load on this CPU, while a record field
// goes through pointer indirection. `#[soa]` keeps that property while
// letting the fields be one declaration: `units[i].hp` is `LDA units__hp,X`,
// and `kind` contributes its own tag and payload planes, so
// `units__kind__tag` keeps its stride of 1.
#[soa]
struct Unit {
    x_px:  u16,
    x_sub: u8,           // 1/256 px accumulator
    hp:    u8,
    owner: u8,
    block: u8,           // cached traffic-control flag
    rank:  u8,           // the plan's promotion count; nothing earns it yet
    kind:  UnitType,
}

#[lowram] static mut units: [Unit; 32];

#[lowram] static mut unit_cursor: u16;
#[lowram] static mut unit_slice: u16;         // rolling traffic-control cursor

// Traffic control is O(n^2) over the pool. Measured on hardware, a full
// pass every frame costs more than a whole frame: with a 16-slot pool
// filled the loop ran at 0.45 ticks per vblank. Re-evaluating a slice
// instead leaves a unit's flag stale - with 32 slots and four a frame, up
// to seven frames, which at 0.5-0.75 px/frame is 4-6 px of overshoot
// against an 8 px gap: a column packs tighter but never overlaps. Eight
// a frame was 26% of the frame once the structures came in.
const UNIT_SLICE: u16 = 4;

// Neither pool takes an initializer, so both are garbage at power-on and
// every element must be written before anything matches on it.
// unit_free - retire a slot. `Free` is tag 0, so every liveness test in
// the hot loops is one load of the tag plane and a branch on zero.
fn unit_free(i: u16) {
    units[i].kind = UnitType::Free;
    unit_side_count[units[i].owner as u16] = unit_side_count[units[i].owner as u16] - 1;
}

// Live units per side, kept exact by unit_spawn and unit_free.
#[lowram] static mut unit_side_count: [u8; 2];

far fn unit_init() {
    for i in 0..UNIT_MAX {
        units[i].kind = UnitType::Free;
    }
    unit_side_count[0] = 0;
    unit_side_count[1] = 0;
    unit_cursor = 0;
    unit_slice = 0;
    spawn_t = SPAWN_PERIOD;
    spawn_seq = 0;
}

// unit_spawn - put a unit on the field. Returns 1, or 0 with nothing
// placed when the pool is full, the side has its UNIT_SIDE_MAX out, or
// the gate is still occupied - a unit of that side within a convoy
// space of the spawn point - so an order waits rather than being lost,
// and men leave the base one at a time instead of five in a heap.
far fn unit_spawn(kind: Order, owner: u8, x_px: u16) -> u8 {
    if unit_side_count[owner as u16] >= UNIT_SIDE_MAX { return 0; }
    if unit_gate_busy(owner, x_px) != 0 { return 0; }
    let mut i: u16 = unit_cursor;
    let mut n: u16 = 0;
    let mut placed: u8 = 0;
    while n < UNIT_MAX {
        match units[i].kind {
            UnitType::Free => {
                // The one place an Order becomes a variant. A tank starts
                // loaded; the other kinds carry nothing to initialise. A
                // helicopter is not a ground unit and never reaches here.
                match kind {
                    Order::Tank     => { units[i].kind = UnitType::Tank(Tank { reload: 0, hold: 0, target: UNIT_MAX as u8 }); }
                    Order::Van      => { units[i].kind = UnitType::Van; }
                    Order::Launcher => { units[i].kind = UnitType::Launcher(Launcher { armed: 1 }); }
                    Order::Infantry => { units[i].kind = UnitType::Infantry(Infantry { reload: 0, pose: 0 }); }
                    Order::Engineer => { units[i].kind = UnitType::Engineer; }
                    Order::Heli     => { return 0; }
                };
                units[i].owner = owner;
                units[i].x_px = x_px;
                units[i].x_sub = 0;
                units[i].hp = unit_stats[units[i].kind as u16].max_hp;
                units[i].block = 0;
                units[i].rank = 0;
                unit_cursor = (i + 1) & UNIT_MASK;
                unit_side_count[owner as u16] = unit_side_count[owner as u16] + 1;
                placed = 1;
                n = UNIT_MAX;
            }
            _ => {
                i = (i + 1) & UNIT_MASK;
                n = n + 1;
            }
        };
    }
    return placed;
}

// unit_gate_busy - is a unit of *owner* still within UNIT_W + UNIT_GAP of
// *x*? The base's gate: the next one out waits for it to clear.
fn unit_gate_busy(owner: u8, x: u16) -> u8 {
    for j in 0..UNIT_MAX {
        if units[j].kind as u8 != UnitType::Free as u8 {
            if units[j].owner == owner {
                let ux: u16 = units[j].x_px;
                let mut d: u16 = 0;
                if ux > x { d = ux - x; } else { d = x - ux; }
                if d < UNIT_W + UNIT_GAP { return 1; }
            }
        }
    }
    return 0;
}

// unit_count - how many of a kind one side has on the field. `Free` is
// variant 0 and never an owner's, so it needs no special case. The
// ordering caps count men, and engineers share the infantry cap, so the
// two kinds count together.
far fn unit_count(kind: Order, owner: u8) -> u8 {
    let mut n: u8 = 0;
    for i in 0..UNIT_MAX {
        if units[i].owner == owner {
            let t: u8 = units[i].kind as u8;
            let mut hit: u8 = 0;
            match kind {
                Order::Van      => { if t == UnitType::Van      as u8 { hit = 1; } }
                Order::Launcher => { if t == UnitType::Launcher as u8 { hit = 1; } }
                Order::Tank     => { if t == UnitType::Tank     as u8 { hit = 1; } }
                Order::Infantry => { if t == UnitType::Infantry as u8 { hit = 1; }
                                     if t == UnitType::Engineer as u8 { hit = 1; } }
                Order::Engineer => { if t == UnitType::Infantry as u8 { hit = 1; }
                                     if t == UnitType::Engineer as u8 { hit = 1; } }
                Order::Heli     => {}
            };
            n = n + hit;
        }
    }
    return n;
}

// unit_blocked - is another unit close ahead?
//
// Two jobs in one test. Behind the line it is convoy spacing: units stop
// rather than walking through each other, which is what makes a column read
// as a column. At the line it is the front itself - an advancing column
// meeting an opposing one halts and fights instead of the two sliding
// through each other. So this deliberately does not care whose unit is
// ahead, only that something is. (A tank is the exception - see
// unit_blocked_tank.)
fn unit_blocked(self_i: u16) -> u8 {
    let x: u16 = units[self_i].x_px;
    let mine: u8 = units[self_i].owner;
    let reach: u16 = unit_stats[units[self_i].kind as u16].width + UNIT_GAP;

    // The tag load is the whole filter: a free slot is tag 0, and a unit
    // is never strictly ahead of itself, so neither needs a test of its
    // own. This is the hottest loop in the game - O(n) per unit,
    // UNIT_SLICE units a frame - and its shape is what keeps the counter
    // in a register; change it and measure (unit_budget).
    for j in 0..UNIT_MAX {
        if units[j].kind as u8 != UnitType::Free as u8 {
            if mine == SIDE_PLAYER {
                if units[j].x_px > x {
                    if units[j].x_px - x < reach { return 1; }
                }
            } else {
                if x > units[j].x_px {
                    if x - units[j].x_px < reach { return 1; }
                }
            }
        }
    }
    return 0;
}

// unit_blocked_tank - unit_blocked for a tank: the same test, except that
// a hit that is one of the other side's men does not stop it - a tank
// drives over men (unit_fire's crush). A copy rather than a flag in
// unit_blocked: any extra shape in that function cost the hot loop its
// register-promoted counter (measured: 340 frames in 3665).
fn unit_blocked_tank(self_i: u16) -> u8 {
    let x: u16 = units[self_i].x_px;
    let mine: u8 = units[self_i].owner;
    let reach: u16 = UNIT_W + UNIT_GAP;

    for j in 0..UNIT_MAX {
        if units[j].kind as u8 != UnitType::Free as u8 {
            if mine == SIDE_PLAYER {
                if units[j].x_px > x {
                    if units[j].x_px - x < reach {
                        if units[j].owner == mine { return 1; }
                        if units[j].kind as u8 < UnitType::Infantry as u8 { return 1; }
                    }
                }
            } else {
                if x > units[j].x_px {
                    if x - units[j].x_px < reach {
                        if units[j].owner == mine { return 1; }
                        if units[j].kind as u8 < UnitType::Infantry as u8 { return 1; }
                    }
                }
            }
        }
    }
    return 0;
}

// unit_advance - move one unit along its heading by a 1/256 px step.
fn unit_advance(i: u16, step: u16) {
    if units[i].owner == SIDE_PLAYER {
        let t: u16 = (units[i].x_sub as u16) + (step & 0x00FF);
        units[i].x_sub = t as u8;
        units[i].x_px = units[i].x_px + (step >> 8) + (t >> 8);
        if units[i].x_px >= WORLD_W { unit_free(i); }
    } else {
        let mut whole: u16 = step >> 8;
        let frac: u16 = step & 0x00FF;
        if (units[i].x_sub as u16) < frac { whole = whole + 1; }
        units[i].x_sub = units[i].x_sub - (frac as u8);
        if units[i].x_px <= whole {
            unit_free(i);
        } else {
            units[i].x_px = units[i].x_px - whole;
        }
    }
}

// unit_target - nearest opposing unit within *range* ahead of unit *self_i*.
fn unit_target(self_i: u16, range: u16) -> u16 {
    let x: u16 = units[self_i].x_px;
    let mine: u8 = units[self_i].owner;
    let mut best: u16 = UNIT_MAX;
    let mut best_d: u16 = range;

    for j in 0..UNIT_MAX {
        match units[j].kind {
            UnitType::Free => {}
            _ => {
                if units[j].owner != mine {
                    let mut d: u16 = 0;
                    let mut ahead: u8 = 0;
                    if mine == SIDE_PLAYER {
                        if units[j].x_px > x { d = units[j].x_px - x; ahead = 1; }
                    } else {
                        if x > units[j].x_px { d = x - units[j].x_px; ahead = 1; }
                    }
                    if ahead != 0 {
                        if d < best_d { best_d = d; best = j; }
                    }
                }
            }
        };
    }
    return best;
}

// The rifle. A man's shot is not a munition: the sweep that finds a
// target lands the damage there and then, and the pose flag shows the
// shot for the one frame it is drawn. The damage is the target kind's
// rifle_dmg, which is what keeps infantry from scratching a tank; an
// enemy turret is the fallback target, for the roster's half point.
impl Infantry {
    fn fire(self) {
        self.pose = 0;
        if self.reload > 0 {
            self.reload = self.reload - 1;
        } else {
            let j: u16 = unit_target(self, INF_RANGE);
            if j < UNIT_MAX {
                self.reload = INF_RELOAD;
                self.pose = 1;
                unit_hit(j, unit_stats[units[j].kind as u16].rifle_dmg);
            } else {
                // No unit: an enemy turret ahead takes the shot instead.
                let t: u16 = struct_rifle_target(units[self].x_px, units[self].owner, INF_RANGE);
                if t < STRUCT_MAX {
                    self.reload = INF_RELOAD;
                    self.pose = 1;
                    struct_rifle_hit(t);
                } else {
                    self.reload = INF_SCAN;
                }
            }
        }
    }
}

// unit_fire - the main gun. Only a tank carries one, and the reload timer it
// counts down is the tank's own payload - so this is a no-op for every other
// kind without a flag to ask about first.
//
// Targets are the other side's units ahead and, since tanks are the one
// thing that can bring down a turret or a bunker, its standing buildings
// too. A unit is fought from wherever the front halted; a building holds
// the tank in place until it falls, as in Armor Alley, or it would drive
// past after two shells against a bunker's 69 hp. The hold is decided on
// the same sweep as the shot and folded into the traffic flag by the
// slice refresh, so it can be a reload stale once the building is down
// and a few frames late taking effect.
fn unit_fire(i: u16) {
    match units[i].kind {
        UnitType::Tank(t) => {
            if t.reload > 0 {
                t.reload = t.reload - 1;
            } else {
                t.hold = struct_tank_target(units[i].x_px, units[i].owner, TANK_RANGE);
                let j: u16 = unit_target(i, TANK_RANGE);
                t.target = j as u8;
                if t.hold == 0 && j >= UNIT_MAX {
                    // Nothing in reach. Wait before sweeping the pool again
                    // rather than paying for a scan on every frame of an
                    // empty field.
                    t.reload = TANK_SCAN;
                } else {
                    t.reload = TANK_RELOAD;
                    let mut v: Q10 = SHELL_SPEED;
                    let mut mx: u16 = units[i].x_px + UNIT_W;
                    if units[i].owner == SIDE_ENEMY {
                        v = Q10(0) - SHELL_SPEED;
                        mx = units[i].x_px;
                    }
                    let y: u16 = (UNIT_BASE_Y + 4) << 8;
                    muni_spawn(MUNI_SHELL, mx, y, v, Q10(0), SHELL_LIFE,
                               units[i].owner);
                }
            }
            if t.target < UNIT_MAX as u8 {
                let j: u16 = t.target as u16;
                if units[j].kind as u8 == UnitType::Free as u8 {
                    // The target fell (a shell, or these tracks) with the
                    // gun still reloading: pick the next one now rather
                    // than drive through a column blind for 90 frames.
                    t.target = unit_target(i, TANK_RANGE) as u8;
                } else {
                    if units[j].owner != units[i].owner
                       && units[j].kind as u8 >= UnitType::Infantry as u8 {
                        let x: u16 = units[i].x_px;
                        let ux: u16 = units[j].x_px;
                        if ux + UNIT_MAN_W > x && ux < x + UNIT_W {
                            unit_free(j);
                            t.target = unit_target(i, TANK_RANGE) as u8;
                        }
                    }
                }
            }
        }
        _ => {}
    };
}

// The launcher's one shot. `self` is the pool index, so the shared planes
// are `units[self].*` and its own field `self.armed`. The player's
// airframe is the only helicopter until phase 10, so an enemy launcher
// watches for it and a player's has nothing to fire at yet.
impl Launcher {
    fn launch(self) {
        if self.armed == 0 { return; }
        if units[self].owner != SIDE_ENEMY { return; }
        let lx: u16 = units[self].x_px + (UNIT_W >> 1);
        let hx: u16 = heli_x_px + (HELI_W >> 1);
        let mut d: u16 = 0;
        if hx > lx { d = hx - lx; } else { d = lx - hx; }
        if d < LAUNCHER_RANGE {
            self.armed = 0;
            muni_spawn(MUNI_MISSILE, lx, (UNIT_BASE_Y - 8) << 8, Q10(0),
                       Q10(0) - MISSILE_SPEED, MISSILE_LIFE, units[self].owner);
            unit_free(self);
        }
    }
}

// ---------------------------------------------------------------- spawn ---
// Units come out of each side's base. The player's come from orders
// (order.r65). The CPU opponent arrives in phase 10; until then the enemy
// base sends a rotating column so the field populates and a front forms.
const BASE_X_PLAYER: u16 = 512;
const BASE_X_ENEMY:  u16 = 7680;
const SPAWN_PERIOD:  u8  = 120;

// Launcher-heavy - half the column is missile trucks, so the homing
// missile gets exercised on every approach. It began as a testing
// rotation (the balanced one is Tank, Infantry, Van, Launcher) but the
// suite's unit, structure and budget cases are all pinned against this
// column now, and phase 10's convoy table replaces it anyway.
static SPAWN_ORDER: [Order; 8] = [Order::Launcher, Order::Tank, Order::Launcher,
                                  Order::Infantry, Order::Launcher, Order::Van,
                                  Order::Launcher, Order::Launcher];

#[lowram] static mut spawn_t:   u8;
#[lowram] static mut spawn_seq: u8;

far fn unit_spawn_tick() {
    if spawn_t > 0 {
        spawn_t = spawn_t - 1;
    } else {
        spawn_t = SPAWN_PERIOD;
        let k: Order = SPAWN_ORDER[(spawn_seq & 7) as u16];
        unit_spawn(k, SIDE_ENEMY, BASE_X_ENEMY);
        spawn_seq = spawn_seq + 1;
    }
}

// unit_update - one tick for the whole pool.
far fn unit_update() {
    unit_spawn_tick();

    // Refresh the traffic-control flags for this frame's slice only.
    for k in 0..UNIT_SLICE {
        let i: u16 = unit_slice;
        match units[i].kind {
            UnitType::Free    => {}
            UnitType::Tank(t) => { units[i].block = unit_blocked_tank(i) | t.hold; }
            _                 => { units[i].block = unit_blocked(i); }
        };
        unit_slice = (unit_slice + 1) & UNIT_MASK;
    }

    for i in 0..UNIT_MAX {
        match units[i].kind {
            UnitType::Free => {}
            _ => {
                // Only a tank has a gun, a launcher a missile and a man a
                // rifle; the tag tests here are cheaper than the calls
                // that would make them.
                match units[i].kind {
                    UnitType::Tank(_)     => { unit_fire(i); }
                    UnitType::Launcher(l) => { l.launch(); }
                    UnitType::Infantry(f) => { f.fire(); }
                    _ => {}
                };
                if units[i].block == 0 {
                    unit_advance(i, unit_stats[units[i].kind as u16].speed);
                }
            }
        };
    }
}

// unit_draw - place the units inside the camera window.
//
// Culling here is the big lever: the simulation carries every unit in the
// pool, but only what is actually on screen consumes OAM. Draw order runs
// from the camera centre outward, so when slots run out the sprites that
// vanish are the ones furthest from where the player is looking.
// Visible units this frame, split by distance from the camera centre so
// the near ones take slots first. Classifying once and drawing from the
// lists is half the cost of culling the pool twice.
#[lowram] static mut draw_near: [u8; 32];
#[lowram] static mut draw_far:  [u8; 32];

fn unit_draw_one(i: u16, sx: u16) {
    let y: u8 = UNIT_BASE_Y as u8;
    let mut tile: u8 = unit_stats[units[i].kind as u16].tile;
    let cells: u8 = unit_stats[units[i].kind as u16].cells;
    match units[i].kind {
        UnitType::Infantry(f) => { if f.pose != 0 { tile = UNIT_TILE_INFANTRY_FIRE; } }
        _ => {}
    };

    // The enemy faces west - hflip - and wears the enemy palette.
    // Mirroring a vehicle also swaps its two cells, or the front half
    // renders on the tail side - and it moves the art within its box, so
    // the box shifts back to keep the sprite over the collision extent
    // (`UNIT_MIRROR_*`).
    let mut attr: u16 = UNIT_ATTR;
    let mut near: u8 = tile;
    let mut far_: u8 = tile + 2;
    let mut bx: u16 = sx & 0x01FF;
    if units[i].owner == SIDE_ENEMY {
        attr = UNIT_ATTR | 0x4000 | OBJ_PAL_ENEMY;
        if cells > 1 {
            near = tile + 2;
            far_ = tile;
            bx = (sx - UNIT_MIRROR_VEH) & 0x01FF;
        } else {
            bx = (sx - UNIT_MIRROR_MAN) & 0x01FF;
        }
    }

    let a: u16 = oam_take();
    if a < OAM_SLOTS {
        oam.set_full!(a as u8, bx, y, (near as u16) | attr);
        oam.set_size!(a as u8, 1);
    }
    // A man is one cell; a vehicle needs its second.
    if cells > 1 {
        let c: u16 = oam_take();
        if c < OAM_SLOTS {
            oam.set_full!(c as u8, (bx + 16) & 0x01FF, y,
                          (far_ as u16) | attr);
            oam.set_size!(c as u8, 1);
        }
    }
}

far fn unit_draw() {
    let centre: u16 = camera_x + CAM_MID;
    let mut n_near: u16 = 0;
    let mut n_far: u16 = 0;
    for i in 0..UNIT_MAX {
        if units[i].kind as u8 != UnitType::Free as u8 {
            let sx: u16 = units[i].x_px - camera_x;
            // On screen if the left edge is inside the window, or the unit
            // straddles the window's left edge: sx has wrapped to $FFxx and
            // the 9-bit OAM X carries it as a negative position. A vehicle
            // is 24 px, a man 8; the wider bound serves both.
            if sx < 256 || sx >= (0 - UNIT_W) {
                let mut d: u16 = 0;
                if units[i].x_px > centre {
                    d = units[i].x_px - centre;
                } else {
                    d = centre - units[i].x_px;
                }
                if d < 64 {
                    draw_near[n_near] = i as u8;
                    n_near = n_near + 1;
                } else {
                    draw_far[n_far] = i as u8;
                    n_far = n_far + 1;
                }
            }
        }
    }
    for k in 0..n_near {
        let i: u16 = draw_near[k] as u16;
        unit_draw_one(i, units[i].x_px - camera_x);
    }
    for k in 0..n_far {
        let i: u16 = draw_far[k] as u16;
        unit_draw_one(i, units[i].x_px - camera_x);
    }
}

// --------------------------------------------------------------- combat ---
// The damage asymmetry, from the munition's side. These numbers are what
// make composition matter, so they are spelled out per pair rather than
// folded into one "power" value - the whole point is that the same weapon is
// decisive against one target and useless against another.
//
// Only gunfire varies by target, so that column is the kind's; a shell and
// a blast do the same damage to anything they reach.
//
// Rows that need targets this phase does not have yet (turrets, super and
// end bunkers) arrive with those structures; the shape is here for them.
fn unit_damage_for(mk: u8, i: u16) -> u8 {
    if mk == MUNI_SHELL {
        return 8;                         // the anti-armour tool
    }
    if mk == MUNI_BULLET {
        return unit_stats[units[i].kind as u16].bullet_dmg;
    }
    if mk == MUNI_BLAST {
        return 25;                        // a bomb kills what it lands on
    }
    return 0;
}

// unit_hit - apply damage and retire the unit if it runs out of hit points.
fn unit_hit(i: u16, dmg: u8) {
    if dmg > 0 {
        if units[i].hp > dmg {
            units[i].hp = units[i].hp - dmg;
        } else {
            unit_free(i);
        }
    }
}

// unit_collide - munitions against units, and gunfire against bombs.
//
// Runs after both pools have moved, so a round and its target are compared
// at the same instant rather than a frame apart.
far fn unit_collide() {
    for m in 0..MUNI_MAX {
        let mk: u8 = muni_kind[m];
        if mk != MUNI_FREE {
            let mx: u16 = muni_x_px[m];
            let my: u16 = muni_y[m] >> 8;

            // A blast reaches everything standing near where the bomb fell,
            // friend included - a bomb does not check sides.
            if mk == MUNI_BLAST {
                for i in 0..UNIT_MAX {
                    match units[i].kind {
                        UnitType::Free => {}
                        _ => {
                            let ux: u16 = units[i].x_px;
                            let mut d: u16 = 0;
                            if ux > mx { d = ux - mx; } else { d = mx - ux; }
                            if d < BLAST_R {
                                unit_hit(i, unit_damage_for(mk, i));
                            }
                        }
                    };
                }
                muni_kind[m] = MUNI_FREE;
            } else {
                // Gunfire can shoot a bomb down. Checked before units so a
                // round crossing both resolves against the bomb - and only
                // while a bomb is in the air: with a full pool of rounds
                // this was 256 slot checks a frame, by itself over budget.
                if mk == MUNI_BULLET && muni_bombs != 0 {
                    for b in 0..MUNI_MAX {
                        if muni_kind[b] == MUNI_BOMB {
                            let bx: u16 = muni_x_px[b];
                            let by: u16 = muni_y[b] >> 8;
                            let mut dx: u16 = 0;
                            if bx > mx { dx = bx - mx; } else { dx = mx - bx; }
                            let mut dy: u16 = 0;
                            if by > my { dy = by - my; } else { dy = my - by; }
                            if dx < 8 {
                                if dy < 8 {
                                    muni_drop_bomb(b);
                                    muni_kind[b] = MUNI_FREE;
                                    muni_kind[m] = MUNI_FREE;
                                }
                            }
                        }
                    }
                }

                // Everything on the ground stands in one narrow band of
                // scanlines. A round above it cannot hit anything, and most
                // of the airframe's fire is above it - so test the band once
                // per munition rather than once per unit. Measured: this is
                // the difference between 0.77 and 1.00 ticks/frame under
                // sustained fire.
                if muni_kind[m] != MUNI_FREE
                   && my >= UNIT_BAND_TOP && my < UNIT_BAND_BOT {
                    for i in 0..UNIT_MAX {
                        match units[i].kind {
                            UnitType::Free => {}
                            _ => {
                                if units[i].owner != muni_owner[m] {
                                    let ux: u16 = units[i].x_px;
                                    // The band was tested once above; the
                                    // x extent is all that is left.
                                    if mx >= ux {
                                        if mx < ux + unit_stats[units[i].kind as u16].width {
                                            unit_hit(i, unit_damage_for(mk, i));
                                            muni_kind[m] = MUNI_FREE;
                                        }
                                    }
                                }
                            }
                        };
                    }
                }
            }
        }
    }
}
