// hud - the strip along the top of the screen, and the one along the
// bottom.
//
// BG3 is a 32x32 map DMA'd from ROM at boot. The match is on the top two
// tile rows, the airframe on the bottom one:
//
//   row 0   $ purse, lives, men aboard
//   row 1   the radar (radar.r65): a row of tiles the game draws into
//   row 27  the airframe: the health bar, the fuel bar, gun rounds,
//           bombs, missiles - over the dirt, where nothing else is drawn
//
// The order ring that used to sit on row 0 is the L dialog's now. Rows 0
// and 27 are composed into one shadow and DMA'd to VRAM in vblank when
// something on them changed - 64 bytes each, so the cost is nothing, but
// there is no reason to pay it on a frame where nothing moved.
//
// Those two rows are the status rows, drawn from their own sheet (STAT_*
// below): a bold two-tone font with a drop shadow and gradient meters, in
// BG3 sub-palettes 5-7, transparent around the ink so they float over the
// sky and the dirt. Everything else on BG3 - the radar, the order menu,
// the alert box, the battle-over line - is the HUD art's.
//
// Glyphs live on map row HUD_GLYPH_ROW of hud.tilemap.bmp, below the 224 scanlines
// the screen shows. bmp2chr de-duplicates tiles, so their IDs are whatever
// it decided; rather than hard-code them, the strip is read back out of the
// tilemap in ROM - the glyph's *position* on that row is the contract, and
// tools/hud_glyphs.py keeps it.

#[bank(2)]

const HUD_GLYPH_ROW: u16 = 28;

// Glyph positions on the strip, in tools/hud_glyphs.py order.
const GLYPH_DIGIT:    u16 = 0;            // 0..9
const GLYPH_DOLLAR:   u16 = 10;
const GLYPH_LBRACKET: u16 = 11;
const GLYPH_RBRACKET: u16 = 12;
const GLYPH_ICON:     u16 = 13;           // + Order, in ring order
// Capitals on the row below: tile (HUD_LETTER_ROW * 32 + c - 'A').
const HUD_LETTER_ROW: u16 = 29;
// And the order overlay's box on the row below that, in this order.
const HUD_BOX_ROW: u16 = 30;
const BOX_TL: u16 = 0;
const BOX_TR: u16 = 1;
const BOX_BL: u16 = 2;
const BOX_BR: u16 = 3;
const BOX_T:  u16 = 4;
const BOX_B:  u16 = 5;
const BOX_L:  u16 = 6;
const BOX_R:  u16 = 7;
const BOX_CURSOR: u16 = 8;
const BOX_BAR:    u16 = 9;                // + 0..4: a cell 0/2/4/6/8 px full

// The status rows' sheet, status.tilemap.bmp (tools/status_art.py, which
// keeps these positions): 8-bit art in CGRAM indices, so each tile's map
// word carries its sub-palette - gold (5, CGRAM 20-23) for the labels, red
// (6) and white (7, the digits and icons) - and the meters' cells take
// theirs in turn, red to white, which is the gradient. Its tiles go up past
// the order menu's icons (the Makefile names them from there); its palette
// is entries 20-31 of its .pal.
const STAT_DIGIT:  u16 = 0;               // 0..9
const STAT_DOLLAR: u16 = 10;
const STAT_H:      u16 = 11;
const STAT_F:      u16 = 12;
const STAT_GUN:    u16 = 13;              // the gun's rounds, an icon
const STAT_BOMB:   u16 = 14;              // and the bombs'
const STAT_HELI:   u16 = 15;
const STAT_MAN:    u16 = 16;
const STAT_CAP_L:  u16 = 17;              // a meter's ends
const STAT_CAP_R:  u16 = 18;
const STAT_BLANK:  u16 = 31;              // transparent
const STAT_METER:  u16 = 1;               // + cell: that cell's row, fills 0-8 px at columns 0-4
const STAT_TILE0:  u16 = ICON_TILE0 + (ICONS_CHR_SIZE >> 4);
const STAT_CGRAM:  u16 = 20;              // sub-palettes 5-7
const STAT_COLORS: u16 = 12;

// Row 0 layout, in tile columns: "$NN", the airframe icon and lives, the
// man icon and the men aboard.
const HUD_COL_FUNDS:  u16 = 0;
const HUD_COL_LIVES:  u16 = 4;
const HUD_COL_MEN:    u16 = 7;
// The bottom row (map row HUD_BOTTOM_ROW, the shadow's second 32 words):
// "H[......]" and "F[......]" - six-cell meters, 48 px each - then the
// gun's icon and "NN", and the bomb's and "NN". (Columns 30-31 held the smart missiles' "MN" until they were
// taken out of the game.)
const HUD_BOTTOM_ROW: u16 = 27;
const HUD_COL_HEALTH: u16 = 0;
const HUD_COL_FUEL:   u16 = 10;
const HUD_BAR_CELLS:  u16 = 6;
const HUD_COL_GUN:    u16 = 20;
const HUD_COL_BOMBS:  u16 = 25;

// The HUD art's blank tile is whatever the art has at (0,0): plain navy -
// the order menu's and the alert box's background. It carries the priority
// bit every word read out of the map does (the Makefile sets it on the
// HUD's tilemap): on BG3 without it the dirt would show through.
const HUD_BLANK: u16 = 0x2000;

#[lowram] static mut hud_row:   [u16; 64];    // row 0, then the bottom row
#[lowram] static mut hud_dirty: u8;
#[lowram] static mut hud_clear2: u8;          // map row 2, the art's navy, to clear once
// What the rows currently show, so a frame with no change is free.
#[lowram] static mut hud_funds: u8;
#[lowram] static mut hud_lives: u8;
#[lowram] static mut hud_hp:    u8;
#[lowram] static mut hud_fuel:  u8;
#[lowram] static mut hud_gun:   u8;
#[lowram] static mut hud_bombs: u8;
#[lowram] static mut hud_men:   u8;

// hud_glyph - the tile word for glyph *n*, out of the map row in ROM.
fn hud_glyph(n: u16) -> u16 {
    let i: u16 = ((HUD_GLYPH_ROW << 5) + n) << 1;
    return (HUD_MAP[i] as u16) | ((HUD_MAP[i + 1] as u16) << 8);
}

// hud_stat - the tile word at position *n* of the status sheet's map.
fn hud_stat(n: u16) -> u16 {
    let i: u16 = n << 1;
    return (STATUS_MAP[i] as u16) | ((STATUS_MAP[i + 1] as u16) << 8);
}

// hud_put2 - two decimal digits at *col*. Values are capped at 99 upstream.
fn hud_put2(col: u16, v: u8) {
    let tens: u8 = div8(v, 10);
    hud_row[col]     = hud_stat(STAT_DIGIT + (tens as u16));
    hud_row[col + 1] = hud_stat(STAT_DIGIT + ((v - mul8(tens, 10)) as u16));
}

// hud_bar - a meter's six cells at *col*, *px* of 48 filled: each cell its
// own row of the sheet, so its own palette.
fn hud_bar(col: u16, px: u16) {
    let mut left: u16 = px;
    if left > (HUD_BAR_CELLS << 3) { left = HUD_BAR_CELLS << 3; }
    for c in 0..HUD_BAR_CELLS {
        let mut n: u16 = left;
        if n > 8 { n = 8; }
        hud_row[col + c] = hud_stat(((STAT_METER + c) << 5) + (n >> 1));
        left = left - n;
    }
}

far fn hud_init() {
    let blank: u16 = hud_stat(STAT_BLANK);
    for c in 0..64 {
        hud_row[c] = blank;
    }
    // The fixed parts: labels, meter ends, icons.
    hud_row[HUD_COL_FUNDS] = hud_stat(STAT_DOLLAR);
    hud_row[HUD_COL_LIVES] = hud_stat(STAT_HELI);
    hud_row[HUD_COL_MEN] = hud_stat(STAT_MAN);
    hud_row[32 + HUD_COL_HEALTH] = hud_stat(STAT_H);
    hud_row[32 + HUD_COL_HEALTH + 1] = hud_stat(STAT_CAP_L);
    hud_row[32 + HUD_COL_HEALTH + 2 + HUD_BAR_CELLS] = hud_stat(STAT_CAP_R);
    hud_row[32 + HUD_COL_FUEL] = hud_stat(STAT_F);
    hud_row[32 + HUD_COL_FUEL + 1] = hud_stat(STAT_CAP_L);
    hud_row[32 + HUD_COL_FUEL + 2 + HUD_BAR_CELLS] = hud_stat(STAT_CAP_R);
    hud_row[32 + HUD_COL_GUN] = hud_stat(STAT_GUN);
    hud_row[32 + HUD_COL_BOMBS] = hud_stat(STAT_BOMB);
    // Force the first compose: no real state matches these.
    hud_funds = 0xFF;
    hud_lives = 0xFF;
    hud_hp = 0xFF;
    hud_fuel = 0xFF;
    hud_gun = 0xFF;
    hud_bombs = 0xFF;
    hud_men = 0xFF;
    hud_dirty = 0;
    hud_clear2 = 1;
    hud_msg_dirty = 0;
    hud_ov_dirty = 0;
    hud_ov_shown = 0;
    hud_ov_compose();
    alert_init();
    hud_update();
}

// hud_update - recompose whatever moved. Health is 20 hp over 48 px
// (2.5 px/hp, the last two clipped); fuel is 100 over 48 (half a pixel a
// unit, the last two clipped).
far fn hud_update() {
    if alert_busy != 0 { alert_tick(); }
    if hud_funds != funds {
        hud_funds = funds;
        hud_put2(HUD_COL_FUNDS + 1, funds);
        hud_dirty = 1;
    }
    if hud_lives != airframes[HELI].lives {
        // The last airframe: from more, not from the init's 0xFF.
        if airframes[HELI].lives == 1 && hud_lives > 1 && hud_lives != 0xFF { alert_push(ALERT_LAST_HELI); }
        hud_lives = airframes[HELI].lives;
        let mut n: u8 = airframes[HELI].lives;
        if n > 9 { n = 9; }
        hud_row[HUD_COL_LIVES + 1] = hud_stat(STAT_DIGIT + (n as u16));
        hud_dirty = 1;
    }
    if hud_hp != airframes[HELI].hp {
        let hp: u8 = airframes[HELI].hp;
        if hp != 0 && hp <= ALERT_HP_AT && hud_hp > ALERT_HP_AT && hud_hp != 0xFF { alert_push(ALERT_DAMAGE); }
        hud_hp = hp;
        hud_bar(32 + HUD_COL_HEALTH + 2, ((airframes[HELI].hp as u16) * 2) + ((airframes[HELI].hp as u16) >> 1));
        hud_dirty = 1;
    }
    if hud_fuel != airframes[HELI].fuel {
        let fuel: u8 = airframes[HELI].fuel;
        if hud_fuel != 0xFF {
            if fuel <= ALERT_CRIT_AT && hud_fuel > ALERT_CRIT_AT {
                alert_push(ALERT_FUEL_CRIT);
            } else if fuel <= ALERT_FUEL_AT && hud_fuel > ALERT_FUEL_AT {
                alert_push(ALERT_FUEL_LOW);
            }
        }
        hud_fuel = fuel;
        hud_bar(32 + HUD_COL_FUEL + 2, (airframes[HELI].fuel as u16) >> 1);
        hud_dirty = 1;
    }
    if hud_gun != airframes[HELI].gun {
        hud_gun = airframes[HELI].gun;
        hud_put2(32 + HUD_COL_GUN + 2, airframes[HELI].gun);
        hud_dirty = 1;
    }
    if hud_bombs != airframes[HELI].bombs {
        hud_bombs = airframes[HELI].bombs;
        hud_put2(32 + HUD_COL_BOMBS + 2, airframes[HELI].bombs);
        hud_dirty = 1;
    }
    if hud_men != player.men {
        hud_men = player.men;
        hud_row[HUD_COL_MEN + 1] = hud_stat(STAT_DIGIT + (player.men as u16));
        hud_dirty = 1;
    }
}

// -------------------------------------------------------------- message ---
// The battle-over line, on map row HUD_MSG_ROW - mid-screen, over the
// field, where BG3 is otherwise transparent. Composed into its own shadow
// from a ROM string of capitals and spaces, centred, and flushed once.
const HUD_MSG_ROW: u16 = 10;
const HUD_MSG_MAX: u16 = 32;

#[lowram] static mut hud_msg:       [u16; 32];
#[lowram] static mut hud_msg_dirty: u8;

// The tile the map has on the message row - whatever the art left there,
// read back rather than assumed, so clearing the line restores it.
fn hud_clear_tile() -> u16 {
    return (HUD_MAP[(HUD_MSG_ROW << 6)] as u16)
         | ((HUD_MAP[(HUD_MSG_ROW << 6) + 1] as u16) << 8);
}

// hud_letter - the tile word for a capital, or the clear tile for a space.
fn hud_letter(c: u8) -> u16 {
    if c == 0x20 { return hud_clear_tile(); }
    let i: u16 = ((HUD_LETTER_ROW << 5) + ((c - 0x41) as u16)) << 1;
    return (HUD_MAP[i] as u16) | ((HUD_MAP[i + 1] as u16) << 8);
}

// hud_message - show *len* capitals from *text*, centred; 0 clears. Far:
// the strings are ROM in the caller's bank, not this one's.
far fn hud_message(text: far *u8, len: u16) {
    let blank: u16 = hud_clear_tile();
    for c in 0..HUD_MSG_MAX {
        hud_msg[c] = blank;
    }
    let start: u16 = (HUD_MSG_MAX - len) >> 1;
    for k in 0..len {
        hud_msg[start + k] = hud_letter(text[k]);
    }
    hud_msg_dirty = 1;
}

// -------------------------------------------------------------- overlay ---
// The order menu, shown while L is held: the six units' 32x32 icons in a
// column down the left edge of BG3 (map rows MENU_ROW.., four apiece, in
// ring order), the selected one on a brighter panel with its name and cost
// beside it on its top row. The icons are BG3 tiles (icons.tilemap.bmp,
// tools/icon_art.py), uploaded past the front end's font at boot.
//
// The menu is composed into a shadow once, at init (composing it on the
// press cost a frame); a move rewrites only the two icons and the label,
// and flushes the rows from the old icon to the new. Hiding flushes an
// all-transparent twin. Map rows 23-25 are the alert box's too (alert.r65,
// from column 10), so there the flush writes only the menu's columns, and
// the label sits on an icon's top row - the last one's is row 22, above the
// box. Row 2, the art's navy, is cleared from the twin at boot. Pause and
// game_over hide the menu before writing the row-10 message.
const MENU_ROW:   u16 = 2;
const MENU_ROWS:  u16 = 24;               // six icons of four rows
const MENU_WIDE:  u16 = 21;               // rows 2-22 flush whole; below, the alert's
const MENU_NARROW: u16 = 10;              // ... columns of rows 23-25 the menu may write
const MENU_COL:   u16 = 1;                // the icons' first column
const MENU_LABEL: u16 = 5;                // the label's: past the icon
const ICON_TILE0: u16 = SCREEN_FONT_TILE + SCREEN_FONT_TILES;   // BG3 tile, past the font
const ICON_PAL:     u16 = 3;              // BG3 sub-palette: CGRAM 12-15
const ICON_PAL_SEL: u16 = 4;              // the selected icon's: CGRAM 16-19

#[ram] static mut hud_ov:       [u16; 768];   // MENU_ROWS map rows, the menu
#[ram] static mut hud_ov_clear: [u16; 768];   // ... and the same rows, empty
#[lowram] static mut hud_ov_dirty: u8;        // 1 flush the menu, 2 flush the clear
#[lowram] static mut hud_ov_lo:    u16;       // the shadow rows to flush
#[lowram] static mut hud_ov_hi:    u16;
#[lowram] static mut hud_ov_shown: u8;
#[lowram] static mut hud_ov_sel:   u8;        // the icon shown selected
#[lowram] static mut hud_ov_flash: u8;        // frames of a purchase's flash left

// A purchase answers on the menu: the icon bought goes between unselected
// and selected every MENU_BLINK frames for MENU_FLASH, unselected first,
// ending selected. Its label stays put.
const MENU_FLASH: u8 = 16;
const MENU_BLINK: u8 = 2;                     // a power of two: the phase is a bit

// hud_box - the tile word for box piece *n*.
fn hud_box(n: u16) -> u16 {
    let i: u16 = ((HUD_BOX_ROW << 5) + n) << 1;
    return (HUD_MAP[i] as u16) | ((HUD_MAP[i + 1] as u16) << 8);
}

// hud_icons_load - the icons' tiles and both their palettes, and the status
// rows' tiles and three palettes after them: boot, in force blank. The
// selected palette is the sheet's with a brighter panel.
far fn hud_icons_load() {
    dma_copy_vram(0, &STATUS_CHR as far *u8, VRAM_HUDC + (STAT_TILE0 << 3), STATUS_CHR_SIZE);
    let pal: far *u8 = &STATUS_PAL as far *u8;
    dma_copy_cgram(0, pal + (STAT_CGRAM << 1), STAT_CGRAM, STAT_COLORS << 1);
    dma_copy_vram(0, &ICONS_CHR as far *u8, VRAM_HUDC + (ICON_TILE0 << 3), ICONS_CHR_SIZE);
    dma_copy_cgram(0, &ICONS_PAL as far *u8, ICON_PAL << 2, 8);
    dma_copy_cgram(0, &ICONS_PAL as far *u8, ICON_PAL_SEL << 2, 8);
    set_cgram_addr!((ICON_PAL_SEL << 2) + 1);
    write_color!(Color::rgb!(8, 13, 21));
}

// hud_ov_icon - icon *k* into the shadow, on BG3 sub-palette *pal*.
fn hud_ov_icon(k: u16, pal: u16) {
    let attr: u16 = ICON_TILE0 | (pal << 10) | HUD_BLANK;   // HUD_BLANK: the priority bit
    for r in 0..4 {
        let row: u16 = (k << 2) + r;
        for c in 0..4 {
            let i: u16 = ((row << 2) + c) << 1;
            let t: u16 = (ICONS_MAP[i] as u16) | ((ICONS_MAP[i + 1] as u16) << 8);
            hud_ov[(row << 5) + MENU_COL + c] = t + attr;
        }
    }
}

// hud_ov_label - icon *k*'s name and cost beside it, or (*on* 0) the
// clear tiles back. Blank, eight letters, blank, '$', two digits, blank.
fn hud_ov_label(k: u16, on: u8) {
    let at: u16 = (k << 7) + MENU_LABEL;          // icon k's top row
    let clear: u16 = hud_clear_tile();
    for c in 0..14 {
        hud_ov[at + c] = clear;
    }
    if on == 0 { return; }
    hud_ov[at] = HUD_BLANK;
    for c in 0..8 {
        // Padding is the strip's navy, not a hole in the label.
        let ch: u8 = order_stats[k].name[c];
        let mut t: u16 = HUD_BLANK;
        if ch != 0 { t = hud_letter(ch); }
        hud_ov[at + 1 + c] = t;
    }
    hud_ov[at + 9] = HUD_BLANK;
    hud_ov[at + 10] = hud_glyph(GLYPH_DOLLAR);
    let cost: u8 = order_stats[k].cost;
    let tens: u8 = div8(cost, 10);
    hud_ov[at + 11] = HUD_BLANK;                  // no leading zero
    if tens != 0 { hud_ov[at + 11] = hud_glyph(GLYPH_DIGIT + (tens as u16)); }
    hud_ov[at + 12] = hud_glyph(GLYPH_DIGIT + ((cost - mul8(tens, 10)) as u16));
    hud_ov[at + 13] = HUD_BLANK;
}

// hud_ov_lit - the selected icon lit (*on* 1) or looking unselected, in
// the shadow and flagged for the flush. The label is left as it is.
fn hud_ov_lit(on: u8) {
    let k: u16 = hud_ov_sel as u16;
    if on != 0 { hud_ov_icon(k, ICON_PAL_SEL); } else { hud_ov_icon(k, ICON_PAL); }
    hud_ov_flag(k << 2, (k << 2) + 3);
}

// hud_ov_bought - an order went through: flash the icon (order_input).
far fn hud_ov_bought() {
    hud_ov_flash = MENU_FLASH;
}

// hud_ov_select - move the selection from *old* to *new* in the shadow.
fn hud_ov_select(old: u16, new: u16) {
    hud_ov_icon(old, ICON_PAL);
    hud_ov_label(old, 0);
    hud_ov_icon(new, ICON_PAL_SEL);
    hud_ov_label(new, 1);
}

// hud_ov_compose - the whole menu, the current selection lit, and the
// clear twin. Once, at init.
fn hud_ov_compose() {
    let clear: u16 = hud_clear_tile();
    for c in 0..768 {
        hud_ov[c] = clear;
        hud_ov_clear[c] = clear;
    }
    for k in 0..(ORDER_RING as u16) {
        hud_ov_icon(k, ICON_PAL);
    }
    hud_ov_sel = order_sel;
    hud_ov_flash = 0;
    hud_ov_select(order_sel as u16, order_sel as u16);
}

// hud_ov_flag - flush shadow rows *lo*..*hi* (and anything already due).
fn hud_ov_flag(lo: u16, hi: u16) {
    if hud_ov_dirty == 0 || lo < hud_ov_lo { hud_ov_lo = lo; }
    if hud_ov_dirty == 0 || hi > hud_ov_hi { hud_ov_hi = hi; }
}

// hud_overlay - one tick: *want* is whether L is down. Shows, follows the
// selection, and hides; costs nothing on a frame where none of that moved.
far fn hud_overlay(want: u8) {
    if want != 0 {
        if hud_ov_shown == 0 {
            hud_ov_shown = 1;
            hud_ov_flag(0, MENU_ROWS - 1);
            hud_ov_dirty = 1;
        }
        if hud_ov_sel != order_sel {
            let old: u16 = hud_ov_sel as u16;
            let new: u16 = order_sel as u16;
            hud_ov_flash = 0;                     // a move ends a flash: the old item goes plain
            hud_ov_select(old, new);
            hud_ov_sel = order_sel;
            if old < new {
                hud_ov_flag(old << 2, (new << 2) + 3);
            } else {
                hud_ov_flag(new << 2, (old << 2) + 3);
            }
            hud_ov_dirty = 1;
        }
        if hud_ov_flash != 0 {
            // Counting down, a phase every MENU_BLINK frames: odd phases
            // (the first) unselected, even ones lit, the last lit.
            hud_ov_flash = hud_ov_flash - 1;
            if (hud_ov_flash & (MENU_BLINK - 1)) == MENU_BLINK - 1 {
                let mut on: u8 = 1;
                if (hud_ov_flash & MENU_BLINK) != 0 { on = 0; }
                hud_ov_lit(on);
                hud_ov_dirty = 1;
            }
        }
    } else {
        if hud_ov_shown != 0 { hud_overlay_hide(); }
    }
}

// hud_overlay_hide - the rows back to transparent.
far fn hud_overlay_hide() {
    if hud_ov_flash != 0 {
        hud_ov_flash = 0;
        hud_ov_lit(1);                            // shown again, it is selected
    }
    hud_ov_shown = 0;
    hud_ov_flag(0, MENU_ROWS - 1);
    hud_ov_dirty = 2;
}

// hud_ov_flush - shadow rows hud_ov_lo..hud_ov_hi of *src* to VRAM: those
// above the alert's rows whole, one DMA; the rest each its menu columns.
// Byte offsets: pointer arithmetic does not scale by the element.
fn hud_ov_flush(src: far *u8) {
    let lo: u16 = hud_ov_lo;
    let hi: u16 = hud_ov_hi;
    if lo < MENU_WIDE {
        let mut top: u16 = hi;
        if top >= MENU_WIDE { top = MENU_WIDE - 1; }
        dma_copy_vram(1, src + (lo << 6), VRAM_HUD + ((MENU_ROW + lo) << 5),
                      (top - lo + 1) << 6);
    }
    let mut r: u16 = lo;
    if r < MENU_WIDE { r = MENU_WIDE; }
    while r <= hi {
        dma_copy_vram(1, src + (r << 6), VRAM_HUD + ((MENU_ROW + r) << 5),
                      MENU_NARROW << 1);
        r = r + 1;
    }
}

// hud_flush - push the rows to VRAM. Vblank only.
far fn hud_flush() {
    if hud_ov_dirty == 1 { hud_ov_flush(&hud_ov as far *u8); }
    if hud_ov_dirty == 2 { hud_ov_flush(&hud_ov_clear as far *u8); }
    hud_ov_dirty = 0;
    if hud_clear2 != 0 {
        // Once: the art's navy on row 2 goes transparent, the radar
        // having moved up to row 1.
        hud_clear2 = 0;
        dma_copy_vram(1, &hud_ov_clear as far *u8, VRAM_HUD + (2 << 5), 64);
    }
    if hud_dirty != 0 {
        hud_dirty = 0;
        dma_copy_vram(1, &hud_row as far *u8, VRAM_HUD, 64);
        dma_copy_vram(1, &hud_row[32] as far *u8, VRAM_HUD + (HUD_BOTTOM_ROW << 5), 64);
    }
    radar_flush();
    if hud_msg_dirty != 0 {
        hud_msg_dirty = 0;
        dma_copy_vram(1, &hud_msg as far *u8, VRAM_HUD + (HUD_MSG_ROW << 5), 64);
    }
    if alert_dirty != 0 { alert_flush(); }
}
