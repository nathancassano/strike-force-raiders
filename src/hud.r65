// hud - the strip along the top of the screen, and the one along the
// bottom.
//
// BG1 is a 32x32 map DMA'd from ROM at boot. The match is on the top two
// tile rows, the airframe on the bottom one:
//
//   row 0   $ purse, lives, men aboard
//   row 1   the radar (radar.r65): a row of tiles the game draws into
//   row 27  the airframe: the health bar, the fuel bar, gun rounds,
//           bombs, missiles - over the dirt, where nothing else is drawn
//
// The order ring that used to sit on row 0 is the L dialog's now. Rows 0
// and 27 are composed into one shadow and DMA'd to VRAM in vblank when
// something on them changed - 64 bytes each, so the cost is nothing, but
// there is no reason to pay it on a frame where nothing moved.
//
// Glyphs live on map row HUD_GLYPH_ROW of bg1.bmp, below the 224 scanlines
// the screen shows. bmp2chr de-duplicates tiles, so their IDs are whatever
// it decided; rather than hard-code them, the strip is read back out of the
// tilemap in ROM - the glyph's *position* on that row is the contract, and
// tools/hud_glyphs.py keeps it.

#[bank(2)]

const HUD_GLYPH_ROW: u16 = 28;

// Glyph positions on the strip, in tools/hud_glyphs.py order.
const GLYPH_DIGIT:    u16 = 0;            // 0..9
const GLYPH_DOLLAR:   u16 = 10;
const GLYPH_LBRACKET: u16 = 11;
const GLYPH_RBRACKET: u16 = 12;
const GLYPH_ICON:     u16 = 13;           // + Order, in ring order
// Capitals on the row below: tile (HUD_LETTER_ROW * 32 + c - 'A').
const HUD_LETTER_ROW: u16 = 29;
// And the order overlay's box on the row below that, in this order.
const HUD_BOX_ROW: u16 = 30;
const BOX_TL: u16 = 0;
const BOX_TR: u16 = 1;
const BOX_BL: u16 = 2;
const BOX_BR: u16 = 3;
const BOX_T:  u16 = 4;
const BOX_B:  u16 = 5;
const BOX_L:  u16 = 6;
const BOX_R:  u16 = 7;
const BOX_CURSOR: u16 = 8;
const BOX_BAR:    u16 = 9;                // + 0..4: a cell 0/2/4/6/8 px full

// Row 0 layout, in tile columns: "$NN", the airframe icon and lives, the
// man icon and the men aboard.
const HUD_COL_FUNDS:  u16 = 0;
const HUD_COL_LIVES:  u16 = 4;
const HUD_COL_MEN:    u16 = 7;
// The bottom row (map row HUD_BOTTOM_ROW, the shadow's second 32 words):
// "H[......]" and "F[......]" - six-cell bars, 48 px each - then "G NN",
// "B NN" and "MN", the smart missiles, which come with phase 10's last
// slice and read 0 until then.
const HUD_BOTTOM_ROW: u16 = 27;
const HUD_COL_HEALTH: u16 = 0;
const HUD_COL_FUEL:   u16 = 10;
const HUD_BAR_CELLS:  u16 = 6;
const HUD_COL_GUN:    u16 = 20;
const HUD_COL_BOMBS:  u16 = 25;
const HUD_COL_MISSILES: u16 = 30;

// The blank tile is whatever the art has at (0,0): plain navy.
const HUD_BLANK: u16 = 0;

#[lowram] static mut hud_row:   [u16; 64];    // row 0, then the bottom row
#[lowram] static mut hud_dirty: u8;
#[lowram] static mut hud_clear2: u8;          // map row 2, the art's navy, to clear once
// What the rows currently show, so a frame with no change is free.
#[lowram] static mut hud_funds: u8;
#[lowram] static mut hud_lives: u8;
#[lowram] static mut hud_hp:    u8;
#[lowram] static mut hud_fuel:  u8;
#[lowram] static mut hud_gun:   u8;
#[lowram] static mut hud_bombs: u8;
#[lowram] static mut hud_missiles: u8;
#[lowram] static mut hud_men:   u8;

// hud_glyph - the tile word for glyph *n*, out of the map row in ROM.
fn hud_glyph(n: u16) -> u16 {
    let i: u16 = ((HUD_GLYPH_ROW << 5) + n) << 1;
    return (BG1_MAP[i] as u16) | ((BG1_MAP[i + 1] as u16) << 8);
}

// hud_put2 - two decimal digits at *col*. Values are capped at 99 upstream.
fn hud_put2(col: u16, v: u8) {
    let tens: u8 = div8(v, 10);
    hud_row[col]     = hud_glyph(GLYPH_DIGIT + (tens as u16));
    hud_row[col + 1] = hud_glyph(GLYPH_DIGIT + ((v - mul8(tens, 10)) as u16));
}

// hud_bar - six bar cells at *col*, *px* of 48 filled.
fn hud_bar(col: u16, px: u16) {
    let mut left: u16 = px;
    if left > (HUD_BAR_CELLS << 3) { left = HUD_BAR_CELLS << 3; }
    for c in 0..HUD_BAR_CELLS {
        let mut n: u16 = left;
        if n > 8 { n = 8; }
        hud_row[col + c] = hud_box(BOX_BAR + (n >> 1));
        left = left - n;
    }
}

far fn hud_init() {
    for c in 0..64 {
        hud_row[c] = HUD_BLANK;
    }
    // The fixed parts: labels, brackets, icons.
    hud_row[HUD_COL_FUNDS] = hud_glyph(GLYPH_DOLLAR);
    hud_row[HUD_COL_LIVES] = hud_glyph(GLYPH_ICON + (Order::Heli as u16));
    hud_row[HUD_COL_MEN] = hud_glyph(GLYPH_ICON + (Order::Infantry as u16));
    hud_row[32 + HUD_COL_HEALTH] = hud_letter(0x48);            // H
    hud_row[32 + HUD_COL_HEALTH + 1] = hud_glyph(GLYPH_LBRACKET);
    hud_row[32 + HUD_COL_HEALTH + 2 + HUD_BAR_CELLS] = hud_glyph(GLYPH_RBRACKET);
    hud_row[32 + HUD_COL_FUEL] = hud_letter(0x46);              // F
    hud_row[32 + HUD_COL_FUEL + 1] = hud_glyph(GLYPH_LBRACKET);
    hud_row[32 + HUD_COL_FUEL + 2 + HUD_BAR_CELLS] = hud_glyph(GLYPH_RBRACKET);
    hud_row[32 + HUD_COL_GUN] = hud_letter(0x47);               // G
    hud_row[32 + HUD_COL_BOMBS] = hud_letter(0x42);             // B
    hud_row[32 + HUD_COL_MISSILES] = hud_letter(0x4D);          // M
    // Force the first compose: no real state matches these.
    hud_funds = 0xFF;
    hud_lives = 0xFF;
    hud_hp = 0xFF;
    hud_fuel = 0xFF;
    hud_gun = 0xFF;
    hud_bombs = 0xFF;
    hud_missiles = 0xFF;
    hud_men = 0xFF;
    hud_dirty = 0;
    hud_clear2 = 1;
    hud_msg_dirty = 0;
    hud_ov_dirty = 0;
    hud_ov_shown = 0;
    hud_ov_compose();
    hud_update();
}

// hud_update - recompose whatever moved. Health is 20 hp over 48 px
// (2.5 px/hp, the last two clipped); fuel is 100 over 48 (half a pixel a
// unit, the last two clipped).
far fn hud_update() {
    if hud_funds != funds {
        hud_funds = funds;
        hud_put2(HUD_COL_FUNDS + 1, funds);
        hud_dirty = 1;
    }
    if hud_lives != heli_lives {
        hud_lives = heli_lives;
        let mut n: u8 = heli_lives;
        if n > 9 { n = 9; }
        hud_row[HUD_COL_LIVES + 1] = hud_glyph(GLYPH_DIGIT + (n as u16));
        hud_dirty = 1;
    }
    if hud_hp != heli_hp {
        hud_hp = heli_hp;
        hud_bar(32 + HUD_COL_HEALTH + 2, ((heli_hp as u16) * 2) + ((heli_hp as u16) >> 1));
        hud_dirty = 1;
    }
    if hud_fuel != heli_fuel {
        hud_fuel = heli_fuel;
        hud_bar(32 + HUD_COL_FUEL + 2, (heli_fuel as u16) >> 1);
        hud_dirty = 1;
    }
    if hud_gun != heli_gun {
        hud_gun = heli_gun;
        hud_put2(32 + HUD_COL_GUN + 2, heli_gun);
        hud_dirty = 1;
    }
    if hud_bombs != heli_bombs {
        hud_bombs = heli_bombs;
        hud_put2(32 + HUD_COL_BOMBS + 2, heli_bombs);
        hud_dirty = 1;
    }
    if hud_missiles != heli_missiles {
        hud_missiles = heli_missiles;
        hud_row[32 + HUD_COL_MISSILES + 1] = hud_glyph(GLYPH_DIGIT + (heli_missiles as u16));
        hud_dirty = 1;
    }
    if hud_men != heli_men {
        hud_men = heli_men;
        hud_row[HUD_COL_MEN + 1] = hud_glyph(GLYPH_DIGIT + (heli_men as u16));
        hud_dirty = 1;
    }
}

// -------------------------------------------------------------- message ---
// The battle-over line, on map row HUD_MSG_ROW - mid-screen, over the
// field, where BG1 is otherwise transparent. Composed into its own shadow
// from a ROM string of capitals and spaces, centred, and flushed once.
const HUD_MSG_ROW: u16 = 10;
const HUD_MSG_MAX: u16 = 32;

#[lowram] static mut hud_msg:       [u16; 32];
#[lowram] static mut hud_msg_dirty: u8;

// The tile the map has on the message row - whatever the art left there,
// read back rather than assumed, so clearing the line restores it.
fn hud_clear_tile() -> u16 {
    return (BG1_MAP[(HUD_MSG_ROW << 6)] as u16)
         | ((BG1_MAP[(HUD_MSG_ROW << 6) + 1] as u16) << 8);
}

// hud_letter - the tile word for a capital, or the clear tile for a space.
fn hud_letter(c: u8) -> u16 {
    if c == 0x20 { return hud_clear_tile(); }
    let i: u16 = ((HUD_LETTER_ROW << 5) + ((c - 0x41) as u16)) << 1;
    return (BG1_MAP[i] as u16) | ((BG1_MAP[i + 1] as u16) << 8);
}

// hud_message - show *len* capitals from *text*, centred; 0 clears.
far fn hud_message(text: *u8, len: u16) {
    let blank: u16 = hud_clear_tile();
    for c in 0..HUD_MSG_MAX {
        hud_msg[c] = blank;
    }
    let start: u16 = (HUD_MSG_MAX - len) >> 1;
    for k in 0..len {
        hud_msg[start + k] = hud_letter(text[k]);
    }
    hud_msg_dirty = 1;
}

// -------------------------------------------------------------- overlay ---
// The order dialog, shown while L is held: a box on map rows OV_ROW.. of
// BG1 - under the strip, over the sky - one line per unit type with its
// icon, name and cost, the highlighted line marked by a cursor. The box
// is composed once, at init, into an 8-row shadow that only the cursor
// ever changes (composing it on the press cost a frame); showing it and
// moving the cursor DMA that shadow as a block, hiding it DMAs a second,
// all-transparent block. Rows 3-10 are transparent in the art and row 2,
// the old radar row, is cleared to match at boot; game_over hides the
// overlay before it writes the battle-over line, from when they shared
// row 10.
//
// Line layout, 18 columns from OV_COL: border, cursor, icon, space, an
// eight-letter name, space, '$', two digits, space, border.
const OV_ROW:  u16 = 2;
const OV_ROWS: u16 = 8;                   // border + six lines + border
const OV_COL:  u16 = 7;
const OV_W:    u16 = 18;

// Names in ring order, eight capitals each padded with spaces.
static ov_names: [u8; 48] = "VAN     LAUNCHERTANK    INFANTRYENGINEERHELI    ";

#[lowram] static mut hud_ov:       [u16; 256];   // OV_ROWS map rows, the box
#[lowram] static mut hud_ov_clear: [u16; 256];   // ... and the same rows, empty
#[lowram] static mut hud_ov_dirty: u8;           // 1 flush the box, 2 flush the clear
#[lowram] static mut hud_ov_shown: u8;
#[lowram] static mut hud_ov_sel:   u8;           // the line the cursor is on

// hud_box - the tile word for box piece *n*.
fn hud_box(n: u16) -> u16 {
    let i: u16 = ((HUD_BOX_ROW << 5) + n) << 1;
    return (BG1_MAP[i] as u16) | ((BG1_MAP[i + 1] as u16) << 8);
}

// hud_ov_cursor - put *tile* in the cursor column of line *k*.
fn hud_ov_cursor(k: u16, tile: u16) {
    hud_ov[((k + 1) << 5) + OV_COL + 1] = tile;
}

// hud_ov_compose - the whole box, cursor on the current selection, and
// the clear block. Once, at init.
fn hud_ov_compose() {
    let clear: u16 = hud_clear_tile();
    for c in 0..256 {
        hud_ov[c] = clear;
        hud_ov_clear[c] = clear;
    }
    // Top and bottom edges.
    hud_ov[OV_COL] = hud_box(BOX_TL);
    hud_ov[OV_COL + OV_W - 1] = hud_box(BOX_TR);
    let bot: u16 = (OV_ROWS - 1) << 5;
    hud_ov[bot + OV_COL] = hud_box(BOX_BL);
    hud_ov[bot + OV_COL + OV_W - 1] = hud_box(BOX_BR);
    for c in 1..(OV_W - 1) {
        hud_ov[OV_COL + c] = hud_box(BOX_T);
        hud_ov[bot + OV_COL + c] = hud_box(BOX_B);
    }
    // One line per entry.
    for k in 0..(ORDER_RING as u16) {
        let at: u16 = ((k + 1) << 5) + OV_COL;
        hud_ov[at] = hud_box(BOX_L);
        hud_ov[at + OV_W - 1] = hud_box(BOX_R);
        hud_ov[at + 1] = HUD_BLANK;
        hud_ov[at + 2] = hud_glyph(GLYPH_ICON + k);
        hud_ov[at + 3] = HUD_BLANK;
        for c in 0..8 {
            // Padding is the strip's navy, not a hole in the box.
            let ch: u8 = ov_names[(k << 3) + c];
            let mut t: u16 = HUD_BLANK;
            if ch != 0x20 { t = hud_letter(ch); }
            hud_ov[at + 4 + c] = t;
        }
        hud_ov[at + 12] = HUD_BLANK;
        hud_ov[at + 13] = hud_glyph(GLYPH_DOLLAR);
        let cost: u8 = order_stats[k].cost;
        let tens: u8 = div8(cost, 10);
        hud_ov[at + 14] = HUD_BLANK;                   // no leading zero
        if tens != 0 { hud_ov[at + 14] = hud_glyph(GLYPH_DIGIT + (tens as u16)); }
        hud_ov[at + 15] = hud_glyph(GLYPH_DIGIT + ((cost - mul8(tens, 10)) as u16));
        hud_ov[at + 16] = HUD_BLANK;
    }
    hud_ov_sel = order_sel;
    hud_ov_cursor(order_sel as u16, hud_box(BOX_CURSOR));
}

// hud_overlay - one tick: *want* is whether L is down. Shows, follows the
// selection, and hides; costs nothing on a frame where none of that moved.
far fn hud_overlay(want: u8) {
    if want != 0 {
        if hud_ov_shown == 0 {
            hud_ov_shown = 1;
            hud_ov_dirty = 1;
        }
        if hud_ov_sel != order_sel {
            hud_ov_cursor(hud_ov_sel as u16, HUD_BLANK);
            hud_ov_sel = order_sel;
            hud_ov_cursor(order_sel as u16, hud_box(BOX_CURSOR));
            hud_ov_dirty = 1;
        }
    } else {
        if hud_ov_shown != 0 { hud_overlay_hide(); }
    }
}

// hud_overlay_hide - the rows back to transparent.
far fn hud_overlay_hide() {
    hud_ov_shown = 0;
    hud_ov_dirty = 2;
}

// hud_flush - push the rows to VRAM. Vblank only.
far fn hud_flush() {
    if hud_ov_dirty == 1 {
        dma_copy_vram(1, &hud_ov as far *u8, VRAM_BG1 + (OV_ROW << 5), 512);
    }
    if hud_ov_dirty == 2 {
        dma_copy_vram(1, &hud_ov_clear as far *u8, VRAM_BG1 + (OV_ROW << 5), 512);
    }
    hud_ov_dirty = 0;
    if hud_clear2 != 0 {
        // Once: the art's navy on row 2 goes transparent, the radar
        // having moved up to row 1.
        hud_clear2 = 0;
        dma_copy_vram(1, &hud_ov_clear as far *u8, VRAM_BG1 + (2 << 5), 64);
    }
    if hud_dirty != 0 {
        hud_dirty = 0;
        dma_copy_vram(1, &hud_row as far *u8, VRAM_BG1, 64);
        dma_copy_vram(1, &hud_row[32] as far *u8, VRAM_BG1 + (HUD_BOTTOM_ROW << 5), 64);
    }
    radar_flush();
    if hud_msg_dirty != 0 {
        hud_msg_dirty = 0;
        dma_copy_vram(1, &hud_msg as far *u8, VRAM_BG1 + (HUD_MSG_ROW << 5), 64);
    }
}
