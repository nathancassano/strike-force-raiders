// para - the airlift: men aboard the airframe, and paratroopers on the
// way down.
//
// This is the "rescue" the title descends from. A friendly infantryman
// who walks under the middle of a landed airframe, within PARA_PICKUP px
// of its centre, climbs aboard - the pad does not restore men, the field
// does - and X drops one out of the door as a paratrooper. One chute in
// ten fails and the man splats; the rest land and walk on as ordered
// infantry would.
//
// A paratrooper is the one thing on the field with a height that is not
// the airframe's, so he gets his own small pool rather than a unit slot:
// units have no y. Eight covers five men out of one door plus an enemy
// airframe's later.

#[bank(0)]

const PARA_MAX:    u16 = 8;
const PARA_MASK:   u16 = 7;
const PARA_PICKUP: u16 = 5;               // px either side of the airframe's centre
const PARA_ABOARD: u8  = 5;               // the design's limit

// Descent in 8.8 px/frame: a chute drifts down, a failed one drops.
const PARA_SINK: u16 = 0x00C0;            // 0.75 px/frame, ~75 frames from hover
const PARA_FALL: u16 = 0x0300;            // 3 px/frame
const PARA_FAIL: u16 = 26;                // of 256: one chute in ten, near enough

// A man under a canopy is two 16x16 cells: the canopy over the standing
// infantryman's cell. The failed chute is the man's cell alone.
const PARA_TILE:      u8  = 72;           // tools/struct_art.py
const PARA_ATTR:      u16 = 0x3000;
const PARA_GROUND_Y:  u16 = (GROUND_Y - UNIT_H) << 8;   // feet on the line

#[lowram] static mut para_x:     [u16; 8];
#[lowram] static mut para_y:     [u16; 8];   // 8.8 screen y of the man's cell
#[lowram] static mut para_owner: [u8; 8];
#[lowram] static mut para_state: [u8; 8];    // PARA_FREE / CHUTE / FALLING / DOWN
#[lowram] static mut para_cursor: u16;
#[lowram] static mut para_live:  u8;          // slots in use: both loops skip at zero,
                                              // which is most frames (measured 1.7%)
#[lowram] static mut heli_men:   u8;          // aboard the player's airframe

const PARA_FREE:    u8 = 0;
const PARA_CHUTE:   u8 = 1;
const PARA_FALLING: u8 = 2;               // chute failed
const PARA_DOWN:    u8 = 3;               // landed, waiting for a pool slot

far fn para_init() {
    for i in 0..PARA_MAX {
        para_state[i] = PARA_FREE;
    }
    para_cursor = 0;
    para_live = 0;
    heli_men = 0;
}

// para_drop - a man out of the door at (x, y), for *owner*. The chute
// is decided at the door: one in ten fails.
far fn para_drop(x: u16, y: u16, owner: u8) {
    let mut i: u16 = para_cursor;
    let mut n: u16 = 0;
    while n < PARA_MAX {
        if para_state[i] == PARA_FREE {
            para_x[i] = x;
            para_y[i] = y;
            para_owner[i] = owner;
            para_state[i] = PARA_CHUTE;
            if (rand() & 0x00FF) < PARA_FAIL { para_state[i] = PARA_FALLING; }
            para_cursor = (i + 1) & PARA_MASK;
            para_live = para_live + 1;
            return;
        }
        i = (i + 1) & PARA_MASK;
        n = n + 1;
    }
}

// para_pickup - one tick on the deck: a friendly infantryman centred
// within PARA_PICKUP px of the airframe's centre boards. The window is the
// middle of the airframe whatever its facing; a man is centred on it when
// his left edge is (HELI_W - UNIT_MAN_W) / 2 past the airframe's.
far fn para_pickup() {
    if heli_men >= PARA_ABOARD { return; }
    let lo: u16 = heli_x_px + (HELI_W - UNIT_MAN_W) / 2 - PARA_PICKUP;
    let hi: u16 = lo + PARA_PICKUP * 2;
    for j in 0..UNIT_MAX {
        if units[j].kind as u8 == UnitType::Infantry as u8 {
            if units[j].owner == SIDE_PLAYER {
                let ux: u16 = units[j].x_px;
                if ux >= lo && ux <= hi {
                    unit_free(j);
                    heli_men = heli_men + 1;
                    return;
                }
            }
        }
    }
}

// para_update - the descent. A landed man becomes an infantryman the
// frame the pool has room; a failed chute ends on the ground with nothing.
far fn para_update() {
    if para_live == 0 { return; }
    for i in 0..PARA_MAX {
        let st: u8 = para_state[i];
        if st == PARA_CHUTE || st == PARA_FALLING {
            let mut v: u16 = PARA_SINK;
            if st == PARA_FALLING { v = PARA_FALL; }
            let y: u16 = para_y[i] + v;
            if y >= PARA_GROUND_Y {
                para_y[i] = PARA_GROUND_Y;
                if st == PARA_FALLING {
                    para_state[i] = PARA_FREE;      // splat
                    para_live = para_live - 1;
                } else {
                    para_state[i] = PARA_DOWN;
                }
            } else {
                para_y[i] = y;
            }
        }
        if para_state[i] == PARA_DOWN {
            if unit_spawn(Order::Infantry, para_owner[i], para_x[i]) != 0 {
                para_state[i] = PARA_FREE;
                para_live = para_live - 1;
            }
        }
    }
}

// para_draw - after the munitions in the OAM order.
far fn para_draw() {
    if para_live == 0 { return; }
    for i in 0..PARA_MAX {
        let st: u8 = para_state[i];
        if st != PARA_FREE {
            let sx: u16 = para_x[i] - camera_x;
            if sx < 256 || sx >= 0xFFF0 {
                let mut attr: u16 = PARA_ATTR;
                let mut bx: u16 = sx & 0x01FF;
                if para_owner[i] == SIDE_ENEMY {
                    attr = PARA_ATTR | 0x4000 | OBJ_PAL_ENEMY;
                    bx = (sx - UNIT_MIRROR_MAN) & 0x01FF;
                }
                let y: u8 = (para_y[i] >> 8) as u8;
                let m: u16 = oam_take();
                if m < OAM_SLOTS {
                    oam.set_full!(m as u8, bx, y, (UNIT_TILE_INFANTRY as u16) | attr);
                    oam.set_size!(m as u8, 1);
                }
                if st == PARA_CHUTE {
                    let c: u16 = oam_take();
                    if c < OAM_SLOTS {
                        oam.set_full!(c as u8, bx, y - 16, (PARA_TILE as u16) | attr);
                        oam.set_size!(c as u8, 1);
                    }
                }
            }
        }
    }
}
