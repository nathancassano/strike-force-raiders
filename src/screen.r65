// screen - the front end: the title page, the mission briefing and the
// after-action page.
//
// All three are the same thing - BG3 written as a full 32x28 page of text
// with every other layer switched off, so the field behind them is not
// hidden so much as not drawn. That is the whole trick: BG1-2 and OBJ keep
// their contents and their registers, `TM` just stops naming them, and a
// page costs one DMA of the BG3 map at the moment it goes up rather than
// anything per frame. Coming back restores the map from ROM and re-inits
// the strip, since a page has written over both.
//
// The text goes through the stdlib console (lib/console.r65) in buffer
// mode, writing into the page shadow, in the stdlib's default font
// (lib/default_font.r65, ASCII 32-126) uploaded at boot past the radar's
// tiles. Its text area is the inside of the frame, so a centred line
// clears and centres between the border columns. The border and the code
// cursor are still the HUD's box pieces, read back out of the BG3
// map by position (HUD_BOX_ROW, tools/hud_glyphs.py).
//
// The title is the exception: it is Mode 3, a 256-colour picture on BG1
// (assets/src/title.tilemap.bmp, painted from a render by
// tools/title_art.py) with the menu on BG2, in the same console font
// widened to 4bpp - Mode 3 has no BG3. The picture fills VRAM, so the
// title loads over the field's VRAM and CGRAM (title_load) and leaving
// it puts them back (video_restore) before the next page goes up.
//
// The front end is the *campaign's*. A test mission (mission.r65) boots
// straight into its battle and its Start still restarts it, so the suite
// never sees a page it did not ask for.

#[bank(2)]

include!("lib/console.r65")
include!("lib/default_font.r65")

const SCREEN_NONE:  u8 = 0;
const SCREEN_TITLE: u8 = 1;
const SCREEN_BRIEF: u8 = 2;
const SCREEN_AFTER: u8 = 3;
const SCREEN_END:   u8 = 4;               // the campaign, won
const SCREEN_OVER:  u8 = 5;               // a mission lost: game over, back to the title

// The font, in BG3's tileset after the art (HUD_CHR_SIZE / 16 tiles) and
// the radar's 32, on a sub-palette of its own: CGRAM 8-11, white with a
// grey edge. Colour 0 is transparent, so the page's navy is the backdrop.
// Only ASCII 32-95 - space to '_', the capitals and the code cursor's '^':
// the pages print no lowercase, and the tiles past them are the order
// menu's icons and the status rows' glyphs (hud.r65).
const SCREEN_FONT_TILE:  u16 = 96;
const SCREEN_FONT_TILES: u16 = 64;
const SCREEN_FONT_PAL:   u16 = 2;
// The console's area: inside the frame's two border columns.
const SCREEN_TEXT_COL:   u16 = 2;
const SCREEN_TEXT_W:     u16 = 28;

// The map is 32x32; 224 scanlines show 28 rows of it.
const SCREEN_COLS: u16 = 32;
const SCREEN_ROWS: u16 = 28;

// The border, and where a page's text sits inside it.
const SCREEN_BOX_ROW:  u16 = 1;
const SCREEN_BOX_ROWS: u16 = 26;
const SCREEN_BOX_COL:  u16 = 1;
const SCREEN_BOX_W:    u16 = 30;
const SCREEN_PROMPT:   u16 = 22;          // the PRESS START row

// The briefing. The campaign's road under the mission's name: ten stops,
// three columns apart, filling the inside of the frame - its numbers on
// the row above, a caret under this mission's stop on the row below.
// Placeholder art, all of it the font's: a taken stop is '#' and the road
// behind it '=', in the status rows' gold; this one is '@'; ahead are 'O'
// and '-'.
const BRIEF_MAP_ROW:  u16 = 7;
const BRIEF_MAP_COL:  u16 = 2;
const BRIEF_MAP_STEP: u16 = 3;
const BRIEF_MAP_PAL:  u16 = 5;            // hud.r65's gold (STAT_CGRAM)
// The briefing's text (mission_brief), left-aligned a column in from the
// frame, and the row's numbers in two columns under it. The area runs to
// the frame, a column wider than a line: a line that filled it would wrap
// by itself, and its '\n' would then skip a row.
const BRIEF_TEXT_ROW: u16 = 11;
const BRIEF_TEXT_COL: u16 = 3;
const BRIEF_W:        u16 = 27;
const BRIEF_ROWS:     u16 = 5;
const BRIEF_STAT_ROW: u16 = 17;
const BRIEF_LEFT:     u16 = 4;            // a label, its value's last digit at +9
const BRIEF_RIGHT:    u16 = 17;           // the same, the second column
const BRIEF_VALUE:    u16 = 9;

// The debrief (the after-action page): a table of the match's tally
// (game.r65), the player's column then the enemy's, each value against
// the last letter of its heading; the purse's three lines under it,
// against the player's column, since they are the player's.
const DEBRIEF_HEAD:   u16 = 6;            // the YOU / ENEMY headings
const DEBRIEF_ROW:    u16 = 8;            // the table's first row
const DEBRIEF_PURSE:  u16 = 12;           // PURSE, SALVAGE, CARRIED
const DEBRIEF_LABEL:  u16 = 3;
const DEBRIEF_YOU:    u16 = 21;
const DEBRIEF_ENEMY:  u16 = 28;
const DEBRIEF_CODE:   u16 = 18;

// The title's continue-code field: the four letters, the cursor under the
// one being typed, and the line that says what the code reads as. They
// are kept together because editing one redraws the block, and a block of
// whole rows is one DMA (see screen_flush).
const SCREEN_CODE_ROW:  u16 = 19;
const SCREEN_CODE_ROWS: u16 = 5;          // 19..23: letters, cursor, readout
const SCREEN_CODE_COL:  u16 = 16;         // the first letter; two columns apart
const SCREEN_LABEL_COL: u16 = 10;         // and the word CODE, to their left
const SCREEN_READ_ROW:  u16 = 22;
const SCREEN_TITLE_PROMPT: u16 = 25;      // under the code block, on the art's panel

// The title's VRAM, Mode 3. BG1's 8bpp tiles take $0000-$6FFF - 896 of
// them, a whole screen's, so any picture fits. BG2's 4bpp font sits at its
// own tile numbers (SCREEN_FONT_TILE on) from a base of $7000, so the
// first 96 tiles of that base are never named and hold BG1's map instead;
// BG2's map is the last 1K words. The font's two colours are entries 34
// and 35 of the picture's palette (BG2 palette 2, as on BG3), fixed by
// title_art.py.
const TITLE_VRAM_MAP:  u16 = 0x7000;      // 0x1C in $400-word units
const TITLE_VRAM_FONT: u16 = 0x7000;      // BG2's tile base, 7 in 4K-word units
const TITLE_VRAM_TEXT: u16 = 0x7C00;      // 0x1F

// The title opens on a menu - NEW GAME, then ENTER CODE - in the same rows
// as the code field, which it gives way to when ENTER CODE is picked: one
// block, one flush, whichever is up.
const TITLE_MENU: u8 = 0;                 // title_mode: the menu ...
const TITLE_CODE: u8 = 1;                 // ... or the code field
const TITLE_NEW:  u8 = 0;                 // title_sel: NEW GAME ...
const TITLE_ENTER: u8 = 1;                // ... or ENTER CODE
const SCREEN_MENU_COL:    u16 = 12;       // the options, left-aligned ...
const SCREEN_MENU_CURSOR: u16 = 10;       // ... and the > picking one
#[lowram] static mut title_mode: u8;
#[lowram] static mut title_sel:  u8;

// One shadow of the visible map, composed on a transition and flushed in
// force blank. It is 1792 bytes of lowram, which is affordable because
// nothing else here is: the pages have no per-frame state at all.
#[lowram] static mut screen_page: [u16; 896];
#[lowram] static mut screen_kind: u8;
#[lowram] static mut screen_dirty: u8;    // the code block wants flushing

#[ram] static mut screen_con: Console;
#[ram] static mut screen_line: [u8; 17];  // a mission name, trimmed and terminated

// A 4bpp tile's upper two bitplanes, which the 2bpp font has none of.
static SCREEN_ZERO: [u8; 16] = [0; 16];

// ------------------------------------------------------ continue code ---
// Progress between missions is a typed code, not a save file: four
// letters carrying the mission and the purse to start it with. Eleven
// bits of payload (four of mission, seven of funds) and five of check,
// scrambled with CODE_SALT and cut into four nibbles, each a letter A..P
// - so 1000 of the 65536 spellings mean anything, and a mistyped one is
// almost certainly rejected rather than silently starting the wrong
// mission. The after-action page shows the code for the next run and
// leaves it typed in, so continuing is one press.
const CODE_LEN:  u16 = 4;
const CODE_SALT: u16 = 0x9E37;
const CODE_BAD:  u8  = 0xFF;

#[lowram] static mut code_letters: [u8; 4];   // 0..15: the letters A..P
#[lowram] static mut code_cursor:  u8;        // which one the d-pad edits
#[lowram] static mut code_rep:     u8;        // frames to the held d-pad's repeat

// Typing a four-letter code a press at a time would be sixty presses, so
// a held direction runs on: a pause, then a step every few frames.
const CODE_REP_FIRST: u8 = 20;
const CODE_REP_NEXT:  u8 = 5;

fn code_check(p: u16) -> u16 {
    return (p ^ (p >> 5) ^ (p >> 9)) & 0x001F;
}

// code_set - spell the code for mission *m* carrying *f* funds.
fn code_set(m: u8, f: u8) {
    let p: u16 = ((m as u16) << 7) | (f as u16);
    let v: u16 = ((p << 5) | code_check(p)) ^ CODE_SALT;
    code_letters[0] = ((v >> 12) & 0x000F) as u8;
    code_letters[1] = ((v >> 8) & 0x000F) as u8;
    code_letters[2] = ((v >> 4) & 0x000F) as u8;
    code_letters[3] = (v & 0x000F) as u8;
}

// code_value - the typed letters as the sixteen bits they stand for.
fn code_value() -> u16 {
    let mut v: u16 = 0;
    for k in 0..CODE_LEN {
        v = (v << 4) | (code_letters[k] as u16);
    }
    return v ^ CODE_SALT;
}

// code_mission - the mission the typed code names, or CODE_BAD if the
// check digits, the mission or the purse do not stand up.
fn code_mission() -> u8 {
    let v: u16 = code_value();
    let p: u16 = v >> 5;
    if (v & 0x001F) != code_check(p) { return CODE_BAD; }
    let m: u8 = (p >> 7) as u8;
    let f: u8 = (p & 0x007F) as u8;
    if m >= MISSION_COUNT { return CODE_BAD; }
    if f > ECON_MAX { return CODE_BAD; }
    return m;
}

// code_purse - the funds it carries. Only meaningful once code_mission
// has said the code is good.
fn code_purse() -> u8 {
    return ((code_value() >> 5) & 0x007F) as u8;
}

// -------------------------------------------------------- the campaign ---
// What a won mission hands the next one: the equipment that survived it,
// in funds. A lost mission hands over nothing - it is fought again as its
// row describes it.
//
// Two departures from the original's conversion list, both forced by the
// size of our purse (ECON_MAX is 99, two HUD digits, and the continue
// code's seven bits). Its list pays 20 a surviving helicopter and 15 a
// van, which against a 99 cap saturates on any win at all - four
// airframes alone are 80 - and hands mission 2 a purse it cannot spend.
// So: the airframes do not convert (the next mission deals its row's
// lives anyway, and paying for them as well counts them twice), and a
// ground unit converts at what it cost to put there, order.r65's price.
// The buildings keep the original's values: they are not bought, so
// there is no price to use instead, and holding the field should pay.

// By unit tag, in UnitType order: free, tank, van, launcher, infantry,
// engineer. An infantry order is five men for five funds, so a man is
// one; an engineer order is two men for five.
static salvage_unit: [u8; 6] = [0, 4, 2, 3, 1, 2];
// And by StructKind: turret, bunker, super bunker, base, bank. The base
// is the original's "end bunker"; the bank is not on its list.
static salvage_struct: [u8; 5] = [3, 4, 4, 20, 0];

#[lowram] static mut after_salvage: u8;   // what the field was worth ...
#[lowram] static mut after_carry:   u8;   // ... and what the next mission gets
#[lowram] static mut after_next:    u8;   // the mission Start goes on to
#[lowram] static mut after_done:    u8;   // ... or 1 if that was the last
#[lowram] static mut after_lost:    u8;   // 1: the match was lost, game over next

// campaign_salvage - the player's surviving equipment, in funds. Capped
// at the purse's two digits, which the code's seven bits also assume.
fn campaign_salvage() -> u8 {
    let mut v: u16 = 0;
    for i in 0..UNIT_MAX {
        if units[i].owner == SIDE_PLAYER {
            v = v + (salvage_unit[units[i].kind as u16] as u16);
        }
    }
    let mut k: u16 = 0;
    while k < struct_count {
        if structs[k].owner == SIDE_PLAYER {
            v = v + (salvage_struct[structs[k].kind as u16] as u16);
        }
        k = k + 1;
    }
    if v > (ECON_MAX as u16) { v = ECON_MAX as u16; }
    return v as u8;
}

// campaign_settle - work out what the after-action page reports and what
// Start does next: the mission to go on to, and the purse it opens with.
fn campaign_settle() {
    after_salvage = campaign_salvage();
    after_next = mission;
    after_carry = start_funds;            // a retry gets the row's own
    after_done = 0;
    after_lost = 1;
    if game_state == GAME_WON {
        after_lost = 0;
        let mut v: u16 = (funds as u16) + (after_salvage as u16);
        if v > (ECON_MAX as u16) { v = ECON_MAX as u16; }
        after_carry = v as u8;
        if mission + 1 < MISSION_COUNT {
            after_next = mission + 1;
        } else {
            after_done = 1;
        }
    }
}

// ----------------------------------------------------------- composing ---

fn screen_put(row: u16, col: u16, tile: u16) {
    screen_page[(row << 5) + col] = tile;
}

// screen_at - *s* with its first character at page (row, col).
fn screen_at(row: u16, col: u16, s: far *u8) {
    screen_con.print_at((col - SCREEN_TEXT_COL) as u8, row as u8, s);
}

// screen_centre - *s* centred inside the frame, the rest of the row cleared.
fn screen_centre(row: u16, s: far *u8) {
    screen_con.set_cursor(0, row as u8);
    screen_con.println(s);
}

// screen_value - *v* right-aligned so its last digit lands on column *end*.
fn screen_value(row: u16, end: u16, v: u16) {
    let mut col: u16 = end - SCREEN_TEXT_COL;
    if v > 9 { col = col - 1; }
    if v > 99 { col = col - 1; }
    if v > 999 { col = col - 1; }
    if v > 9999 { col = col - 1; }
    screen_con.print_at!(col as u8, row as u8, "{u16}", v);
}

// screen_glyph - character *c* at page (row, col) on BG3 sub-palette *pal*:
// the console's own tile for it, in a colour of the caller's choosing.
fn screen_glyph(row: u16, col: u16, c: u8, pal: u16) {
    screen_put(row, col, ((c as u16) - 32 + SCREEN_FONT_TILE) | (pal << 10) | 0x2000);
}

// screen_mission - "MISSION n", centred as one line.
fn screen_mission(row: u16, m: u8) {
    screen_con.set_cursor(0, row as u8);
    screen_con.println!("MISSION {u8}", m + 1);
}

// screen_purse - a line of the debrief's reckoning, its value in the
// player's column of the table above it.
fn screen_purse(row: u16, label: far *u8, v: u8) {
    screen_at(row, DEBRIEF_LABEL, label);
    screen_value(row, DEBRIEF_YOU, v);
}

// The debrief's labels, here rather than written inline: R65 puts a string
// literal in bank 0, wherever the code using it is, and bank 0 is full.
static DEBRIEF_YOU_S:   [u8; 4]  = "YOU";
static DEBRIEF_ENEMY_S: [u8; 6]  = "ENEMY";
static DEBRIEF_UNITS_S: [u8; 16] = "UNITS DESTROYED";
static DEBRIEF_HELIS_S: [u8; 16] = "CHOPPERS DOWNED";
static DEBRIEF_TAKEN_S: [u8; 16] = "BUILDINGS TAKEN";

// screen_tally - a row of the debrief's table: the label, then the
// player's figure and the enemy's under their headings.
fn screen_tally(row: u16, label: far *u8, you: u16, enemy: u16) {
    screen_at(row, DEBRIEF_LABEL, label);
    screen_value(row, DEBRIEF_YOU, you);
    screen_value(row, DEBRIEF_ENEMY, enemy);
}

// screen_pair - a label at *col* and its value against col + BRIEF_VALUE:
// one of the briefing's two columns of stats.
fn screen_pair(row: u16, col: u16, label: far *u8, v: u8) {
    screen_at(row, col, label);
    screen_value(row, col + BRIEF_VALUE, v);
}

// screen_name - mission *m*'s name, centred. The row's padding is 0, so
// the copy ends the string where the name does.
fn screen_name(row: u16, m: u8) {
    let i: u16 = m as u16;
    for k in 0..MISSION_NAME_W {
        screen_line[k] = mission_stats[i].name[k];
    }
    screen_centre(row, &screen_line as far *u8);
}

// screen_clear - the whole page to the font's space, which is transparent.
fn screen_clear() {
    screen_con.set_area(0, 0, SCREEN_COLS as u8, SCREEN_ROWS as u8);
    screen_con.clear();
    screen_con.set_area(SCREEN_TEXT_COL as u8, 0, SCREEN_TEXT_W as u8, SCREEN_ROWS as u8);
}

// screen_frame - the HUD's box pieces around the whole page.
fn screen_frame() {
    let bot: u16 = SCREEN_BOX_ROW + SCREEN_BOX_ROWS - 1;
    screen_put(SCREEN_BOX_ROW, SCREEN_BOX_COL, hud_box(BOX_TL));
    screen_put(SCREEN_BOX_ROW, SCREEN_BOX_COL + SCREEN_BOX_W - 1, hud_box(BOX_TR));
    screen_put(bot, SCREEN_BOX_COL, hud_box(BOX_BL));
    screen_put(bot, SCREEN_BOX_COL + SCREEN_BOX_W - 1, hud_box(BOX_BR));
    for c in 1..(SCREEN_BOX_W - 1) {
        screen_put(SCREEN_BOX_ROW, SCREEN_BOX_COL + c, hud_box(BOX_T));
        screen_put(bot, SCREEN_BOX_COL + c, hud_box(BOX_B));
    }
    for r in 1..(SCREEN_BOX_ROWS - 1) {
        screen_put(SCREEN_BOX_ROW + r, SCREEN_BOX_COL, hud_box(BOX_L));
        screen_put(SCREEN_BOX_ROW + r, SCREEN_BOX_COL + SCREEN_BOX_W - 1, hud_box(BOX_R));
    }
}

// screen_code - the word CODE and the four letters, two columns apart.
fn screen_code(row: u16) {
    screen_at(row, SCREEN_LABEL_COL, "CODE\0");
    for k in 0..CODE_LEN {
        screen_con.set_cursor((SCREEN_CODE_COL + (k << 1) - SCREEN_TEXT_COL) as u8, row as u8);
        screen_con.putc(0x41 + code_letters[k]);
    }
}

// screen_code_block - the title's block, into the page: the menu, or the
// code field and what it reads as. Only the inside of the frame is
// cleared: the border columns live on these rows too, and this block is
// redrawn on every keypress.
fn screen_code_block() {
    for r in 0..SCREEN_CODE_ROWS {
        screen_con.clear_row((SCREEN_CODE_ROW + r) as u8);
    }
    if title_mode == TITLE_MENU {
        screen_at(SCREEN_CODE_ROW, SCREEN_MENU_COL, "NEW GAME\0");
        screen_at(SCREEN_CODE_ROW + 2, SCREEN_MENU_COL, "ENTER CODE\0");
        screen_at(SCREEN_CODE_ROW + ((title_sel as u16) << 1), SCREEN_MENU_CURSOR, ">\0");
        return;
    }
    screen_code(SCREEN_CODE_ROW);
    // The cursor is the font's caret: the HUD's box pieces are BG3's.
    screen_at(SCREEN_CODE_ROW + 1, SCREEN_CODE_COL + ((code_cursor as u16) << 1), "^\0");
    // What it means, live: the mission it opens - and Start takes it - or
    // nothing, and Start does not.
    let m: u8 = code_mission();
    if m == CODE_BAD {
        screen_centre(SCREEN_READ_ROW, "INVALID CODE\0");
    } else {
        screen_mission(SCREEN_READ_ROW, m);
        screen_name(SCREEN_READ_ROW + 1, m);
    }
}

// --------------------------------------------------------------- pages ---

// The title: the menu and the prompt. The name is in the picture.
fn screen_title() {
    screen_code_block();
    screen_centre(SCREEN_TITLE_PROMPT, "PRESS START\0");
}

// screen_map - the campaign's road with mission *m* marked. The campaign
// is linear, so every stop before this one was taken - by winning it, or
// earning the code that skipped it - and the map needs nothing but *m*.
fn screen_map(m: u8) {
    let here: u16 = m as u16;
    let last: u16 = (MISSION_COUNT as u16) - 1;
    let mut col: u16 = BRIEF_MAP_COL;
    for k in 0..(MISSION_COUNT as u16) {
        let mut pal: u16 = SCREEN_FONT_PAL;
        let mut stop: u8 = 'O';
        if k < here {
            pal = BRIEF_MAP_PAL;
            stop = '#';
        }
        if k == here {
            stop = '@';
            screen_glyph(BRIEF_MAP_ROW + 1, col, '^', SCREEN_FONT_PAL);
        }
        screen_glyph(BRIEF_MAP_ROW, col, stop, pal);
        // Its number above it; the tenth's 1 takes the road's column to its left.
        if k == last {
            screen_glyph(BRIEF_MAP_ROW - 1, col - 1, '1', pal);
            screen_glyph(BRIEF_MAP_ROW - 1, col, '0', pal);
        } else {
            screen_glyph(BRIEF_MAP_ROW - 1, col, ('1' + k as u8) as u8, pal);
            // The road on to the next stop: travelled, or not yet.
            let mut road: u8 = '-';
            if k < here { road = '='; }
            screen_glyph(BRIEF_MAP_ROW, col + 1, road, pal);
            screen_glyph(BRIEF_MAP_ROW, col + 2, road, pal);
        }
        col = col + BRIEF_MAP_STEP;
    }
}

// The briefing: which mission and its name, where it stands on the road,
// what it is about, and what it is made of - the numbers mission_stats
// gave the field and the purse, so the page is a reading of the row
// rather than a second copy of it.
fn screen_brief() {
    screen_mission(3, mission);
    screen_name(4, mission);
    screen_map(mission);
    let i: u16 = mission as u16;
    // The text in an area of its own, so its '\n's come back to its
    // margin; then the frame's inside again for the rest.
    if mission < MISSION_COUNT {
        screen_con.set_area(BRIEF_TEXT_COL as u8, BRIEF_TEXT_ROW as u8,
                            BRIEF_W as u8, BRIEF_ROWS as u8);
        screen_con.print(&mission_brief[i] as far *u8);
        screen_con.set_area(SCREEN_TEXT_COL as u8, 0, SCREEN_TEXT_W as u8, SCREEN_ROWS as u8);
    }
    screen_pair(BRIEF_STAT_ROW,     BRIEF_LEFT,  "TURRETS\0", mission_stats[i].turrets);
    screen_pair(BRIEF_STAT_ROW,     BRIEF_RIGHT, "BUNKERS\0", mission_stats[i].bunkers);
    screen_pair(BRIEF_STAT_ROW + 2, BRIEF_LEFT,  "FUNDS\0",   start_funds);
    screen_pair(BRIEF_STAT_ROW + 2, BRIEF_RIGHT, "LIVES\0",   start_lives);
    screen_centre(SCREEN_PROMPT, "PRESS START\0");
}

// The after-action page, the debrief: how the match ended, what each side
// destroyed and took, and what is left in the purse.
fn screen_after() {
    if game_state == GAME_WON {
        screen_centre(3, "VICTORY\0");
    } else {
        screen_centre(3, "DEFEAT\0");
    }
    screen_name(4, mission);
    // The tally, credited to the side that did it: what the player
    // destroyed is what the enemy lost, and the other way about. An
    // airframe the player crashed counts as one the enemy downed.
    screen_at(DEBRIEF_HEAD, DEBRIEF_YOU - 2, &DEBRIEF_YOU_S as far *u8);
    screen_at(DEBRIEF_HEAD, DEBRIEF_ENEMY - 4, &DEBRIEF_ENEMY_S as far *u8);
    screen_tally(DEBRIEF_ROW, &DEBRIEF_UNITS_S as far *u8,
                 tally_units[SIDE_ENEMY as u16], tally_units[SIDE_PLAYER as u16]);
    screen_tally(DEBRIEF_ROW + 1, &DEBRIEF_HELIS_S as far *u8,
                 tally_helis[SIDE_ENEMY as u16], tally_helis[SIDE_PLAYER as u16]);
    screen_tally(DEBRIEF_ROW + 2, &DEBRIEF_TAKEN_S as far *u8,
                 tally_taken[SIDE_PLAYER as u16], tally_taken[SIDE_ENEMY as u16]);
    // The reckoning: what was in the purse, what the field was worth, and
    // what the next mission opens with. A won mission carries the two
    // added together; a lost one carries its own row's funds, and the
    // salvage line is there to say what was on the field when it went.
    campaign_settle();
    screen_purse(DEBRIEF_PURSE,     "PURSE\0",   funds);
    screen_purse(DEBRIEF_PURSE + 1, "SALVAGE\0", after_salvage);
    screen_purse(DEBRIEF_PURSE + 2, "CARRIED\0", after_carry);
    // The code for the next run, left typed into the title's field, so
    // continuing later is one press.
    code_set(after_next, after_carry);
    screen_code(DEBRIEF_CODE);
    screen_centre(SCREEN_PROMPT, "PRESS START\0");
}

// The campaign, won: the tenth mission taken, and the game's last page.
// It is a dead end - no prompt, and screen_tick takes no button on it - so
// only a reset leaves it. The road with every stop taken (screen_map past
// the last mission marks none as this one), a closing word in the
// briefing's text area, and the congratulations tune.
static END_TEXT: [u8; 128] = "THE LAST GUN IS SILENT.\nTHEIR CAPITAL HAS FALLEN\nAND THE ROAD IS YOURS,\nEVERY MILE OF IT. THE\nROTORS CAN REST NOW.";
static END_TITLE: [u8; 13] = "CAMPAIGN WON";
static END_FIN:   [u8; 8]  = "THE END";

fn screen_end() {
    screen_centre(3, "VICTORY\0");
    screen_centre(4, &END_TITLE as far *u8);
    screen_map(MISSION_COUNT);
    screen_con.set_area(BRIEF_TEXT_COL as u8, BRIEF_TEXT_ROW as u8,
                        BRIEF_W as u8, BRIEF_ROWS as u8);
    screen_con.print(&END_TEXT as far *u8);
    screen_con.set_area(SCREEN_TEXT_COL as u8, 0, SCREEN_TEXT_W as u8, SCREEN_ROWS as u8);
    screen_centre(SCREEN_PROMPT, &END_FIN as far *u8);
}

// Game over: a mission lost - after the debrief, or straight from the field
// when the last airframe went down (game_fallen). It spells the code for
// another try, the one a lost debrief spells, and leaves it typed into the
// title's field, which is where Start goes from here - ENTER CODE, Start,
// and the mission is fought again with the purse its row deals.
static OVER_TITLE: [u8; 10] = "GAME OVER";
static OVER_TEXT:  [u8; 24] = "THE CODE TRIES IT AGAIN";
static OVER_PRESS: [u8; 12] = "PRESS START";

fn screen_over() {
    code_set(mission, start_funds);
    screen_centre(8, &OVER_TITLE as far *u8);
    screen_name(11, mission);
    screen_centre(15, &OVER_TEXT as far *u8);
    screen_code(17);
    screen_centre(SCREEN_PROMPT, &OVER_PRESS as far *u8);
}

// ------------------------------------------------------------ the page ---

// screen_blit - the composed page to VRAM and BG3 alone on the screen -
// or, the title's, to BG2's map over the picture. Force blank because this
// is a 1792-byte DMA at an arbitrary point in the frame; a black frame at
// a transition costs nothing.
fn screen_blit() {
    INIDISP = FORCE_BLANK;
    if screen_kind == SCREEN_TITLE {
        dma_copy_vram(0, &screen_page as far *u8, TITLE_VRAM_TEXT, SCREEN_ROWS << 6);
        set_main_layers!(Screen::BG1 | Screen::BG2);
    } else {
        dma_copy_vram(0, &screen_page as far *u8, VRAM_HUD, SCREEN_ROWS << 6);
        set_main_layers!(Screen::BG3);
    }
    INIDISP = 0x0F;
}

// screen_show - compose a page and put it up. The simulation stops here:
// GAME_SCREEN is not GAME_PLAYING, so main runs neither the tick nor the
// draw while one is showing.
far fn screen_show(kind: u8) {
    let was: u8 = screen_kind;
    screen_kind = kind;
    // Into the title the picture goes up; out of it the field's art comes
    // back, which every other page and the battle draw with.
    INIDISP = FORCE_BLANK;
    if kind == SCREEN_TITLE {
        if was != SCREEN_TITLE { title_load(); }
    } else if was == SCREEN_TITLE {
        video_restore();
    }
    screen_clear();
    if kind != SCREEN_TITLE { screen_frame(); }
    if kind == SCREEN_TITLE {
        title_mode = TITLE_MENU;          // the menu each time, NEW GAME picked
        title_sel = TITLE_NEW;
        screen_title();
    }
    if kind == SCREEN_BRIEF { screen_brief(); }
    if kind == SCREEN_AFTER { screen_after(); }
    if kind == SCREEN_END   { screen_end(); }
    if kind == SCREEN_OVER  { screen_over(); }
    screen_blit();
    game_state = GAME_SCREEN;
    // A tune per page: the title's theme, the briefing's orders, the end's
    // congratulations. A few frames of upload as the page goes up, nothing
    // when it is already playing (music_start) - a retry's briefing after
    // the debrief, whose page is silent, uploads it again.
    if kind == SCREEN_TITLE { music_start(MUS_OPERATION_HINDSTRIKE); }
    if kind == SCREEN_BRIEF { music_start(MUS_YOU_HAVE_YOUR_ORDERS); }
    if kind == SCREEN_END   { music_start(MUS_CONGRATULATIONS); }
    if kind == SCREEN_OVER  { music_start(MUS_BLOWED_UP_SIR); }
}

// screen_hide - back to the field: the art's BG3 map over the page, every
// layer on again, and the strip recomposed, the page having written over
// the rows it lives on.
far fn screen_hide() {
    screen_kind = SCREEN_NONE;
    INIDISP = FORCE_BLANK;
    dma_copy_vram(0, &HUD_MAP as far *u8, VRAM_HUD, HUD_MAP_SIZE);
    set_main_layers!(Screen::BG1 | Screen::BG2 | Screen::BG3 | Screen::Obj);
    INIDISP = 0x0F;
    hud_init();
    radar_init();
    music_stop();               // the battle has its guns, not the theme
}

// screen_font_load - the font and its palette, into BG3. Force blank: at
// boot, and again when the title gives VRAM back (video_restore).
far fn screen_font_load() {
    set_cgram_addr!(SCREEN_FONT_PAL << 2);
    write_color!(Color::rgb!(0, 0, 0));          // transparent
    write_color!(Color::rgb!(4, 6, 14));         // unused by the font
    write_color!(Color::rgb!(18, 20, 24));       // the glyphs' edge
    write_color!(Color::rgb!(31, 31, 31));       // and their body
    // By DMA rather than Console::upload_font, which writes the 1520
    // bytes a register store at a time: that is a frame of boot, and the
    // suite's movies are timed from a boot of a fixed length.
    dma_copy_vram(0, &CONSOLE_FONT as far *u8, VRAM_HUDC + (SCREEN_FONT_TILE << 3),
                  SCREEN_FONT_TILES << 4);
}

// screen_font - the console, writing the font's tiles. The priority bit is
// the title's: in Mode 3 a BG2 tile without it draws behind all of BG1.
far fn screen_font() {
    screen_con.init((SCREEN_FONT_PAL << 10) | 0x2000);
    screen_con.set_tile_base(SCREEN_FONT_TILE);
    screen_con.set_align(ConsoleAlign::Center as u8);
}

// screen_init - the code field at A A A A with the cursor on the first
// letter. SNES RAM is whatever it was at power-on, and an unset letter
// index reads a glyph from past the row; boot_load calls this before the
// title goes up, and nothing else does - a code typed or handed back by
// the after-action page has to survive a reset.
far fn screen_init() {
    screen_con.set_buffer(&screen_page as far *u8);
    for k in 0..CODE_LEN {
        code_letters[k] = 0;
    }
    code_cursor = 0;
    code_rep = 0;
    screen_kind = SCREEN_NONE;
    screen_dirty = 0;
}

// screen_flush - the code block to VRAM. Vblank only, and only the five
// rows the typing touches: re-blitting the page would mean force blank
// and a black frame on every keypress. Only the title types, so the block
// goes to its map.
far fn screen_flush() {
    if screen_dirty == 0 { return; }
    screen_dirty = 0;
    dma_copy_vram(1, &screen_page[SCREEN_CODE_ROW << 5] as far *u8,
                  TITLE_VRAM_TEXT + (SCREEN_CODE_ROW << 5), SCREEN_CODE_ROWS << 6);
}

// screen_type - the d-pad over the title's code field: left and right
// move the cursor, up and down run the letter through A..P. The readout
// under it follows, so the page always says what Start will do.
fn screen_type(held: u16, trig: u16) {
    let dirs: u16 = JOY_LEFT | JOY_RIGHT | JOY_UP | JOY_DOWN;
    let mut act: u16 = trig & dirs;
    if (held & dirs) == 0 {
        code_rep = 0;
    } else {
        if act != 0 {
            code_rep = CODE_REP_FIRST;
        } else {
            if code_rep > 0 { code_rep = code_rep - 1; }
            if code_rep == 0 {
                act = held & dirs;
                code_rep = CODE_REP_NEXT;
            }
        }
    }
    let trig: u16 = act;
    let mut moved: u8 = 0;
    if (trig & JOY_LEFT) != 0 {
        code_cursor = (code_cursor + (CODE_LEN as u8) - 1) & 0x03;
        moved = 1;
    }
    if (trig & JOY_RIGHT) != 0 {
        code_cursor = (code_cursor + 1) & 0x03;
        moved = 1;
    }
    let k: u16 = code_cursor as u16;
    if (trig & JOY_UP) != 0 {
        code_letters[k] = (code_letters[k] + 1) & 0x0F;
        moved = 1;
    }
    if (trig & JOY_DOWN) != 0 {
        code_letters[k] = (code_letters[k] + 15) & 0x0F;
        moved = 1;
    }
    if moved != 0 {
        screen_code_block();
        screen_dirty = 1;
    }
}

// screen_title_tick - the title. On the menu Up and Down pick NEW GAME
// or ENTER CODE and Start (or A) takes it: a new campaign's briefing, or
// the code field. There the d-pad types the code, B goes back to the menu,
// and Start takes the code - the mission it names with the purse it
// carries - or, if it names nothing, does nothing.
fn screen_title_tick(held: u16, trig: u16) {
    if title_mode == TITLE_MENU {
        if (trig & (JOY_UP | JOY_DOWN)) != 0 {
            title_sel = title_sel ^ 1;
            screen_code_block();
            screen_dirty = 1;
        }
        if (trig & (JOY_START | JOY_A)) == 0 { return; }
        if title_sel == TITLE_NEW {
            mission_set(MISSION_START);
            screen_show(SCREEN_BRIEF);
            return;
        }
        title_mode = TITLE_CODE;
        code_rep = 0;
        screen_code_block();
        screen_dirty = 1;
        return;
    }
    if (trig & JOY_B) != 0 {
        title_mode = TITLE_MENU;
        screen_code_block();
        screen_dirty = 1;
        return;
    }
    screen_type(held, trig);
    if (trig & JOY_START) == 0 { return; }
    let m: u8 = code_mission();
    if m == CODE_BAD { return; }
    mission_set(m);
    start_funds = code_purse();           // mission_set wrote the row's
    screen_show(SCREEN_BRIEF);
}

// screen_tick - one frame with a page up: the title's menu and code field
// (screen_title_tick); elsewhere Start is the only control - briefing into
// the battle, after-action on to the next mission, the end or - lost -
// game over, and game over back to the title. The end takes nothing: it is
// the game's last page.
far fn screen_tick(held: u16, trig: u16) {
    if screen_kind == SCREEN_TITLE {
        screen_title_tick(held, trig);
        return;
    }
    if screen_kind == SCREEN_END { return; }     // the game's last page: a dead end
    if (trig & JOY_START) == 0 { return; }
    if screen_kind == SCREEN_BRIEF {
        screen_hide();
        game_reset();
        return;
    }
    if screen_kind == SCREEN_AFTER {
        // The campaign strung together: on to the next mission's
        // briefing with what was carried. Taking the tenth is the end of
        // it, and losing one is game over.
        // (campaign_settle decided this while the page was composed -
        // game_state has been GAME_SCREEN since it went up.)
        if after_lost != 0 {
            screen_show(SCREEN_OVER);
            return;
        }
        if after_done != 0 {
            screen_show(SCREEN_END);
            return;
        }
        mission_set(after_next);
        start_funds = after_carry;        // mission_set wrote the row's
        screen_show(SCREEN_BRIEF);
        return;
    }
    if screen_kind == SCREEN_OVER {
        screen_show(SCREEN_TITLE);        // the code is still typed into its field
    }
}

// ------------------------------------------------------- the title art ---
#[bank(8)]

// title_load - Mode 3 and the title's picture, over the field's VRAM and
// CGRAM. Force blank. In bank 8 with the picture's second half, its map and
// palette - which also gives the ROM its ninth bank: R65 sizes the ROM from
// the banks with code or tables in them, and include_bytes! data alone
// does not count. HDMA goes off: its two channels write BG1's and
// BG2's horizontal scroll down the screen, which would shear the picture.
far fn title_load() {
    dma_set_hdma!(0);
    dma_copy_cgram(0, &TITLE_PAL as far *u8, 0, TITLE_PAL_SIZE);
    dma_copy_vram(0, &TITLE_CHR_1 as far *u8, 0, TITLE_CHR_1_SIZE);
    dma_copy_vram(0, &TITLE_CHR_2 as far *u8, TITLE_CHR_1_SIZE >> 1, TITLE_CHR_2_SIZE);
    dma_copy_vram(0, &TITLE_MAP as far *u8, TITLE_VRAM_MAP, TITLE_MAP_SIZE);
    // The font, widened: each 2bpp glyph is a 4bpp tile's first half, and
    // the second - bitplanes 2 and 3 - is zero.
    let mut at: u16 = TITLE_VRAM_FONT + (SCREEN_FONT_TILE << 4);
    for t in 0..SCREEN_FONT_TILES {
        dma_copy_vram(0, &CONSOLE_FONT[t << 4] as far *u8, at, 16);
        dma_copy_vram(0, &SCREEN_ZERO as far *u8, at + 8, 16);
        at = at + 16;
    }
    set_bgmode!(3, 0);
    set_bg1_map!(0x1C, 0);
    set_bg2_map!(0x1F, 0);
    set_bg12_chr!(0, 7);
    set_bg1_hscroll!(0);
    set_bg1_vscroll!(0xFFFF);
    set_bg2_hscroll!(0);
    set_bg2_vscroll!(0xFFFF);
}
