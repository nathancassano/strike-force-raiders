// muni - the munition pool: helicopter gunfire and bombs in flight.
//
// Struct-of-arrays with a rotating free cursor, following the plan's Entity
// model. The pool is a power of two so the cursor wraps with a mask - `*`
// only accepts power-of-two constants and mul8 costs ~57 cycles against ~16
// for a shift, so every index arithmetic here stays in shifts and masks.
//
// Positions match the helicopter's: world pixel + 1/256 fraction across two
// words for x, a single 8.8 u16 for y, Q10 velocity. See heli.r65 for why
// a negative delta needs an explicit sign branch.

#[bank(0)]

const MUNI_MAX:  u16 = 16;
const MUNI_MASK: u16 = 15;

// Kinds. 0 is the free marker, so the pool clears to "empty" with zeroes.
const MUNI_FREE:   u8 = 0;
const MUNI_BULLET: u8 = 1;
const MUNI_BOMB:   u8 = 2;
const MUNI_SHELL:  u8 = 3;                // tank main gun
// A bomb that has reached the ground becomes a blast for exactly one tick,
// so the area damage is applied where the unit pool can see it. Bombs do
// nothing to infantry until they land - this state is what encodes that.
const MUNI_BLAST:  u8 = 4;
// A base's or a launcher's anti-air missile: it steers toward the other
// side's helicopter every frame (see muni_update) and lives MISSILE_LIFE
// frames. It is the buildings' and the missile trucks' weapon; the
// airframes carry none (kind 6, the old smart missile, is unused).
const MUNI_MISSILE: u8 = 5;
const MISSILE_SPEED: Q10 = 3 * 64;        // 3 px/frame along either axis
const MISSILE_LIFE:  u8  = 180;           // 3 s: slow enough to dodge, long enough to chase

// Gunfire crosses the screen fast and flat; a bomb inherits the airframe's
// horizontal speed and accelerates downward from rest.
const BULLET_SPEED: Q10 = 8 * 64;         // 8 px/frame
// Gunfire has a range. Without one a round flies to the world edge, holding
// a pool slot for hundreds of frames: at 8 px/frame a shot fired mid-map
// would outlive a hundred later ones and sustained fire would starve the
// pool. 40 frames is ~320 px, a little over a screen width.
const BULLET_LIFE: u8 = 40;
const BOMB_GRAVITY: Q10 = 12;             // ~0.19 px/frame^2
const BOMB_VY_MAX:  Q10 = 6 * 64;

// OBJ tiles, 8x8 (OBSEL small size), from the free slots after the
// helicopter's three frames.
const MUNI_TILE_BULLET: u8 = 12;
const MUNI_TILE_BOMB:   u8 = 13;
const MUNI_TILE_SHELL:  u8 = 14;
// A missile wears the shell's dot until phase 12 draws it one.
const MUNI_TILE_MISSILE: u8 = 14;
const MUNI_ATTR: u16 = 0x3000;            // priority 3, OBJ palette 0

// Munitions in flight rank directly behind the helicopter, so they draw
// second and take whatever the allocator hands out next.

// ---------------------------------------------------------------- state ---
#[lowram] static mut muni_kind:  [u8; 16];
#[lowram] static mut muni_x_px:  [u16; 16];
#[lowram] static mut muni_x_sub: [u8; 16];
#[lowram] static mut muni_y:     [u16; 16];
#[lowram] static mut muni_vx:    [Q10; 16];
#[lowram] static mut muni_vy:    [Q10; 16];
#[lowram] static mut muni_life:  [u8; 16];    // frames left, 0 = unlimited
#[lowram] static mut muni_owner: [u8; 16];    // 0 player, 1 enemy - decides
                                              // who a round can hurt
#[lowram] static mut muni_cursor: u16;
// Bombs in the air. Kept exactly so gunfire's bomb-interception test can
// be skipped entirely when there is nothing to intercept - scanning the
// pool for bombs from every round was, by itself, over the frame budget.
#[lowram] static mut muni_bombs: u8;
// Munitions of each side in flight after this frame's update - a count
// the airframes' collision tests consult before walking the pool, since
// most frames nothing of the other side is up.
#[lowram] static mut muni_up: [u8; 2];
// The slot the last muni_spawn filled, MUNI_MAX when the pool was full -
// for a caller that has to know whether its shot is still in the air.
#[lowram] static mut muni_last: u16;

// muni_drop_bomb - a slot that held a bomb is about to hold something
// else; keep the count honest. Every retirement of a bomb goes through
// here.
fn muni_drop_bomb(i: u16) {
    if muni_kind[i] == MUNI_BOMB { muni_bombs = muni_bombs - 1; }
}

// muni_init - empty the pool. Arrays are declared bare, so they hold
// power-on garbage until this runs.
far fn muni_init() {
    muni_bombs = 0;
    for i in 0..MUNI_MAX {
        muni_kind[i] = MUNI_FREE;
    }
    muni_cursor = 0;
}

// muni_spawn - claim a slot, or drop the shot if the pool is full.
//
// Rotating cursor rather than a scan from 0: with a fixed start the low
// slots churn while the high ones idle, and a burst of gunfire would keep
// evicting itself from the same few entries.
far fn muni_spawn(kind: u8, x_px: u16, y: u16, vx: Q10, vy: Q10, life: u8,
                  owner: u8) {
    let mut i: u16 = muni_cursor;
    let mut n: u16 = 0;
    muni_last = MUNI_MAX;
    // No `continue` in an entity loop - compiler region-spill bug.
    while n < MUNI_MAX {
        if muni_kind[i] == MUNI_FREE {
            muni_last = i;
            muni_kind[i] = kind;
            muni_x_px[i] = x_px;
            muni_x_sub[i] = 0;
            muni_y[i] = y;
            muni_vx[i] = vx;
            muni_vy[i] = vy;
            muni_life[i] = life;
            muni_owner[i] = owner;
            if kind == MUNI_BOMB { muni_bombs = muni_bombs + 1; }
            muni_cursor = (i + 1) & MUNI_MASK;
            n = MUNI_MAX;              // done; no `break` needed either
        } else {
            i = (i + 1) & MUNI_MASK;
            n = n + 1;
        }
    }
}

// muni_move_x - the same 16.8 advance the airframe uses, on a pool slot.
fn muni_move_x(i: u16, v: Q10) {
    let d: i16 = v.0 << 2;
    if d >= 0 {
        let m: u16 = d as u16;
        let s: u16 = (muni_x_sub[i] as u16) + (m & 0x00FF);
        muni_x_sub[i] = s as u8;
        muni_x_px[i] = muni_x_px[i] + (m >> 8) + (s >> 8);
    } else {
        let m: u16 = (0 - d) as u16;
        let mut whole: u16 = m >> 8;
        let frac: u16 = m & 0x00FF;
        if (muni_x_sub[i] as u16) < frac {
            whole = whole + 1;
        }
        muni_x_sub[i] = muni_x_sub[i] - (frac as u8);
        if muni_x_px[i] <= whole {
            muni_x_px[i] = 0;
            muni_drop_bomb(i);
            muni_kind[i] = MUNI_FREE;      // ran off the west edge
        } else {
            muni_x_px[i] = muni_x_px[i] - whole;
        }
    }
}

// muni_update - integrate every live munition and retire the spent ones.
//
// A munition retires on ground contact, on leaving the world, or - for
// gunfire - when its range runs out.
far fn muni_update() {
    let mut up0: u8 = 0;
    let mut up1: u8 = 0;
    for i in 0..MUNI_MAX {
        let kind: u8 = muni_kind[i];
        if kind != MUNI_FREE {
            if muni_owner[i] == SIDE_PLAYER { up0 = up0 + 1; } else { up1 = up1 + 1; }
            if muni_life[i] > 0 {
                muni_life[i] = muni_life[i] - 1;
                if muni_life[i] == 0 {
                    muni_kind[i] = MUNI_FREE;   // out of range
                }
            }

            if kind == MUNI_MISSILE {
                // Steer: full speed toward the other side's airframe on
                // each axis. With none up it flies on straight.
                let mut tx: u16 = heli_x_px + (HELI_W >> 1);
                let mut ty: u16 = heli_y + ((HELI_H >> 1) << 8);
                let mut up: u8 = 1;
                if muni_owner[i] == SIDE_PLAYER {
                    tx = foe_x_px + (HELI_W >> 1);
                    ty = foe_y + ((HELI_H >> 1) << 8);
                    if foe_dead > 0 || foe_rising != 0 { up = 0; }
                } else {
                    if heli_dead > 0 || heli_rising != 0 { up = 0; }
                }
                if up != 0 {
                    muni_vx[i] = MISSILE_SPEED;
                    if tx < muni_x_px[i] { muni_vx[i] = Q10(0) - MISSILE_SPEED; }
                    muni_vy[i] = MISSILE_SPEED;
                    if ty < muni_y[i] { muni_vy[i] = Q10(0) - MISSILE_SPEED; }
                }
            }

            if kind == MUNI_BOMB {
                let v: Q10 = muni_vy[i] + BOMB_GRAVITY;
                if v > BOMB_VY_MAX {
                    muni_vy[i] = BOMB_VY_MAX;
                } else {
                    muni_vy[i] = v;
                }
            }

            if muni_kind[i] != MUNI_FREE {
                muni_move_x(i, muni_vx[i]);

                // Vertical is a single u16, so two's-complement wrap carries
                // the sign correctly without a branch.
                let dy: i16 = muni_vy[i].0 << 2;
                muni_y[i] = muni_y[i] + (dy as u16);
            }

            // Ground collision. Bombs are the reason this exists; a bullet
            // fired while diving hits it too, which is correct.
            if muni_kind[i] != MUNI_FREE {
                if (muni_y[i] >> 8) >= GROUND_Y {
                    if muni_kind[i] == MUNI_BOMB {
                        muni_bombs = muni_bombs - 1;
                        muni_kind[i] = MUNI_BLAST;
                        sfx_at(SFX_CHN_BLAST, SFX_EXPLODE_1, muni_x_px[i]);
                        fx_spawn(FX_BIG, muni_x_px[i], GROUND_Y - 16);
                        muni_y[i] = GROUND_Y << 8;  // on the line, where the buildings' test looks
                    } else {
                        muni_kind[i] = MUNI_FREE;
                    }
                } else {
                    if muni_x_px[i] >= WORLD_W {
                        muni_drop_bomb(i);
                        muni_kind[i] = MUNI_FREE;   // off the east edge
                    }
                }
            }
        }
    }
    muni_up[0] = up0;
    muni_up[1] = up1;
}

// muni_draw - place the live munitions, camera-relative, into the OAM slots
// behind the helicopter. Anything outside the visible 256 px is culled
// rather than drawn off-screen: OAM slots are the scarce resource, and the
// plan's importance order only works if wasted slots are not held.
far fn muni_draw() {
    for i in 0..MUNI_MAX {
        let kind: u8 = muni_kind[i];
        if kind != MUNI_FREE {
            let sx: u16 = muni_x_px[i] - camera_x;
            // Inside the window, or straddling its left edge (sx wrapped to
            // $FFF8..$FFFF, which the 9-bit OAM X places at -8..-1).
            if sx < 256 || sx >= 0xFFF8 {
              if kind != MUNI_BLAST {
                let mut tile: u8 = MUNI_TILE_BULLET;
                if kind == MUNI_BOMB { tile = MUNI_TILE_BOMB; }
                if kind == MUNI_SHELL { tile = MUNI_TILE_SHELL; }
                if kind == MUNI_MISSILE { tile = MUNI_TILE_MISSILE; }
                let slot: u16 = oam_take();
                if slot < OAM_SLOTS {
                    oam.set_full!(slot as u8, sx & 0x01FF, (muni_y[i] >> 8) as u8,
                                  (tile as u16) | MUNI_ATTR);
                    oam.set_size!(slot as u8, 0);        // 8x8
                }
              }
            }
        }
    }
}
